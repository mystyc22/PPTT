    .market-rider strong,
    .market-rider em {
      justify-self: start;
    }

    .market-rider strong {
      grid-area: price;
    }

    .market-rider em {
      grid-area: state;
    }

    .audit-ledger-grid {
      grid-template-columns: 1fr;
    }

    .audit-ledger-grid div:nth-child(even) {
      border-left: 0;
    }

    .audit-ledger-grid div + div {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
    }

    .quote-rules {
      display: grid;
      grid-template-columns: 1fr;
    }
