  .flow-checkpoint::before {
    position: absolute;
    inset: -4px;
    width: auto;
    height: auto;
    border: 1px solid rgba(254, 127, 45, 0);
    border-radius: 19px;
    content: "";
    opacity: 0;
    transform: scale(0.96);
