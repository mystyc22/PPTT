  .lab-choice-group button {
    min-width: 0;
    border-radius: 9px;
    color: rgba(35, 61, 77, 0.68);
    padding: 0 7px;
    font-size: 0.68rem;
    font-weight: 850;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
