    }

    .lab-chip {
      display: none;
    }

    .lab-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 10px;
    }

    .lab-controls label,
    .lab-control {
      min-width: 0;
      font-size: 0.68rem;
    }

    .lab-controls input {
      min-height: 40px;
      padding-inline: 9px;
      font-size: 0.78rem;
    }

    .lab-choice-group {
      min-height: 40px;
    }

    .lab-choice-group button {
      padding-inline: 6px;
      font-size: 0.68rem;
    }

    .lab-controls label {
      grid-column: 1 / 2;
    }

    .lab-run {
      grid-column: 2 / 3;
      align-self: end;
      width: 100%;
      min-width: 0;
      min-height: 40px;
      padding-inline: 10px;
    }

    .lab-readout {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
      margin-top: 10px;
    }

    .lab-readout span,
    .lab-readout strong,
    .lab-readout em {
      padding: 9px 10px;
      font-size: 0.68rem;
    }

    .lab-readout em {
      grid-column: 1 / -1;
    }

    .story-stage {
      display: none;
    }

    .story-pin-inner {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
    }
  }

  /* Refined visual system: less card-grid, more product-storytelling. */
  body {
    background:
      radial-gradient(circle at 16% 14%, rgba(254, 127, 45, 0.16), transparent 28%),
      radial-gradient(circle at 82% 8%, rgba(35, 61, 77, 0.12), transparent 30%),
      linear-gradient(135deg, #ffffff 0%, #f6f7f9 46%, var(--soft) 100%);
  }

  body::before {
    opacity: 0.42;
    background-size: 120px 120px;
  }

  body::after {
    animation: pageSheen 12s ease-in-out infinite alternate;
    opacity: 0.72;
  }

  @keyframes pageSheen {
    from {
      transform: translate3d(-2%, -1%, 0) rotate(-1deg);
    }

    to {
      transform: translate3d(2%, 2%, 0) rotate(1deg);
    }
  }

  .hero {
    min-height: min(980px, 100svh);
    padding-bottom: 24px;
  }

  .hero-grid {
    grid-template-columns: minmax(0, 0.86fr) minmax(420px, 0.86fr);
    min-height: auto;
    padding: clamp(46px, 8vh, 86px) 0 clamp(32px, 6vh, 64px);
  }

  .hero-copy h1 {
    font-size: clamp(4.2rem, 6.7vw, 7.2rem);
    line-height: 0.88;
  }

  .hero-lede {
    max-width: 55ch;
  }

  .hero-product {
    border: 0;
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.36);
    box-shadow: none;
    backdrop-filter: blur(26px);
  }

  .hero-product::before {
    border-radius: inherit;
    background:
      linear-gradient(115deg, rgba(254, 127, 45, 0.22), transparent 34%),
      radial-gradient(circle at 70% 24%, rgba(255, 255, 255, 0.92), transparent 34%);
  }

  .canvas-shell {
    height: clamp(360px, 38vw, 510px);
    border: 0;
    border-radius: 28px;
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.9), rgba(234, 236, 240, 0.42)),
      var(--soft);
    box-shadow:
      inset 0 0 0 1px rgba(35, 61, 77, 0.12),
      0 36px 90px rgba(35, 61, 77, 0.16);
  }

  .canvas-shell::before {
    position: absolute;
    inset: 14%;
    z-index: 0;
    border-radius: 50%;
    background: rgba(254, 127, 45, 0.16);
    filter: blur(40px);
    content: "";
    animation: stageGlow 5s ease-in-out infinite alternate;
  }

  @keyframes stageGlow {
    from {
      transform: translate3d(-4%, 2%, 0) scale(0.96);
      opacity: 0.62;
    }

    to {
      transform: translate3d(5%, -3%, 0) scale(1.08);
      opacity: 1;
    }
  }

  .product-topline {
    padding: 8px 18px 14px;
  }

  .product-readout {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding: 16px 18px 8px;
  }

  .product-readout div {
    width: auto;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.48);
    padding: 9px 12px;
  }

  .product-readout span,
  .product-readout strong {
    display: inline;
    margin: 0;
  }

  .product-readout span::after {
    content: " / ";
  }

  .hero-strip {
    border-width: 1px 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .hero-strip div {
    min-height: 86px;
    background: transparent;
    backdrop-filter: none;
  }

  .hero-strip div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.12);
  }

  .section,
  .motion-island,
  .lead-section {
    padding-block: clamp(96px, 12vw, 168px);
  }

  .thesis-grid {
    gap: 0;
    border-top: 1px solid rgba(35, 61, 77, 0.16);
    border-bottom: 1px solid rgba(35, 61, 77, 0.16);
  }

  .thesis-card {
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    padding: 34px 32px 38px 0;
  }

  .thesis-card + .thesis-card {
    border-left: 1px solid rgba(35, 61, 77, 0.16);
    padding-left: 32px;
  }

  .motion-proof-rail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid rgba(35, 61, 77, 0.16);
    border-bottom: 1px solid rgba(35, 61, 77, 0.16);
  }

  .motion-proof-row {
    display: grid;
    grid-template-columns: 140px minmax(220px, 0.42fr) minmax(0, 1fr);
    gap: 28px;
    align-items: baseline;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    padding: 24px 0;
  }

  .motion-proof-row + .motion-proof-row {
    border-top: 1px solid rgba(35, 61, 77, 0.1);
  }

  .motion-proof-card h3,
  .motion-proof-card p {
    margin: 0;
  }

  .story-stage {
    border: 0;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 40px 110px rgba(35, 61, 77, 0.14);
  }

  .stage-map {
    border-radius: 26px;
    background-color: rgba(255, 255, 255, 0.42);
  }

  .lead-panel {
    overflow: hidden;
    border: 0;
    border-radius: 32px;
    background:
      radial-gradient(circle at 18% 18%, rgba(254, 127, 45, 0.18), transparent 32%),
      linear-gradient(135deg, var(--navy), #071017);
    color: var(--white);
    box-shadow: 0 44px 120px rgba(0, 0, 0, 0.22);
  }

  .lead-panel .eyebrow,
  .lead-panel p {
    color: rgba(255, 255, 255, 0.72);
  }

  .lead-panel h2 {
    color: var(--white);
  }

  .lead-form label,
  .lead-form-field {
    color: rgba(255, 255, 255, 0.82);
  }

  .lead-form input,
  .lead-form select,
  .lead-form textarea {
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.08);
    color: var(--white);
  }

  .lead-form input::placeholder,
  .lead-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.44);
  }

  .lead-form .button-primary {
    border-color: var(--orange);
    background: var(--orange);
    color: var(--black);
  }

  /* Final pilot, lead, and footer */
  .pilot-intro {
    max-width: 780px;
    margin-top: 18px;
    color: var(--muted);
    font-size: clamp(1rem, 1.45vw, 1.14rem);
    font-weight: 750;
    line-height: 1.56;
  }

  .pilot-system {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.56fr);
    gap: clamp(14px, 2vw, 20px);
    margin-top: clamp(34px, 5vw, 56px);
  }

  .pilot-console,
  .pilot-control-panel {
    border: 1px solid rgba(35, 61, 77, 0.09);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(244, 246, 248, 0.56)),
      rgba(255, 255, 255, 0.72);
    box-shadow: 0 22px 64px rgba(35, 61, 77, 0.07);
    backdrop-filter: blur(18px);
  }

  .pilot-console {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(440px, 1fr) auto;
    gap: 18px;
    overflow: hidden;
    padding: clamp(18px, 2.4vw, 28px);
  }

  .pilot-console-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pilot-console-head span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: rgba(35, 61, 77, 0.66);
    font-size: 0.76rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .pilot-console-head strong {
    border: 1px solid rgba(254, 127, 45, 0.2);
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.1);
    padding: 8px 10px;
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .pilot-icon {
    width: 18px;
    height: 18px;
    color: var(--orange);
  }

  .pilot-map-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(260px, 1fr) auto;
    gap: 18px;
    overflow: hidden;
    min-width: 0;
    min-height: 380px;
    border-top: 1px solid rgba(35, 61, 77, 0.08);
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 0;
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.04) 1px, transparent 1px),
      linear-gradient(180deg, rgba(35, 61, 77, 0.04) 1px, transparent 1px),
      rgba(255, 255, 255, 0.3);
    background-size: 42px 42px, 42px 42px, auto;
  }

  .pilot-map-status,
  .pilot-map-note {
    position: relative;
    z-index: 4;
    display: inline-grid;
    gap: 5px;
    width: max-content;
    max-width: min(100%, 320px);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.76);
    padding: 10px 12px;
    box-shadow: 0 12px 30px rgba(35, 61, 77, 0.07);
  }

  .pilot-map-status {
    align-self: start;
    justify-self: start;
  }

  .pilot-map-note {
    align-self: end;
    justify-self: end;
    max-width: 300px;
  }

  .pilot-map-status span,
  .pilot-map-note span,
  .pilot-console-foot span {
    color: rgba(35, 61, 77, 0.56);
    font-size: 0.62rem;
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .pilot-map-note span {
    overflow-wrap: anywhere;
  }

  .pilot-map-status strong,
  .pilot-console-foot strong {
    color: var(--black);
    font-size: 0.84rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .pilot-corridor-rail {
    position: relative;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    align-content: center;
    justify-self: stretch;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 250px;
    overflow: hidden;
    padding: 22px 0 72px;
  }

  .pilot-rail-line {
    position: absolute;
    z-index: 1;
    top: calc(50% - 36px);
    right: 12.5%;
    left: 12.5%;
    height: 9px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.11);
  }

  .pilot-rail-line span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--orange);
    transform: scaleX(var(--pilot-progress, 0));
    transform-origin: left center;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pilot-point {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: 24px 46px auto auto;
    justify-items: center;
    gap: 8px;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--navy);
    padding: 0 4px;
    font: inherit;
    text-align: center;
    cursor: pointer;
    transition: transform 180ms ease;
  }

  .pilot-point:hover,
  .pilot-point.is-active {
    transform: translateY(-3px);
  }

  .pilot-step-code {
    display: grid;
    width: 34px;
    height: 24px;
    place-items: center;
    border-radius: 999px;
    background: #fff;
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.62rem;
    font-weight: 950;
    line-height: 1;
  }

  .pilot-point-icon {
    width: 46px;
    height: 46px;
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 15px;
    background: #fff;
    color: var(--black);
    padding: 11px;
    box-shadow: 0 14px 32px rgba(35, 61, 77, 0.1);
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .pilot-point strong {
    font-size: 0.76rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .pilot-point em {
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 850;
    line-height: 1;
    text-transform: uppercase;
  }

  .pilot-point.is-active .pilot-step-code,
  .pilot-point.is-active .pilot-point-icon {
    background: #ffe6d5;
    color: var(--black);
  }

  .pilot-point.is-active .pilot-point-icon {
    border-color: rgba(254, 127, 45, 0.32);
    transform: translateY(-2px);
  }

  .pilot-rider {
    position: absolute;
    z-index: 4;
    bottom: 18px;
    left: var(--pilot-marker-x, 12.5%);
    display: inline-grid;
    grid-template-columns: 34px auto;
    gap: 7px;
    align-items: center;
    border-radius: 999px;
    background: rgba(5, 5, 5, 0.94);
    color: var(--white);
    padding: 6px 11px 6px 6px;
    font-size: 0.72rem;
    font-weight: 950;
    box-shadow: none;
    transform: translateX(-50%);
    transition:
      left 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pilot-rider-icon {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--orange);
    color: var(--black);
    padding: 7px;
  }

  .pilot-console-foot {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.48);
  }

  .pilot-console-foot div {
    display: grid;
    gap: 6px;
    min-height: 82px;
    align-content: center;
    padding: 14px;
  }

  .pilot-console-foot div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.08);
  }

  .pilot-control-panel {
    display: grid;
    grid-template-rows: 260px auto auto;
    align-content: start;
    gap: 18px;
    padding: clamp(20px, 2.6vw, 32px);
  }

  .pilot-focus-card {
    box-sizing: border-box;
    display: grid;
    gap: 0;
    height: 260px;
    min-height: 0;
    align-content: start;
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
    padding-bottom: 20px;
  }

  .pilot-control-panel h3 {
    margin-top: 14px;
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    line-height: 0.94;
  }

  .pilot-control-panel p:not(.eyebrow) {
    margin-top: 16px;
    color: var(--muted);
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.55;
  }

  .pilot-tabs {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(35, 61, 77, 0.08);
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
  }

  .lead-switch button {
    min-height: 42px;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    color: var(--navy);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .lead-switch button.is-active {
    border-color: rgba(254, 127, 45, 0.42);
    background: var(--orange);
    color: var(--black);
  }

  .pilot-tabs button {
    position: relative;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-height: 58px;
    border: 0;
    background: transparent;
    color: var(--navy);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pilot-tabs button + button {
    border-top: 1px solid rgba(35, 61, 77, 0.08);
  }

  .pilot-tabs button::before {
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 0;
    width: 3px;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0);
    content: "";
  }

  .pilot-tabs button span {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 10px;
    background: rgba(35, 61, 77, 0.07);
    font-size: 0.68rem;
    font-weight: 950;
  }

  .pilot-tabs button strong {
    font-size: 0.78rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .pilot-tabs button.is-active {
    color: var(--black);
  }

  .pilot-tabs button.is-active::before {
    background: rgba(254, 127, 45, 0.78);
  }

  .pilot-tabs button.is-active span {
    background: rgba(254, 127, 45, 0.16);
  }

  .pilot-signal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.56);
  }

  .pilot-signal-grid div {
    display: grid;
    gap: 7px;
    min-height: 104px;
    align-content: center;
    padding: 14px;
  }

  .pilot-signal-grid div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.08);
  }

  .pilot-signal-grid span {
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.64rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .pilot-signal-grid strong {
    font-size: 0.9rem;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .lead-panel {
    position: relative;
    grid-template-columns: minmax(0, 0.76fr) minmax(340px, 0.7fr);
    align-items: start;
    min-height: 768px;
    background:
      radial-gradient(circle at 16% 18%, rgba(254, 127, 45, 0.22), transparent 34%),
      linear-gradient(145deg, #050505, #12191d 58%, #241206);
  }

  .lead-copy {
    display: grid;
    min-height: 652px;
    align-content: start;
  }

  .lead-panel h2 {
    min-height: 356px;
  }

  .lead-copy > [data-lead-copy] {
    min-height: 52px;
  }

  .lead-switch {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 28px;
  }

  .lead-switch button {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.78);
  }

  .lead-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-top: 22px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.1);
  }

  .lead-summary div {
    display: grid;
    gap: 8px;
    min-height: 94px;
    align-content: center;
    background: rgba(255, 255, 255, 0.06);
    padding: 14px;
  }

  .lead-summary span {
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.66rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .lead-summary strong {
    color: var(--white);
    font-size: 0.95rem;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .lead-form {
    position: relative;
    min-height: 652px;
    align-content: start;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(16px, 2.4vw, 24px);
  }

  .lead-form select option {
    color: var(--black);
  }

  .lead-form .lead-native-select {
    position: absolute;
    box-sizing: border-box;
    width: 1px;
    height: 1px;
    min-height: 0;
    border: 0;
    margin: 0;
    padding: 0;
    opacity: 0;
    pointer-events: none;
  }

  .lead-custom-select {
    position: relative;
    z-index: 8;
  }

  .lead-select-trigger {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18px;
    gap: 12px;
    align-items: center;
    width: 100%;
