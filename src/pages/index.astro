    .flow-ledger div:nth-child(even) {
      border-left: 1px solid rgba(35, 61, 77, 0.1);
    }

    .flow-ledger div:nth-child(n + 3) {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
    }
  }

  /* Final parcel-flow redesign */
  .story-pin {
    position: relative;
    width: min(1460px, calc(100% - clamp(28px, 5vw, 72px)));
    padding: clamp(86px, 10vw, 144px) 0;
  }

