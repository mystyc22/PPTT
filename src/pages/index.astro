  .model-row span,
  .ledger-line span {
    color: var(--muted);
    line-height: 1.45;
  }

  .ledger-card {
    background: var(--navy);
    color: var(--white);
  }

  .ledger-head {
    display: flex;
    justify-content: space-between;
  }

  .ledger-head strong {
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.16);
    padding: 8px 10px;
    color: var(--orange);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
  }

  .ledger-line {
    grid-template-columns: 1fr auto;
    border-color: rgba(255, 255, 255, 0.12);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
