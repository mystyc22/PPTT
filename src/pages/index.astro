<style is:global>
  :root {
    color-scheme: light;
    --black: #000000;
    --navy: #233d4d;
    --orange: #fe7f2d;
    --soft: #eaecf0;
    --white: #ffffff;
    --muted: rgba(35, 61, 77, 0.72);
    --line: rgba(35, 61, 77, 0.16);
    --shadow: 0 24px 80px rgba(0, 0, 0, 0.12);
    --radius: 8px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--soft);
    overflow-x: clip;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    overflow-x: clip;
    color: var(--black);
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.92), rgba(234, 236, 240, 0.94) 44%, rgba(255, 255, 255, 0.86)),
      var(--soft);
    cursor: auto;
    font-family:
      "Aptos Display", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.06) 1px, transparent 1px),
      linear-gradient(180deg, rgba(35, 61, 77, 0.055) 1px, transparent 1px);
    background-size: 88px 88px;
    content: "";
    mask-image: linear-gradient(180deg, black, transparent 78%);
  }

  body::after {
    position: fixed;
    inset: -20% -10%;
    z-index: -1;
    background:
      linear-gradient(112deg, transparent 8%, rgba(254, 127, 45, 0.18) 24%, transparent 42%),
      linear-gradient(28deg, transparent 52%, rgba(35, 61, 77, 0.12) 66%, transparent 82%);
    content: "";
    pointer-events: none;
    transform: translate3d(0, 0, 0);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main {
    overflow-x: clip;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  input,
  select,
  textarea,
  button {
    font: inherit;
  }

  .cursor-dot,
  .cursor-ring {
    display: none;
  }

  @media (pointer: fine) {
    body {
      cursor: none;
    }

    a,
    button,
    input,
    select,
    textarea {
      cursor: none;
    }

    .cursor-dot,
    .cursor-ring {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      display: block;
      pointer-events: none;
      transform: translate3d(-50%, -50%, 0);
      transition:
        width 180ms ease,
        height 180ms ease,
        border-color 180ms ease,
        background 180ms ease,
        opacity 180ms ease;
    }

    .cursor-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--orange);
    }

    .cursor-ring {
      width: 34px;
      height: 34px;
      border: 1px solid rgba(35, 61, 77, 0.42);
      border-radius: 50%;
    }

    .cursor-ring.is-active {
      width: 56px;
      height: 56px;
      border-color: var(--orange);
      background: rgba(254, 127, 45, 0.08);
    }

    .cursor-dot.is-hidden,
    .cursor-ring.is-hidden {
      opacity: 0;
    }
  }

