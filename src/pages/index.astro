  .lab-controls input::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 3px solid var(--white);
    border-radius: 50%;
    background: var(--black);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.2);
