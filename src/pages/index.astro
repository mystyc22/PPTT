  .route-lab .route-corridor-active .route-segment.is-live.is-express {
    stroke: var(--black);
  }

  .route-lab .route-corridor-active .route-segment.is-live.is-selected {
    opacity: 1;
    stroke: var(--orange);
  }

  .route-lab.is-held .route-corridor-active .route-segment.is-live,
  .route-lab.is-bundle .route-corridor-active .route-segment.is-live,
  .route-lab.is-express .route-corridor-active .route-segment.is-live {
    opacity: calc(0.58 + var(--segment-load, 1) * 0.12);
    stroke: var(--orange);
  }

  .route-lab.is-held .route-corridor-active .route-segment.is-live.is-express,
  .route-lab.is-bundle .route-corridor-active .route-segment.is-live.is-express,
  .route-lab.is-express .route-corridor-active .route-segment.is-live.is-express {
    stroke: var(--black);
  }

  .route-lab.is-held .route-corridor-active .route-segment.is-live.is-selected,
  .route-lab.is-bundle .route-corridor-active .route-segment.is-live.is-selected,
  .route-lab.is-express .route-corridor-active .route-segment.is-live.is-selected {
    opacity: 1;
    stroke: var(--orange);
  }

  .route-lab .route-corridor-active .route-segment {
    opacity: 0;
    stroke: var(--orange);
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    stroke-width: 7;
    animation: none;
  }

  .route-lab.is-held .route-corridor-active .route-segment,
  .route-lab.is-bundle .route-corridor-active .route-segment,
  .route-lab.is-express .route-corridor-active .route-segment {
    opacity: 0;
  }

  .route-lab .route-corridor-active .route-segment.is-selected {
    opacity: 0;
    stroke: rgba(35, 61, 77, 0.5);
    stroke-dasharray: 0.025 0.025;
    stroke-width: 6;
  }

  .route-lab .route-corridor-active .route-segment.is-active,
  .route-lab .route-corridor-active .route-segment.is-complete,
  .route-lab.is-held .route-corridor-active .route-segment.is-active,
  .route-lab.is-bundle .route-corridor-active .route-segment.is-active,
  .route-lab.is-express .route-corridor-active .route-segment.is-active,
  .route-lab.is-held .route-corridor-active .route-segment.is-complete,
  .route-lab.is-bundle .route-corridor-active .route-segment.is-complete,
  .route-lab.is-express .route-corridor-active .route-segment.is-complete {
    opacity: 1;
    stroke: var(--orange);
    stroke-dasharray: 1;
    stroke-width: 7;
  }

  .route-lab .route-corridor-active .route-segment.is-complete {
    opacity: 0.78;
  }

  @keyframes liveRouteFlow {
    to {
      stroke-dashoffset: -0.12;
    }
  }

  .network-point {
