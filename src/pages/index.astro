  .flow-checkpoint span {
    align-self: end;
    line-height: 1;
  }

  .flow-checkpoint strong {
    align-self: start;
    border-radius: 0;
    background: transparent;
    padding: 0;
    color: currentColor;
    font-size: 0.74rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .flow-checkpoint.is-complete,
  .flow-checkpoint.is-active {
    color: var(--black);
  }

  .flow-checkpoint.is-complete {
    background: transparent;
  }

  .flow-checkpoint.is-complete .flow-checkpoint-icon {
    border-color: rgba(254, 127, 45, 0.22);
    background: rgba(254, 127, 45, 0.14);
  }

  .flow-checkpoint.is-active {
    background: rgba(255, 255, 255, 0.72);
    transform: translateX(2px);
  }

  .flow-checkpoint.is-active::before {
    border-color: rgba(254, 127, 45, 0.36);
    animation: none;
    opacity: 0;
  }

  .flow-checkpoint.is-active .flow-checkpoint-icon {
    border-color: rgba(254, 127, 45, 0.78);
    background: var(--orange);
    box-shadow: 0 18px 34px rgba(35, 61, 77, 0.14);
  }

  .flow-board.is-flow-switching .flow-parcel-card {
    animation: flowCardFiche 420ms cubic-bezier(0.2, 0.86, 0.22, 1) both;
  }

  @keyframes flowCardFiche {
    0% {
      opacity: 0.86;
      transform: translate3d(0, 28px, 0) scale(0.988) rotateZ(-0.38deg);
    }

    62% {
      opacity: 1;
      transform: translate3d(0, -4px, 0) scale(1.002) rotateZ(0.12deg);
    }

    100% {
      opacity: 1;
      transform: translate3d(0, var(--flow-card-drop), 0) rotateZ(var(--flow-card-rotate));
    }
  }

  .flow-bid-panel .flow-bid-row {
