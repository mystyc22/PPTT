---
import InvestorMotion from "../components/InvestorMotion";
import {
  ArrowRightLeft,
  BadgeCheck,
  Bike,
  ClipboardCheck,
  ChevronDown,
  ListTree,
  MapPinned,
  Menu,
  Network,
  Package as PackageIcon,
  ReceiptText,
  Route,
  ScanLine,
  ShoppingBag,
  Store,
  Waypoints,
  X,
} from "@lucide/astro";

const projectStages = [
  {
    tag: "01",
    label: "Partner Hub",
    title: "Local Store as a Network Node",
    body: "Any existing business (grocer, barber, diner, kiosk) becomes an ultra-light micro-hub. Supplemental revenue for the merchant, zero warehouse CAPEX for the network.",
    metric: "zero fixed lease",
    visual: "shops",
  },
  {
    tag: "02",
    label: "Sorting",
    title: "Maximum 8 Directional Transit Bags",
    body: "Hubs require zero automated sorting—just counter space for max 8 directional bags and a pickup shelf. Limiting to 8 directions eliminates human routing errors. Bags stay sealed until a corridor direction switch.",
    metric: "8 transit corridors",
    visual: "sort",
  },
  {
    tag: "03",
    label: "Transport",
    title: "Private Carriers & Freight Exchange",
    body: "These riders are independent boda-boda taxi operators waiting at stands. PPTT’s freight exchange batches full sealed bags along their natural route, minimizing empty return miles and maximizing driver earnings.",
    metric: "zero empty miles",
    visual: "riders",
  },
  {
    tag: "04",
    label: "Finance",
    title: "The Self-Funding Parcel",
    body: "Senders pay cash at the intake hub, converted into internal digital balance. As the parcel travels toward its target, it pays every hub and courier hop by hop upon verified handover.",
    metric: "parcel balance",
    visual: "ledger",
  },
  {
    tag: "05",
    label: "Scale",
    title: "Organic Mesh Expansion",
    body: "A flat network without central sorting bottlenecks. When a node nears capacity, the network onboards an adjacent shop, tightening network density and shortening transit legs.",
    metric: "flat mesh",
    visual: "mesh",
  },
];

const storySteps = [
  {
    tag: "01",
    label: "Marker",
    title: "Intake Code: 4 Characters",
    body: "Zero printers, zero sticky labels, zero reliance on non-existent street addresses. Shop staff writes a 4-character code (e.g., X92K) with marker; the system routes it to the correct sector.",
  },
  {
    tag: "02",
    label: "Bag",
    title: "Sealed Directional Bag",
    body: "Parcel drops into one of max 8 transit bags. The bag is tamper-sealed and remains untouched throughout transit until the corridor changes.",
  },
  {
    tag: "03",
    label: "Transit",
    title: "Consolidated Motorcycle Hop",
    body: "Carriers pick up sealed bags. The system matches riders already traveling along that corridor, dramatically lowering marginal cost.",
  },
  {
    tag: "04",
    label: "Outtake",
    title: "Hub Pickup & Settlement",
    body: "Recipient collects the parcel at their local neighborhood hub using the 4-character code. The parcel's internal balance instantly releases merchant commissions and carrier payouts.",
  },
];

const modelRows = [
  ["Zero Central Sorting Warehouses", "Flat peer-to-peer mesh of equal neighborhood nodes; zero warehouse bottlenecks"],
  ["4-Character Pen Code Only", "Zero printers or paper labels; functions seamlessly even with weak connectivity"],
  ["Sealed Transit Bags", "Opened strictly when switching directional corridor sectors"],
  ["Private Motorcycle Carriers", "Freight exchange batches sealed cargo along natural travel routes, eliminating empty return miles"],
  ["Neighborhood Hub Pickup", "Hub-to-hub delivery model avoids wandering through unmapped, address-less streets"],
];

const pilotMetrics = [
  "Cost per parcel",
  "Time to first transfer",
  "Directional bag fill rate",
  "Number of handoffs",
  "Loss rate (0%)",
  "Corridor unit profitability",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />
    <meta name="theme-color" content="#f8f6f2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="PPTT (Package Push Towards Target) – decentralized hub-to-hub courier network for address-less megacities. Zero sorting warehouses, zero printers, motorcycle transit bags, and an autonomous self-funding parcel ledger."
    />
    <title>PPTT — Package Push Towards Target</title>
  </head>
  <body>
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>

    <main>
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="ambient-sheen" aria-hidden="true"></div>
        <nav class="topbar" aria-label="Main Navigation" data-topbar>
          <a class="brand magnetic" href="#top" aria-label="PPTT — Package Push Towards Target">
            <img class="brand-mark" src="/favicon-512.png" alt="PPTT Logo" width="38" height="38" />
            <span class="brand-wordmark">
              <strong>PPTT</strong>
              <span class="brand-expansion">— Package Push Towards Target</span>
            </span>
          </a>

          <button
            class="nav-toggle"
            type="button"
            aria-label="Open navigation menu"
            aria-controls="topbar-menu"
            aria-expanded="false"
            data-nav-toggle
          >
            <Menu class="nav-toggle-icon nav-toggle-open" aria-hidden="true" />
            <X class="nav-toggle-icon nav-toggle-close" aria-hidden="true" />
          </button>

          <div class="topbar-menu" id="topbar-menu" data-nav-menu>
            <div class="nav-links">
              <a class="magnetic" href="#concept">
                <Network class="nav-link-icon" aria-hidden="true" />
                <span>Network Concept</span>
              </a>
              <a class="magnetic" href="#story">
                <Route class="nav-link-icon" aria-hidden="true" />
                <span>Parcel Flow</span>
              </a>
              <a class="magnetic" href="#economics">
                <ReceiptText class="nav-link-icon" aria-hidden="true" />
                <span>Currency & Ledger</span>
              </a>
              <a class="magnetic" href="#pilot">
                <BadgeCheck class="nav-link-icon" aria-hidden="true" />
                <span>Readiness ~70%</span>
              </a>
              <a class="magnetic" href="#sponsor">
                <Store class="nav-link-icon" aria-hidden="true" />
                <span>Pre-Seed Round</span>
              </a>
            </div>
            <a class="topbar-cta magnetic" href="#lead">
              <span class="topbar-cta-full">Investor Deck</span>
              <span class="topbar-cta-short">Deck</span>
            </a>
          </div>
        </nav>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Decentralized logistics infrastructure with zero central sorting warehouses</p>
            <h1 id="hero-title">
              <span class="hero-title-line">
                <span class="hero-title-word" data-hero-word>Shops</span>
                {" "}
                <span class="hero-title-word" data-hero-word>connect.</span>
              </span>
              <span class="hero-title-line">
                <span class="hero-title-word hero-title-accent" data-hero-word>Motorcycles</span>
                {" "}
                <span class="hero-title-word" data-hero-word>move.</span>
              </span>
            </h1>
            <p class="hero-lede">
              PPTT turns neighborhood shops into a flat network of micro-hubs. No expensive warehouses, no
              printers, and no searching for missing street addresses. Parcels marked with a 4-character code travel in sealed bags
              powered by independent motorcycle taxis, self-funding every transit hop from their internal balance.
            </p>
            <div class="hero-actions" aria-label="Key Actions">
              <a class="button button-primary magnetic" href="#lead">Request Investor Deck</a>
              <a class="button button-ghost magnetic" href="#story">Explore PPTT Model</a>
            </div>
            <div class="hero-flow" aria-label="PPTT Operational Flow">
              <span class="hero-flow-step">
                <Store class="hero-flow-icon" aria-hidden="true" />
                <span>Shop micro-hub</span>
              </span>
              <i aria-hidden="true"></i>
              <span class="hero-flow-step">
                <ShoppingBag class="hero-flow-icon" aria-hidden="true" />
                <span>Sealed transit bag</span>
              </span>
              <i aria-hidden="true"></i>
              <span class="hero-flow-step">
                <Bike class="hero-flow-icon" aria-hidden="true" />
                <span>Motorcycle transit</span>
              </span>
            </div>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <div class="hero-handoff-map">
              <svg class="hero-route-svg" viewBox="0 0 620 740" preserveAspectRatio="none">
                <path
                  class="hero-route-base hero-route-desktop"
                  d="M 168 536 C 207 470 246 390 315 333 C 363 265 376 82 408 -32"
                />
                <path
                  class="hero-route-active hero-route-desktop"
                  d="M 168 536 C 207 470 246 390 315 333 C 363 265 376 82 408 -32"
                />
                <path
                  class="hero-route-spark hero-route-desktop"
                  d="M 168 536 C 207 470 246 390 315 333 C 363 265 376 82 408 -32"
                />
                <path
                  class="hero-route-base hero-route-mobile"
                  d="M 234 610 C 254 534 284 444 315 356 C 350 270 376 112 397 14"
                />
                <path
                  class="hero-route-active hero-route-mobile"
                  d="M 234 610 C 254 534 284 444 315 356 C 350 270 376 112 397 14"
                />
                <path
                  class="hero-route-spark hero-route-mobile"
                  d="M 234 610 C 254 534 284 444 315 356 C 350 270 376 112 397 14"
                />
              </svg>
              <span class="hero-route-node is-shop">
                <Store class="hero-route-icon" aria-hidden="true" />
              </span>
              <span class="hero-route-node is-bag">
                <PackageIcon class="hero-route-icon" aria-hidden="true" />
              </span>
              <span class="hero-route-node is-rider">
                <Bike class="hero-route-icon" aria-hidden="true" />
              </span>
              <span class="hero-route-chip is-shop-chip">Hub intake</span>
              <span class="hero-route-chip is-bag-chip">Sealed bag</span>
              <span class="hero-route-tag">PPTT-042</span>
            </div>
            <img
              class="hero-people"
              src="/images/hero-delivery-people.png"
              width="928"
              height="1096"
              alt=""
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <div class="hero-strip" aria-label="Concept Summary">
          <div><strong>Zero Warehouse CAPEX</strong><span>Existing merchant shops serve as equal network micro-hubs.</span></div>
          <div><strong>Marker & 4 Characters</strong><span>Zero labels or printers—a 4-character code deterministically powers all routing.</span></div>
          <div><strong>Self-Funding Parcel</strong><span>Internal digital balance pays hubs and riders hop by hop in real time.</span></div>
        </div>
      </section>

      <section class="section concept concept-pin" id="concept" aria-labelledby="concept-title">
        <div class="concept-pin-inner">
          <div class="concept-copy reveal">
            <p class="eyebrow">Operational Thesis</p>
            <h2 id="concept-title">A flat mesh of micro-hubs instead of central sorting warehouses.</h2>
            <p>
              In emerging megacities, missing street addresses and traffic gridlock paralyze traditional logistics. In PPTT there is no
              central warehouse—every node is an active local store or business earning extra revenue on parcel handling.
            </p>

            <div class="project-progress" aria-hidden="true">
              <div class="project-progress-head">
                <span data-project-current>01</span>
                <strong>Stages</strong>
                <span>{projectStages.length.toString().padStart(2, "0")}</span>
              </div>
              <div class="project-progress-track">
                <i data-project-progress></i>
              </div>
              <div class="project-markers">
                {projectStages.map((stage, index) => (
                  <span class:list={[index === 0 && "is-active"]} data-project-marker={index}>
                    {stage.label}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="project-carousel reveal" aria-label="Etapy projektu">
            <div class="project-card-track" data-project-track>
              {projectStages.map((stage, index) => (
                <article class:list={["project-stage-card", index === 0 && "is-active"]} data-project-stage={index}>
                  <div class:list={["project-stage-visual", `is-${stage.visual}`]} aria-hidden="true">
                    <span class="stage-icon-chip chip-a">
                      {stage.visual === "shops" && <MapPinned class="project-stage-lucide" />}
                      {stage.visual === "sort" && <ShoppingBag class="project-stage-lucide" />}
                      {stage.visual === "riders" && <Route class="project-stage-lucide" />}
                      {stage.visual === "ledger" && <ScanLine class="project-stage-lucide" />}
                      {stage.visual === "mesh" && <Waypoints class="project-stage-lucide" />}
                    </span>
                    <span class="stage-icon-main">
                      {stage.visual === "shops" && <Store class="project-stage-lucide" />}
                      {stage.visual === "sort" && <ListTree class="project-stage-lucide" />}
                      {stage.visual === "riders" && <Bike class="project-stage-lucide" />}
                      {stage.visual === "ledger" && <ClipboardCheck class="project-stage-lucide" />}
                      {stage.visual === "mesh" && <Network class="project-stage-lucide" />}
                    </span>
                    <span class="stage-icon-chip chip-b">
                      {stage.visual === "shops" && <ShoppingBag class="project-stage-lucide" />}
                      {stage.visual === "sort" && <ArrowRightLeft class="project-stage-lucide" />}
                      {stage.visual === "riders" && <ShoppingBag class="project-stage-lucide" />}
                      {stage.visual === "ledger" && <ReceiptText class="project-stage-lucide" />}
                      {stage.visual === "mesh" && <Store class="project-stage-lucide" />}
                    </span>
                    <span class="stage-icon-status">
                      {stage.visual === "ledger" ? <BadgeCheck class="project-stage-lucide" /> : <PackageIcon class="project-stage-lucide" />}
                    </span>
                  </div>
                  <div class="project-stage-body">
                    <span class="project-tag">{stage.tag}</span>
                    <p>{stage.label}</p>
                    <h3>{stage.title}</h3>
                    <div class="project-stage-line" aria-hidden="true"></div>
                    <p>{stage.body}</p>
                    <strong>{stage.metric}</strong>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section route-system-section" id="lab" aria-labelledby="route-system-title">
        <div class="route-system-inner reveal">
          <div class="section-heading route-system-heading">
            <div>
              <p class="eyebrow">Live Simulation</p>
              <h2 id="route-system-title">PPTT Corridor Simulator</h2>
            </div>
            <p>
              Adjust parcel intake, active merchant hubs, and motorcycle carriers to observe how a flat peer-to-peer network balances flow. Zero bottlenecks—riders batch sealed bags along existing movement vectors while the ledger balances accounts in real time.
            </p>
          </div>

          <aside class="route-lab is-booting" aria-label="PPTT Corridor Simulator">
            <div class="lab-topline">
              <span>PPTT Simulator</span>
              <div class="lab-live-meta">
                <span class="lab-live-pill"><i aria-hidden="true"></i>Sim</span>
                <strong><span data-lab-riders>0</span> riders</strong>
                <strong><span data-lab-delivered>0</span> outtake ready</strong>
              </div>
            </div>

            <div class="lab-stage" data-lab-stage>
              <svg class="lab-road-layer" viewBox="0 0 1000 620" preserveAspectRatio="none" aria-hidden="true">
                <g class="mesh-roads"></g>
                <g class="mesh-flows"></g>
              </svg>

              <div class="network-point" data-node="P1" data-kind="shop" data-km-x="7.5" data-km-y="32.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P1</strong>
                <em>Grocery Store</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P2" data-kind="salon" data-km-x="2.5" data-km-y="12.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P2</strong>
                <em>Barber / Salon</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P3" data-kind="restaurant" data-km-x="12.5" data-km-y="42.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P3</strong>
                <em>Local Diner</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P4" data-kind="shop" data-km-x="17.5" data-km-y="7.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P4</strong>
                <em>Kiosk / Stand</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P5" data-kind="shop" data-km-x="22.5" data-km-y="22.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P5</strong>
                <em>High-Traffic Hub</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P6" data-kind="pharmacy" data-km-x="24.5" data-km-y="4.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P6</strong>
                <em>Pharmacy</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P9" data-kind="shop" data-km-x="32.5" data-km-y="17.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P9</strong>
                <em>Northern Hub</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P8" data-kind="shop" data-km-x="37.5" data-km-y="2.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P8</strong>
                <em>Kiosk</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P7" data-kind="shop" data-km-x="42.5" data-km-y="32.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P7</strong>
                <em>Eastern Hub</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P10" data-kind="clinic" data-km-x="7.5" data-km-y="22.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P10</strong>
                <em>Health Clinic</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P11" data-kind="hardware" data-km-x="17.5" data-km-y="32.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P11</strong>
                <em>Hardware Store</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P12" data-kind="bakery" data-km-x="27.5" data-km-y="37.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P12</strong>
                <em>Bakery</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P13" data-kind="shop" data-km-x="37.5" data-km-y="27.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P13</strong>
                <em>Bookstore</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P14" data-kind="cafe" data-km-x="34.8" data-km-y="11.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P14</strong>
                <em>Café</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="live-rider" data-live-rider="rider-1" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R1</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-2" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R2</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-3" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R3</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-4" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R4</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-5" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R5</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-6" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R6</span>
                <em>0</em>
              </div>

              <div class="network-ledger" aria-hidden="true">
                <ReceiptText class="icon-svg" />
                <span>ledger state</span>
                <strong data-lab-ledger>ready</strong>
              </div>
            </div>

            <div class="lab-controls">
              <label class="demand-control">
                <span class="control-head">
                  <span>
                    <PackageIcon class="mini-icon" aria-hidden="true" />
                    Parcels
                  </span>
                  <strong><span data-lab-demand-count>8</span></strong>
                </span>
                <span class="lab-range">
                  <input data-lab-demand type="range" min="2" max="18" value="8" />
                  <span class="lab-range-fill" aria-hidden="true"></span>
                  <span class="threshold-mark" aria-hidden="true">intake volume</span>
                </span>
              </label>
              <label class="demand-control">
                <span class="control-head">
                  <span>
                    <Store class="mini-icon" aria-hidden="true" />
                    Hubs
                  </span>
                  <strong><span data-lab-shop-count>8</span></strong>
                </span>
                <span class="lab-range">
                  <input data-lab-shops type="range" min="5" max="14" value="8" />
                  <span class="lab-range-fill shop-fill" aria-hidden="true"></span>
                  <span class="threshold-mark" aria-hidden="true">active nodes</span>
