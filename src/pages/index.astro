    --flow-shift-soft: -5px;
  }

  .flow-head {
    min-height: 38px;
  }

  .flow-board {
    position: relative;
    display: grid;
    height: 470px;
    min-height: 0;
    overflow: hidden;
    border: 0;
    border-radius: 28px;
