  .ledger-line span {
    color: rgba(255, 255, 255, 0.68);
  }

  .ledger-line strong {
    color: var(--orange);
  }

  /* Final economics redesign */
  .economics {
    position: relative;
  }

  .economics-intro {
    max-width: 760px;
    margin-top: 18px;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.16rem);
    font-weight: 700;
    line-height: 1.55;
  }

  .economics-board {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(340px, 0.74fr);
    gap: clamp(14px, 2vw, 20px);
    margin-top: clamp(34px, 5vw, 56px);
  }

  .quote-lock-panel,
  .market-console,
  .audit-ledger-panel {
    border: 1px solid rgba(35, 61, 77, 0.09);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(244, 246, 248, 0.54)),
      rgba(255, 255, 255, 0.7);
    box-shadow: 0 22px 64px rgba(35, 61, 77, 0.07);
    backdrop-filter: blur(18px);
  }

  .quote-lock-panel {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 20px;
    min-height: 470px;
    overflow: hidden;
    padding: clamp(22px, 3vw, 34px);
  }

  .quote-lock-panel::before {
    position: absolute;
    top: 0;
    right: clamp(22px, 3vw, 34px);
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(35, 61, 77, 0.11), transparent);
    content: "";
    opacity: 0.8;
  }

  .market-console {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 14px;
    overflow: hidden;
    padding: clamp(18px, 2.4vw, 26px);
  }

  .market-console::before {
    position: absolute;
    inset: 64px 0 auto;
    height: 1px;
    background: rgba(35, 61, 77, 0.08);
    content: "";
  }

  .economics-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
  }

  .economics-panel-head span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: rgba(35, 61, 77, 0.62);
    font-size: 0.76rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .economics-panel-head strong {
    border: 1px solid rgba(254, 127, 45, 0.18);
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.08);
    color: var(--black);
    padding: 8px 10px;
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .economics-icon {
    width: 18px;
    height: 18px;
    color: var(--orange);
    stroke-width: 2.2;
  }

  .quote-amount {
    display: grid;
    gap: 8px;
    margin-top: 20px;
  }

  .quote-amount span {
    color: rgba(35, 61, 77, 0.62);
    font-size: 0.84rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .quote-amount strong {
    font-size: clamp(5rem, 11vw, 9rem);
    font-weight: 950;
    line-height: 0.76;
    letter-spacing: 0;
  }

  .quote-amount em {
    width: max-content;
    max-width: 100%;
