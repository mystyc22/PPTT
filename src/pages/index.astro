  .route-lab {
    position: relative;
    overflow: hidden;
    border-radius: 36px;
    background:
      radial-gradient(circle at 24% 18%, rgba(254, 127, 45, 0.24), transparent 34%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.76), rgba(234, 236, 240, 0.54));
    padding: clamp(16px, 2.5vw, 26px);
    box-shadow: 0 44px 110px rgba(35, 61, 77, 0.16);
    backdrop-filter: blur(24px);
  }

  .route-lab::before {
    position: absolute;
    inset: -20%;
    background:
      linear-gradient(110deg, transparent, rgba(255, 255, 255, 0.82), transparent),
      radial-gradient(circle at 75% 25%, rgba(255, 255, 255, 0.75), transparent 28%);
    content: "";
    opacity: 0.65;
    pointer-events: none;
    transform: rotate(-8deg);
  }

  .lab-topline,
  .lab-controls,
  .lab-readout {
    position: relative;
    z-index: 2;
  }

  .lab-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .lab-topline span,
  .lab-topline strong,
  .lab-controls label,
  .lab-control span,
  .lab-choice-group button,
  .lab-readout,
  .lab-chip {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .lab-topline span {
    color: var(--navy);
    opacity: 0.72;
  }

  .lab-topline strong,
  .lab-chip {
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.16);
    color: var(--black);
    padding: 9px 12px;
  }

  .lab-stage {
    position: relative;
    min-height: clamp(320px, 38vw, 500px);
    overflow: hidden;
    border-radius: 32px;
    background:
      radial-gradient(circle at 42% 53%, rgba(254, 127, 45, 0.16), transparent 36%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(234, 236, 240, 0.48));
  }

  .lab-stage::before {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: rgba(254, 127, 45, 0.18);
    content: "";
    filter: blur(34px);
    animation: stageGlow 4.5s ease-in-out infinite alternate;
  }

  .lab-map {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: min(96%, 690px);
    height: min(90%, 470px);
    overflow: visible;
    transform: translate(-50%, -50%);
  }

  .map-roads path {
    fill: none;
    stroke: rgba(35, 61, 77, 0.11);
    stroke-linecap: round;
    stroke-width: 4.4;
  }

  .map-roads path:nth-child(1),
  .map-roads path:nth-child(2),
  .map-roads path:nth-child(3) {
    stroke: rgba(35, 61, 77, 0.16);
    stroke-width: 6.4;
  }

  .map-labels text {
    fill: rgba(35, 61, 77, 0.28);
    font: 800 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .route-base path {
    fill: none;
    opacity: 0.9;
    stroke: rgba(35, 61, 77, 0.14);
    stroke-linecap: round;
    stroke-width: 12;
  }

  .map-node rect {
    fill: rgba(255, 255, 255, 0.9);
    stroke: rgba(35, 61, 77, 0.12);
    stroke-width: 1;
  }

  .map-node text {
    fill: var(--black);
    font: 900 13px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .map-node text + text {
    fill: rgba(35, 61, 77, 0.54);
    font-size: 10px;
  }

  .map-node path {
    fill: none;
    stroke: rgba(35, 61, 77, 0.36);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .map-node .node-icon {
    stroke: var(--navy);
    stroke-width: 3.4;
  }

  .map-node .pin-icon {
    stroke: var(--orange);
  }

  .bag-meter-bg {
    fill: rgba(35, 61, 77, 0.14);
  }

  .bag-meter-fill {
    fill: var(--orange);
    transform: scaleX(var(--bag-fill, 0.8));
    transform-origin: 342px 280px;
    transition: transform 180ms ease;
  }

  .lab-route {
    fill: none;
    opacity: 0;
    stroke: var(--orange);
    stroke-dasharray: 820;
    stroke-dashoffset: 0;
    stroke-linecap: round;
    stroke-width: 11;
    transition: opacity 240ms ease;
  }

  .lab-route.is-active {
    opacity: 1;
    animation: routePulse 3.2s ease-in-out infinite;
  }

  .lab-end {
    fill: var(--black);
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 7;
  }

  .lab-finish {
    fill: var(--navy);
  }

  .lab-bag {
    fill: var(--orange);
    opacity: calc(0.3 + var(--bag-fill, 0.8) * 0.7);
  }

  .courier-marker {
    transform: translate(150px, 320px);
  }

  .courier-marker circle {
    fill: var(--black);
  }

  .courier-marker path {
    fill: none;
    stroke: var(--white);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 3.2;
  }

  .courier-marker .moving-package {
    fill: var(--orange);
  }

  .courier-marker text {
    fill: var(--black);
    font: 950 8px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .route-lab.is-running .courier-marker {
    animation: packetWait 2.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .route-lab.is-bundle.is-running .courier-marker {
    animation-name: packetBundle;
  }

  .route-lab.is-skip.is-running .courier-marker {
    animation-name: packetSkip;
  }

  @keyframes packetWait {
    0% {
      transform: translate(150px, 320px);
    }

    72%,
    100% {
      transform: translate(360px, 246px);
    }
  }

  @keyframes packetBundle {
    0% {
      transform: translate(150px, 320px);
    }

    42% {
      transform: translate(360px, 246px);
    }

    68% {
      transform: translate(448px, 236px);
    }

    100% {
      transform: translate(678px, 160px);
    }
  }

  @keyframes packetSkip {
    0% {
      transform: translate(150px, 320px);
    }

    38% {
      transform: translate(292px, 360px);
    }

    68% {
      transform: translate(506px, 310px);
    }

    100% {
      transform: translate(678px, 160px);
    }
  }

