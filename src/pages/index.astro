    --flow-shift-soft: 5px;
    --flow-card-drop: 0px;
    --flow-card-rotate: 0deg;
    --flow-sheet-one-opacity: 0;
    --flow-sheet-one-y: 0px;
    --flow-sheet-one-scale: 1;
    --flow-sheet-one-rotate: 0deg;
    --flow-sheet-two-opacity: 0;
    --flow-sheet-two-y: 0px;
    --flow-sheet-two-scale: 1;
    --flow-sheet-two-rotate: 0deg;
    --flow-sheet-three-opacity: 0;
    --flow-sheet-three-y: 0px;
    --flow-sheet-three-scale: 1;
    --flow-sheet-three-rotate: 0deg;
    inset: clamp(14px, 2.2vw, 26px);
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 38px 470px auto;
    gap: clamp(14px, 2vw, 22px);
    overflow: visible;
    border: 0;
    border-radius: 24px;
    background: transparent;
    box-shadow: none;
    padding: clamp(16px, 2.4vw, 26px);
  }

  .flow-device.is-flow-backward {
