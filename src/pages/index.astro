  /* Parcel flow board: flat operational view, replacing the old 3D preview. */
  .story-pin {
    padding: clamp(76px, 9vw, 132px) 0;
  }

  .story-stage {
    min-height: clamp(610px, 58vw, 760px);
    border-radius: 28px;
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(35, 61, 77, 0.045) 1px, transparent 1px),
      linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(234, 236, 240, 0.62));
    background-size: 48px 48px, 48px 48px, auto;
  }

  .flow-device {
    --flow-progress: 0.08;
    position: absolute;
    inset: clamp(18px, 2.7vw, 34px);
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(250px, 0.72fr);
    grid-template-rows: auto minmax(330px, 1fr) auto auto;
    gap: clamp(16px, 2.4vw, 28px);
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.64);
    padding: clamp(18px, 2.7vw, 30px);
  }

  .flow-head {
    grid-column: 1 / -1;
    display: flex;
    min-height: 42px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 950;
    text-transform: uppercase;
  }

  .flow-head span {
    color: rgba(35, 61, 77, 0.62);
  }

  .flow-head strong {
    border: 1px solid rgba(254, 127, 45, 0.24);
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.14);
    color: var(--black);
    padding: 8px 11px;
  }

  .flow-step-stack {
    position: relative;
    z-index: 2;
    grid-column: 2;
    grid-row: 2;
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 0;
  }

  .flow-step-stack .story-step {
    max-height: 58px;
    overflow: hidden;
    border-left-width: 3px;
    border-radius: 0 14px 14px 0;
    background: transparent;
    padding: 10px 12px 10px 16px;
    opacity: 0.4;
    transform: translateX(0);
    transition:
      max-height 280ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease,
      background 220ms ease,
      transform 220ms ease,
      border-color 220ms ease;
  }

  .flow-step-stack .story-step.is-active {
    max-height: 176px;
    background: rgba(255, 255, 255, 0.66);
    opacity: 1;
    transform: translateX(6px);
  }

  .flow-step-stack .story-step h3 {
    margin-top: 7px;
    font-size: clamp(1rem, 1.35vw, 1.16rem);
  }

  .flow-step-stack .story-step p {
    margin-top: 7px;
    font-size: 0.86rem;
    line-height: 1.44;
  }

  .flow-ledger {
    grid-column: 1 / -1;
    grid-row: 4;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.11);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.58);
  }

  .flow-ledger div {
    display: grid;
    gap: 6px;
    align-content: center;
    min-height: 74px;
    padding: 13px 14px;
  }

  .flow-ledger div + div {
    border-top: 0;
    border-left: 1px solid rgba(35, 61, 77, 0.1);
  }

  .flow-ledger span {
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.66rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .flow-ledger strong {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    line-height: 1.1;
    text-transform: uppercase;
  }

  @media (max-width: 1080px) {
    .story-pin-inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .story-copy {
      order: -1;
      justify-self: center;
      text-align: center;
    }

    .story-stage {
      min-height: auto;
      overflow: visible;
    }

    .flow-device {
      position: relative;
      inset: auto;
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(300px, auto) auto auto auto;
    }

    .flow-step-stack,
    .flow-ledger {
      grid-column: 1;
    }

    .flow-step-stack {
      grid-row: 3;
    }

    .flow-ledger {
      grid-row: 5;
    }
  }

  @media (max-width: 760px) {
    .story-stage {
      border-radius: 22px;
    }

    .flow-device {
      gap: 14px;
      border-radius: 20px;
      padding: 14px;
    }

    .flow-head {
      display: grid;
      justify-items: start;
    }

    .flow-ledger {
      grid-template-columns: 1fr 1fr;
    }

    .flow-ledger div + div {
      border-left: 0;
    }

    .flow-ledger div:nth-child(even) {
      border-left: 1px solid rgba(35, 61, 77, 0.1);
    }

    .flow-ledger div:nth-child(n + 3) {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
    }
  }

  /* Final parcel-flow redesign */
  .story-pin {
    position: relative;
    width: min(1460px, calc(100% - clamp(28px, 5vw, 72px)));
    padding: clamp(86px, 10vw, 144px) 0;
  }

  .story-pin-inner {
    grid-template-columns: minmax(740px, 1.4fr) minmax(340px, 0.52fr);
