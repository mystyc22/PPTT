      width: 66px;
      height: 66px;
      border-radius: 18px;
    }

    .stage-icon-chip,
    .stage-icon-status {
      width: 32px;
      height: 32px;
      border-radius: 11px;
    }

    .project-stage-body {
      min-height: 0;
    }

    .project-stage-body h3 {
      min-height: 0;
      font-size: clamp(1.55rem, 7vw, 2.4rem);
    }

    .project-stage-body > p:last-of-type {
      min-height: 0;
    }
  }

  /* Scale section: separate operating-growth system */
  .scale-section {
    width: 100%;
    max-width: none;
    margin: clamp(34px, 6vw, 82px) 0 0;
    border-top: 1px solid rgba(35, 61, 77, 0.08);
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.035) 1px, transparent 1px),
      linear-gradient(180deg, rgba(35, 61, 77, 0.035) 1px, transparent 1px),
      linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(234, 236, 240, 0.48));
    background-size: 54px 54px, 54px 54px, auto;
    padding: clamp(84px, 9vw, 126px) 0;
  }

  .scale-section-inner {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
  }

  .scale-heading {
    align-items: end;
  }

  .scale-heading-copy {
    display: grid;
    gap: 18px;
  }

  .scale-heading-copy > p {
    max-width: 440px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.35vw, 1.12rem);
    font-weight: 750;
    line-height: 1.55;
  }

  .scale-heading-decision {
    position: relative;
    display: grid;
    gap: 7px;
    width: min(100%, 420px);
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.58);
    padding: 14px 16px 14px 34px;
  }

  .scale-heading-decision::before {
    position: absolute;
    top: 18px;
    left: 16px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--orange);
    content: "";
  }

  .scale-heading-decision span,
  .scale-check-grid span,
  .scale-map-legend span,
  .scale-lane-readout span,
  .scale-depot-decision > span {
    color: rgba(35, 61, 77, 0.62);
    font-size: 0.66rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .scale-heading-decision strong {
    font-size: 1.02rem;
    line-height: 1.14;
  }

  .scale-check-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 3vw, 42px);
    margin-top: clamp(26px, 3.5vw, 42px);
    border-top: 1px solid rgba(35, 61, 77, 0.09);
    border-bottom: 1px solid rgba(35, 61, 77, 0.09);
  }

  .scale-check-grid article {
    display: grid;
    gap: 8px;
    min-height: 92px;
    background: transparent;
    padding: 18px 0;
  }

  .scale-check-grid article:first-child {
    border: 0;
    background: transparent;
  }

  .scale-check-grid article + article {
    border-left: 1px solid rgba(35, 61, 77, 0.08);
    padding-left: clamp(18px, 3vw, 42px);
  }

  .scale-check-grid article:first-child span {
    color: var(--orange);
  }

  .scale-check-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 760;
    line-height: 1.35;
  }

  .scale-system {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.68fr);
    gap: 16px;
    align-items: stretch;
    margin-top: clamp(24px, 3vw, 34px);
  }

  .scale-cycle-panel,
  .scale-map-panel,
  .scale-rules-panel,
  .scale-signal-strip {
    border: 1px solid rgba(35, 61, 77, 0.09);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(246, 247, 249, 0.58)),
      rgba(255, 255, 255, 0.68);
    box-shadow: 0 18px 54px rgba(35, 61, 77, 0.06);
    backdrop-filter: blur(18px);
  }

  .scale-cycle-panel,
  .scale-map-panel {
    display: grid;
    grid-template-rows: auto auto auto;
    gap: 14px;
    min-height: 0;
    padding: clamp(18px, 2.4vw, 28px);
  }

  .scale-cycle-panel,
  .scale-rules-panel {
    min-height: clamp(650px, 49vw, 720px);
  }

  .scale-cycle-panel {
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .scale-cycle-layout {
    display: grid;
    grid-template-columns: minmax(330px, 1fr) minmax(220px, 0.72fr);
    gap: clamp(18px, 2.4vw, 30px);
    align-items: center;
    min-height: 388px;
  }

  .scale-cycle-orbit {
    position: relative;
    width: min(100%, 430px);
    aspect-ratio: 1;
    justify-self: center;
  }

  .scale-cycle-lines {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .scale-cycle-runner {
    position: absolute;
    inset: 8.7%;
    z-index: 1;
    border: 1px solid rgba(35, 61, 77, 0.07);
    border-top-color: rgba(254, 127, 45, 0.56);
    border-right-color: rgba(254, 127, 45, 0.2);
    border-radius: 999px;
    pointer-events: none;
    animation: scaleOrbitSpin 7.8s linear infinite;
    will-change: transform;
  }

  .scale-cycle-runner::before {
    position: absolute;
    top: -5px;
    left: 50%;
    width: 11px;
    height: 11px;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    background: var(--orange);
    box-shadow:
      0 0 0 8px rgba(254, 127, 45, 0.11),
      0 10px 20px rgba(254, 127, 45, 0.22);
    content: "";
    transform: translateX(-50%);
  }

  .scale-cycle-runner::after {
    position: absolute;
    inset: 15%;
    border: 1px dashed rgba(254, 127, 45, 0.16);
    border-radius: inherit;
    content: "";
  }

  .scale-cycle-base,
  .scale-cycle-live,
  .scale-cycle-spoke {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scale-cycle-base {
    stroke: rgba(35, 61, 77, 0.11);
    stroke-width: 10;
  }

  .scale-cycle-live {
    stroke: var(--orange);
    stroke-width: 7;
    filter: drop-shadow(0 5px 8px rgba(254, 127, 45, 0.16));
    transform-box: fill-box;
    will-change: stroke-dashoffset, stroke-dasharray;
  }

  .scale-cycle-live.is-loading {
    animation: scaleLiveGlow 1.45s ease-in-out infinite;
  }

  .scale-cycle-spoke {
    stroke: rgba(35, 61, 77, 0.08);
    stroke-dasharray: 4 10;
    stroke-width: 2;
  }

  .scale-cycle-core {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    display: grid;
    width: 150px;
    min-height: 114px;
    align-content: center;
    justify-items: center;
    gap: 7px;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 18px 42px rgba(35, 61, 77, 0.075);
    padding: 16px;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .scale-cycle-core span,
  .scale-cycle-detail > span,
  .scale-cycle-status strong,
  .scale-compare-head span,
  .scale-compare-grid span {
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .scale-cycle-core strong {
    font-size: 1.08rem;
    font-weight: 950;
    line-height: 1;
  }

  .scale-cycle-core small {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .scale-cycle-node {
    position: absolute;
    z-index: 2;
    display: grid;
    min-width: 84px;
    justify-items: center;
    gap: 7px;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--black);
    padding: 9px 10px;
    box-shadow: 0 12px 28px rgba(35, 61, 77, 0.075);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .scale-cycle-node::after {
    position: absolute;
    inset: -6px;
    border: 1px solid rgba(254, 127, 45, 0);
    border-radius: 22px;
    pointer-events: none;
    content: "";
    opacity: 0;
  }

  .scale-cycle-node span {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 15px;
    background: rgba(254, 127, 45, 0.1);
    color: var(--black);
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .scale-cycle-node svg {
    width: 23px;
    height: 23px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
  }

  .scale-cycle-node strong {
    font-size: 0.72rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .scale-cycle-node:hover,
  .scale-cycle-node:focus-visible,
  .scale-cycle-node.is-active {
    border-color: rgba(254, 127, 45, 0.36);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 18px 42px rgba(35, 61, 77, 0.1);
    transform: translate(-50%, -50%) translateY(-3px);
  }

  .scale-cycle-node:focus-visible {
    outline: 2px solid rgba(254, 127, 45, 0.45);
    outline-offset: 3px;
  }

  .scale-cycle-node.is-active span {
    background: var(--orange);
    color: var(--black);
    transform: translateY(-1px);
  }

  .scale-cycle-node.is-next {
    border-color: rgba(254, 127, 45, 0.2);
  }

  .scale-cycle-node.is-next span {
    background: rgba(254, 127, 45, 0.18);
  }

  .scale-cycle-node.is-active::after {
    border-color: rgba(254, 127, 45, 0.24);
    animation: scaleNodeFocus 1.45s ease-out infinite;
    opacity: 1;
  }

  .scale-cycle-detail {
    display: grid;
    gap: 12px;
    align-content: center;
    min-height: 300px;
    border-top: 1px solid rgba(35, 61, 77, 0.09);
    border-bottom: 1px solid rgba(35, 61, 77, 0.09);
    padding: 24px 0;
  }

  .scale-cycle-detail > span {
    width: max-content;
    max-width: 100%;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.14);
    color: var(--black);
    padding: 7px 9px;
  }

  .scale-cycle-detail h3 {
    max-width: 290px;
    font-size: clamp(1.55rem, 2.8vw, 2.35rem);
    font-weight: 950;
    line-height: 0.96;
  }

  .scale-cycle-detail p {
    max-width: 300px;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 760;
    line-height: 1.45;
  }

  .scale-cycle-status {
    display: grid;
    gap: 5px;
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid rgba(35, 61, 77, 0.08);
  }

  .scale-cycle-status em {
    color: var(--black);
    font-size: 0.88rem;
    font-style: normal;
    font-weight: 900;
    line-height: 1.2;
  }

  .scale-compare {
    display: grid;
    gap: 12px;
    border-top: 1px solid rgba(35, 61, 77, 0.12);
    padding-top: 14px;
  }

  .scale-compare-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .scale-compare-head strong {
    color: var(--black);
    font-size: 0.78rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .scale-compare-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.58);
  }

  .scale-compare-grid div {
    display: grid;
    gap: 7px;
    min-height: 118px;
    align-content: center;
    padding: 14px;
  }

  .scale-compare-grid div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.1);
  }

  .scale-compare-grid strong,
  .scale-compare-grid em {
    display: block;
    font-size: 0.82rem;
    line-height: 1.22;
  }

  .scale-compare-grid strong {
    color: var(--black);
    font-weight: 950;
  }

  .scale-compare-grid strong::before {
    color: var(--orange);
    content: "Our: ";
  }

  .scale-compare-grid em {
    color: rgba(35, 61, 77, 0.58);
    font-style: normal;
    font-weight: 790;
  }

  .scale-compare-grid em::before {
    color: rgba(35, 61, 77, 0.5);
    content: "Depot: ";
  }

  @keyframes scaleNodeFocus {
    0% {
      opacity: 0.72;
      transform: scale(0.96);
    }

    70% {
      opacity: 0;
      transform: scale(1.12);
    }

    100% {
      opacity: 0;
      transform: scale(1.12);
    }
  }

  @keyframes scaleOrbitSpin {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes scaleLiveGlow {
    0%,
    100% {
      filter: drop-shadow(0 5px 8px rgba(254, 127, 45, 0.14));
    }

    50% {
      filter: drop-shadow(0 8px 16px rgba(254, 127, 45, 0.26));
    }
  }

  .scale-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 42px;
  }

  .scale-panel-head span {
    color: rgba(35, 61, 77, 0.62);
    font-size: 0.74rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .scale-panel-head strong {
    border: 1px solid rgba(254, 127, 45, 0.24);
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.12);
    color: var(--black);
    padding: 8px 10px;
    font-size: 0.66rem;
    font-weight: 950;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .scale-map {
    position: relative;
    min-height: 372px;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 24px;
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(35, 61, 77, 0.045) 1px, transparent 1px),
      rgba(255, 255, 255, 0.64);
    background-size: 44px 44px, 44px 44px, auto;
  }

  .scale-map-legend {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 4;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .scale-map-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    padding: 6px 8px;
  }

  .scale-map-legend i {
    display: block;
    width: 18px;
    height: 5px;
    border-radius: 999px;
    background: var(--orange);
  }

  .scale-map-legend span:last-child i {
    background: rgba(35, 61, 77, 0.22);
  }

  .scale-map svg {
    position: absolute;
    inset: 10% 6% 8%;
    width: 88%;
    height: 82%;
  }

  .scale-road,
  .scale-road-active {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scale-road {
    stroke: rgba(35, 61, 77, 0.14);
    stroke-width: 16;
  }

  .scale-road.is-soft {
    stroke: rgba(35, 61, 77, 0.08);
    stroke-width: 10;
  }

  .scale-road-active {
    stroke: var(--orange);
    stroke-dasharray: 520;
    stroke-dashoffset: 150;
    stroke-width: 9;
  }

  .scale-node {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 3px;
    place-items: center;
    min-width: 68px;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.88);
    color: var(--black);
    padding: 10px 11px;
    box-shadow: 0 14px 32px rgba(35, 61, 77, 0.09);
    transform: translate(-50%, -50%);
  }

  .scale-node b {
    font-size: 0.86rem;
    font-weight: 950;
    line-height: 1;
  }

  .scale-node small {
    color: rgba(35, 61, 77, 0.62);
    font-size: 0.58rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .scale-node.is-bag {
    border-color: rgba(254, 127, 45, 0.26);
    background: rgba(254, 127, 45, 0.16);
  }

  .scale-node.is-next {
    border-color: rgba(254, 127, 45, 0.38);
    background: var(--orange);
  }

  .scale-node.is-next small {
    color: rgba(0, 0, 0, 0.62);
  }

  .scale-map-summary {
    display: grid;
    grid-template-columns: 0.8fr 0.8fr minmax(0, 1.1fr);
    gap: 0;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.82);
  }

  .scale-lane-readout,
  .scale-live-card {
    display: grid;
    gap: 6px;
    align-content: center;
    min-height: 106px;
    padding: 15px;
    box-shadow: none;
  }

  .scale-live-card {
    width: auto;
  }

  .scale-lane-readout + .scale-lane-readout,
  .scale-live-card {
    border-left: 1px solid rgba(35, 61, 77, 0.1);
  }

  .scale-lane-readout strong {
    font-size: 1.05rem;
    line-height: 1;
  }

  .scale-lane-readout small {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .scale-live-card span {
    color: rgba(35, 61, 77, 0.6);
    font-size: 0.66rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .scale-live-card strong {
    display: block;
    font-size: 0.96rem;
    line-height: 1.22;
  }

  .scale-rules-panel {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: clamp(18px, 2.4vw, 28px);
  }

  .scale-depot-decision {
    display: grid;
    gap: 10px;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 2px 0 0;
  }

  .scale-depot-decision div {
    display: grid;
    gap: 5px;
    border-top: 1px solid rgba(35, 61, 77, 0.08);
    padding-top: 10px;
  }

  .scale-depot-decision strong {
    font-size: 0.9rem;
    line-height: 1.1;
  }

  .scale-depot-decision p {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 740;
    line-height: 1.35;
  }

  .scale-rules {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(35, 61, 77, 0.1);
    border-bottom: 1px solid rgba(35, 61, 77, 0.1);
  }

  .scale-rule {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 14px;
    min-height: 112px;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 16px 0;
  }

  .scale-rule + .scale-rule {
    border-top: 1px solid rgba(35, 61, 77, 0.1);
  }

  .scale-rule > span {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 14px;
    border: 1px solid rgba(254, 127, 45, 0.18);
    background: rgba(254, 127, 45, 0.1);
    color: var(--black);
    font-size: 0.74rem;
    font-weight: 950;
  }

  .scale-rule h3 {
    font-size: 1rem;
    line-height: 1.12;
  }

  .scale-rule p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 720;
    line-height: 1.42;
  }

  .scale-rule strong {
    display: inline-flex;
    width: max-content;
    max-width: 100%;
    margin-top: 12px;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.14);
    color: var(--black);
    padding: 6px 8px;
    font-size: 0.62rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .scale-signal-strip {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    overflow: hidden;
  }

  .scale-signal-strip div {
    display: grid;
    gap: 8px;
    min-height: 138px;
    align-content: center;
    padding: 20px;
  }

  .scale-signal-strip div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.1);
  }

  .scale-signal-strip span {
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .scale-signal-strip strong {
    font-size: clamp(1.8rem, 3.8vw, 3.4rem);
    font-weight: 950;
    line-height: 0.9;
  }

  .scale-signal-strip p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.25;
  }

  @media (max-width: 1080px) {
    .scale-system {
      grid-template-columns: 1fr;
    }

    .scale-cycle-layout {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .scale-cycle-orbit {
      width: min(100%, 390px);
    }

    .scale-cycle-detail {
      min-height: auto;
      justify-items: center;
      text-align: center;
    }

    .scale-cycle-detail h3,
    .scale-cycle-detail p {
      max-width: 520px;
    }

    .scale-compare-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .scale-compare-grid div:nth-child(odd) {
      border-left: 0;
    }

    .scale-compare-grid div:nth-child(n + 3) {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
    }

    .scale-check-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .scale-check-grid article + article {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
      border-left: 0;
      padding-left: 0;
    }

    .scale-signal-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .scale-signal-strip div + div {
      border-left: 0;
    }

    .scale-signal-strip div:nth-child(even) {
      border-left: 1px solid rgba(35, 61, 77, 0.1);
    }

    .scale-signal-strip div:nth-child(n + 3) {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
    }
  }

  @media (max-width: 760px) {
    .scale-section {
      padding: 86px 0;
    }

    .scale-section-inner {
      width: min(100% - 28px, 1240px);
    }

    .scale-heading {
      grid-template-columns: 1fr;
    }

    .scale-heading-copy > p,
    .scale-heading-decision {
      max-width: 100%;
    }

    .scale-cycle-panel,
    .scale-map-panel {
      min-height: auto;
      border-radius: 22px;
      padding: 14px;
    }

    .scale-rules-panel {
      min-height: auto;
    }

    .scale-cycle-layout {
      gap: 18px;
    }

    .scale-cycle-orbit {
      width: min(100%, 322px);
    }

    .scale-cycle-core {
      width: 118px;
      min-height: 88px;
      border-radius: 18px;
      padding: 12px;
    }

    .scale-cycle-core strong {
      font-size: 0.9rem;
    }

    .scale-cycle-core small {
      font-size: 0.62rem;
    }

    .scale-cycle-node {
      min-width: 62px;
      border-radius: 15px;
      gap: 5px;
      padding: 7px;
    }

    .scale-cycle-node span {
      width: 34px;
      height: 34px;
      border-radius: 12px;
    }

    .scale-cycle-node svg {
      width: 18px;
      height: 18px;
    }

    .scale-cycle-node strong {
      font-size: 0.58rem;
    }

    .scale-cycle-base {
      stroke-width: 12;
    }

    .scale-cycle-live {
      stroke-width: 5;
    }

    .scale-cycle-detail {
      padding: 18px 0;
    }

    .scale-compare-head {
      align-items: start;
      flex-direction: column;
      gap: 7px;
    }

    .scale-compare-grid {
      grid-template-columns: 1fr;
    }

    .scale-compare-grid div {
      min-height: auto;
    }

    .scale-compare-grid div + div {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
      border-left: 0;
    }

    .scale-map {
      min-height: 380px;
    }

    .scale-map-legend {
      right: 12px;
      left: 12px;
    }

    .scale-map-summary {
      grid-template-columns: 1fr;
    }

    .scale-lane-readout + .scale-lane-readout,
    .scale-live-card {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
      border-left: 0;
    }

    .scale-node {
      min-width: 56px;
      border-radius: 14px;
      padding: 8px;
    }

    .scale-live-card {
      padding: 13px;
    }

    .scale-rule {
      grid-template-columns: 38px minmax(0, 1fr);
      min-height: auto;
      padding: 14px 0;
    }

    .scale-rule > span {
      width: 38px;
