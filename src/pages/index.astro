    .project-carousel::before {
      display: none;
    }

    .project-card-track {
      display: grid;
      gap: 12px;
      min-height: 0;
      transform: none !important;
    }

    .project-stage-card {
      position: relative;
      inset: auto;
      grid-template-rows: auto auto;
      gap: 18px;
      min-width: 0;
      min-height: 300px;
      border: 1px solid rgba(35, 61, 77, 0.12);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.52);
      padding: 22px;
      visibility: visible !important;
      opacity: 1 !important;
    }

    .project-stage-visual {
      justify-self: end;
      width: 150px;
      max-width: 42%;
      min-height: 92px;
      opacity: 0.88;
