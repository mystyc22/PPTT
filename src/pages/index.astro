    left: 17%;
  }

  .point-ab {
    top: 36%;
    left: 17%;
  }

  .point-ba {
    top: 74%;
    left: 37%;
  }

  .point-bag {
    top: 50%;
    left: 50%;
  }

  .point-relay {
