  .product-topline strong {
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.16);
    padding: 8px 10px;
    color: var(--black);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
  }

  .canvas-shell {
    position: relative;
    z-index: 1;
    height: clamp(320px, 43vw, 540px);
    margin: 0 18px;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(234, 236, 240, 0.74), rgba(255, 255, 255, 0.48)),
      var(--soft);
  }

  #mesh-canvas,
  .fallback-network,
  .canvas-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #mesh-canvas {
    z-index: 2;
  }

  .fallback-network {
    z-index: 1;
    display: grid;
    place-items: center;
    padding: 28px;
    opacity: 0.9;
    transition: opacity 220ms ease;
  }

  .is-webgl-ready .fallback-network {
    opacity: 0.22;
  }

  .webgl-failed .fallback-network {
    opacity: 1;
  }

  .fallback-network svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .fallback-lines path {
    fill: none;
    stroke: rgba(35, 61, 77, 0.22);
    stroke-width: 4;
  }

  .fallback-route {
    fill: none;
    stroke: var(--orange);
    stroke-dasharray: 820;
    stroke-dashoffset: 0;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 9;
    animation: routePulse 3.8s ease-in-out infinite;
  }

  .fallback-nodes circle {
    fill: var(--black);
    stroke: var(--soft);
    stroke-width: 5;
  }

  .fallback-nodes circle:nth-child(2n) {
    fill: var(--navy);
  }

  .fallback-packet {
    fill: var(--orange);
    filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.22));
    animation: packetMove 4.8s ease-in-out infinite;
  }

  @keyframes routePulse {
    0%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0.72;
    }

    50% {
      stroke-dashoffset: -120;
      opacity: 1;
    }
  }

  @keyframes packetMove {
    0%,
    100% {
      transform: translate(0, 0);
    }

    35% {
      transform: translate(280px, 52px);
    }

    70% {
      transform: translate(545px, 126px);
    }
  }

  .canvas-grid {
    z-index: 3;
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.08) 1px, transparent 1px),
      linear-gradient(180deg, rgba(35, 61, 77, 0.08) 1px, transparent 1px);
    background-size: 54px 54px;
    pointer-events: none;
    mask-image: linear-gradient(180deg, transparent 0%, black 18%, black 84%, transparent 100%);
  }

  .product-readout {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-top: 16px;
  }

  .product-readout div {
    min-width: 0;
    border-top: 1px solid rgba(35, 61, 77, 0.12);
    padding-top: 14px;
  }

  .product-readout strong {
    display: block;
    margin-top: 6px;
    overflow-wrap: anywhere;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88rem;
  }

  .hero-strip {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.14);
    border-radius: var(--radius);
    background: rgba(35, 61, 77, 0.14);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
  }

  .hero-strip div {
    min-height: 112px;
    background: rgba(255, 255, 255, 0.7);
    padding: 20px;
    backdrop-filter: blur(18px);
  }

  .hero-strip strong {
    display: block;
    font-size: clamp(1.42rem, 3.2vw, 2.5rem);
    line-height: 1;
  }

  .hero-strip span {
    display: block;
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .section,
  .motion-island,
  .lead-section {
    padding: clamp(74px, 10vw, 132px) 0;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(260px, 0.4fr);
    gap: clamp(24px, 5vw, 70px);
    align-items: end;
  }

  .section-heading.simple-heading {
    display: block;
  }

  .section-heading.simple-heading h2 {
    max-width: 980px;
  }

  .section-heading h2,
  .story-copy h2,
  .motion-island h2,
  .lead-panel h2 {
    margin-top: 14px;
    font-size: clamp(2.2rem, 5vw, 4.45rem);
    font-weight: 950;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .thesis-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 38px;
  }

  .thesis-card,
  .model-table,
  .ledger-card,
  .lead-panel,
  .motion-proof-card {
    border: 1px solid rgba(35, 61, 77, 0.14);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.07);
    backdrop-filter: blur(18px);
  }

  .thesis-card {
    min-height: 260px;
    padding: 24px;
  }

  .thesis-card span,
  .story-step span,
  .ledger-head span {
    color: var(--orange);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.76rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .thesis-card h3,
  .story-step h3 {
    margin-top: 18px;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.08;
  }

  .thesis-card p,
  .story-step p,
  .pilot-copy,
  .lead-panel p,
  .motion-island p {
    margin-top: 14px;
    color: var(--muted);
    line-height: 1.62;
  }

  .story-pin {
    padding: 60px 0;
  }

  .story-pin-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.72fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    min-height: 100svh;
  }

  .story-copy {
    justify-self: end;
    max-width: 640px;
    text-align: right;
  }

  .story-steps {
    display: grid;
    gap: 10px;
    margin-top: 34px;
  }

  .story-step {
    border-left: 3px solid rgba(35, 61, 77, 0.14);
    padding: 14px 0 14px 18px;
    opacity: 0.42;
    transform: translateX(0);
    transition:
      opacity 240ms ease,
      transform 240ms ease,
      border-color 240ms ease;
  }

  .story-step.is-active {
    border-color: var(--orange);
    opacity: 1;
    transform: translateX(8px);
  }

  .story-stage {
    position: relative;
    min-height: min(68vw, 680px);
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.14);
    border-radius: var(--radius);
    background:
      linear-gradient(140deg, rgba(255, 255, 255, 0.86), rgba(234, 236, 240, 0.62)),
      var(--soft);
    box-shadow: var(--shadow);
  }

  .flow-device {
    --flow-progress: 0.16;
    position: absolute;
    inset: 28px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    border-radius: 28px;
    background:
      radial-gradient(circle at 34% 36%, rgba(254, 127, 45, 0.16), transparent 32%),
      rgba(255, 255, 255, 0.62);
    padding: clamp(22px, 4vw, 40px);
  }

  .flow-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .flow-head span {
    color: rgba(35, 61, 77, 0.68);
  }

  .flow-head strong {
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.16);
    padding: 9px 12px;
    color: var(--black);
  }

  .flow-ledger {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-top: 1px solid rgba(35, 61, 77, 0.14);
    border-bottom: 1px solid rgba(35, 61, 77, 0.14);
  }

  .flow-ledger div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 17px 0;
  }

  .flow-ledger div + div {
    border-top: 1px solid rgba(35, 61, 77, 0.08);
  }

  .flow-ledger span {
    color: rgba(35, 61, 77, 0.66);
    font-weight: 850;
  }

  .flow-ledger strong {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.86rem;
    text-transform: uppercase;
  }

  .stage-map {
    position: absolute;
    inset: 28px;
    overflow: hidden;
    border-radius: var(--radius);
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.08) 1px, transparent 1px),
      linear-gradient(180deg, rgba(35, 61, 77, 0.08) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .stage-route {
    position: absolute;
    top: 54%;
    left: 13%;
    width: 73%;
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--orange) var(--route-progress, 16%), rgba(35, 61, 77, 0.18) 0);
    transform: rotate(-18deg);
    transform-origin: left center;
  }

  .stage-node,
  .stage-parcel,
  .stage-card {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
  }

  .stage-node {
    width: 86px;
    height: 52px;
    border: 1px solid rgba(35, 61, 77, 0.16);
    background: var(--white);
    color: var(--navy);
    font-weight: 900;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.08);
  }

  .n1 {
    top: 62%;
    left: 8%;
  }

  .n2 {
    top: 44%;
    left: 33%;
  }

  .n3 {
    top: 31%;
    left: 58%;
  }

  .n4 {
    top: 18%;
    right: 7%;
  }

  .stage-parcel {
    top: calc(64% - var(--parcel-y, 0px));
    left: calc(12% + var(--parcel-x, 0px));
    width: 74px;
    height: 46px;
    background: var(--black);
    color: var(--white);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 900;
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.22);
  }

  .stage-card {
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    width: min(210px, 42%);
    border: 1px solid rgba(35, 61, 77, 0.14);
    background: rgba(255, 255, 255, 0.78);
    padding: 16px;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(16px);
  }

  .stage-card span {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .stage-card strong {
    font-size: 1.1rem;
  }

  .stage-card-one {
    top: 9%;
    left: 8%;
  }

  .stage-card-two {
    right: 8%;
    bottom: 8%;
  }

  .economics-layout,
  .pilot-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(340px, 0.7fr);
    gap: 18px;
    margin-top: 38px;
  }

  .model-table,
  .ledger-card {
    overflow: hidden;
  }

  .model-row,
  .ledger-line,
  .ledger-head {
    display: grid;
    grid-template-columns: minmax(120px, 0.44fr) minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    border-bottom: 1px solid rgba(35, 61, 77, 0.1);
    padding: 20px;
  }

  .model-row:last-child,
  .ledger-line:last-child {
    border-bottom: 0;
  }

  .model-row strong {
    color: var(--black);
    font-size: 1.05rem;
  }

  .model-row span,
  .ledger-line span {
    color: var(--muted);
    line-height: 1.45;
  }

  .ledger-card {
    background: var(--navy);
    color: var(--white);
  }

  .ledger-head {
    display: flex;
    justify-content: space-between;
  }

  .ledger-head strong {
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.16);
    padding: 8px 10px;
    color: var(--orange);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
  }

  .ledger-line {
    grid-template-columns: 1fr auto;
    border-color: rgba(255, 255, 255, 0.12);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .ledger-line span {
    color: rgba(255, 255, 255, 0.68);
  }

  .ledger-line strong {
    color: var(--orange);
  }

  /* Final economics redesign */
  .economics {
    position: relative;
  }

  .economics-intro {
    max-width: 760px;
    margin-top: 18px;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.16rem);
    font-weight: 700;
    line-height: 1.55;
  }

  .economics-board {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(340px, 0.74fr);
    gap: clamp(14px, 2vw, 20px);
    margin-top: clamp(34px, 5vw, 56px);
  }

  .quote-lock-panel,
  .market-console,
  .audit-ledger-panel {
    border: 1px solid rgba(35, 61, 77, 0.09);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(244, 246, 248, 0.54)),
      rgba(255, 255, 255, 0.7);
    box-shadow: 0 22px 64px rgba(35, 61, 77, 0.07);
    backdrop-filter: blur(18px);
  }

  .quote-lock-panel {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 20px;
    min-height: 470px;
    overflow: hidden;
    padding: clamp(22px, 3vw, 34px);
  }

  .quote-lock-panel::before {
    position: absolute;
    top: 0;
    right: clamp(22px, 3vw, 34px);
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(35, 61, 77, 0.11), transparent);
    content: "";
    opacity: 0.8;
  }

  .market-console {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 14px;
    overflow: hidden;
    padding: clamp(18px, 2.4vw, 26px);
  }

  .market-console::before {
    position: absolute;
    inset: 64px 0 auto;
    height: 1px;
    background: rgba(35, 61, 77, 0.08);
    content: "";
  }

  .economics-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
  }

  .economics-panel-head span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: rgba(35, 61, 77, 0.62);
    font-size: 0.76rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .economics-panel-head strong {
    border: 1px solid rgba(254, 127, 45, 0.18);
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.08);
    color: var(--black);
    padding: 8px 10px;
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .economics-icon {
    width: 18px;
    height: 18px;
    color: var(--orange);
    stroke-width: 2.2;
  }

  .quote-amount {
    display: grid;
    gap: 8px;
    margin-top: 20px;
  }

  .quote-amount span {
    color: rgba(35, 61, 77, 0.62);
    font-size: 0.84rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .quote-amount strong {
    font-size: clamp(5rem, 11vw, 9rem);
    font-weight: 950;
    line-height: 0.76;
    letter-spacing: 0;
  }

  .quote-amount em {
    width: max-content;
    max-width: 100%;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.12);
    color: var(--black);
    padding: 7px 9px;
    font-size: 0.66rem;
    font-style: normal;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .quote-breakdown {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border-top: 1px solid rgba(35, 61, 77, 0.08);
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
  }

  .quote-breakdown div {
    display: grid;
    gap: 7px;
    min-height: 84px;
    align-content: center;
    padding: 12px 14px 12px 0;
  }

  .quote-breakdown div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.08);
    padding-left: 14px;
  }

  .quote-breakdown span,
  .market-clearing span {
    color: rgba(35, 61, 77, 0.56);
    font-size: 0.62rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .quote-breakdown strong,
  .market-clearing strong {
    color: var(--black);
    font-size: 0.82rem;
    font-weight: 950;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .quote-lock-panel p {
    max-width: 660px;
    margin-top: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    font-weight: 700;
    line-height: 1.55;
  }

  .quote-rules {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .quote-rules span {
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    padding: 8px 10px;
    color: rgba(35, 61, 77, 0.72);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .market-riders {
    display: grid;
    gap: 10px;
  }

  .market-clearing {
    display: grid;
    grid-template-columns: 0.86fr 1fr 0.9fr;
    gap: 0;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.54);
  }

  .market-clearing div {
    display: grid;
    gap: 8px;
    min-height: 86px;
    align-content: center;
    padding: 14px;
  }

  .market-clearing div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.08);
  }

  .market-rider {
    position: relative;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto auto;
    gap: 12px;
    align-items: center;
    min-height: 74px;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.48);
    padding: 13px 13px 17px;
  }

  .market-rider::after {
    position: absolute;
    right: 13px;
    bottom: 9px;
    left: 67px;
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background:
      linear-gradient(90deg, rgba(254, 127, 45, 0.52) 0 var(--bid-level, 50%), rgba(35, 61, 77, 0.08) var(--bid-level, 50%) 100%);
    content: "";
  }

  .market-rider span {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 14px;
    background: rgba(35, 61, 77, 0.07);
    font-weight: 950;
  }

  .market-rider p {
    color: rgba(35, 61, 77, 0.68);
    font-size: 0.86rem;
    font-weight: 750;
    line-height: 1.24;
  }

  .market-rider strong {
    font-size: 0.9rem;
    font-weight: 950;
    white-space: nowrap;
  }

  .market-rider em {
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.08);
    color: rgba(35, 61, 77, 0.72);
    padding: 6px 8px;
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .market-rider.is-selected {
    border-color: rgba(254, 127, 45, 0.28);
    background:
      linear-gradient(90deg, rgba(254, 127, 45, 0.12), rgba(255, 255, 255, 0.52) 42%),
      rgba(255, 255, 255, 0.58);
  }

  .market-rider.is-selected span,
  .market-rider.is-selected em {
    background: rgba(254, 127, 45, 0.16);
    color: var(--black);
  }

  .audit-ledger-panel {
    grid-column: 1 / -1;
    padding: clamp(18px, 2.4vw, 26px);
  }

  .audit-ledger-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    overflow: hidden;
    margin-top: 18px;
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.46);
  }

  .audit-ledger-grid div {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: center;
    min-height: 104px;
    padding: 16px;
  }

  .audit-ledger-grid div::before {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.58);
    content: "";
