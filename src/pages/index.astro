    z-index: 3;
    filter: drop-shadow(0 28px 34px rgba(35, 61, 77, 0.2));
    transform: scale(1.16);
    transform-origin: 52% 100%;
  }

  .hero .hero-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin-top: clamp(8px, 2vh, 28px);
    border-top: 1px solid rgba(35, 61, 77, 0.14);
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
  }

  .hero .hero-strip div {
    min-height: 118px;
    padding: 24px 26px;
  }

  .hero .hero-strip div:nth-child(3) {
    border-left: 1px solid rgba(35, 61, 77, 0.1);
  }

  .hero .hero-strip div:nth-child(n + 3) {
    border-top: 0;
  }

  .hero .hero-strip div::before {
    width: 26px;
    margin-bottom: 15px;
  }

  .hero .hero-strip strong {
    max-width: 18ch;
    font-size: clamp(1rem, 1.45vw, 1.22rem);
    line-height: 1.08;
    white-space: normal;
  }

  .hero .hero-strip span {
    max-width: 34ch;
    color: rgba(35, 61, 77, 0.68);
    font-size: 0.86rem;
    font-weight: 760;
    line-height: 1.42;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero .hero-flow {
      opacity: 0;
      transform: translateY(18px);
    }

    .hero .hero-route-base,
    .hero .hero-route-active,
    .hero .hero-route-spark {
      opacity: 0;
    }

    .hero .hero-route-node {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.72);
    }

    .hero.is-route-line-visible .hero-route-base {
      opacity: 1;
    }

    .hero.is-route-line-visible .hero-route-active {
      opacity: 0.7;
    }

    .hero.is-route-live .hero-route-active {
      animation:
        heroRouteFlow 1.25s linear infinite,
        heroRouteBreathe 3.8s ease-in-out infinite;
    }

    .hero.is-route-live .hero-route-spark {
      animation: heroRouteSpark 2.65s cubic-bezier(0.62, 0, 0.28, 1) infinite;
    }

    .hero.is-route-live .hero-route-node.is-shop,
    .hero.is-route-live .hero-route-node.is-rider {
      animation: heroRouteEndpoint 3.1s ease-in-out infinite;
    }

    .hero.is-route-live .hero-route-node::before {
      animation: heroRouteRing 2.8s ease-out infinite;
    }

    .hero.is-route-live .hero-route-node.is-shop {
      animation-delay: 0.35s;
    }

    .hero.is-route-live .hero-route-node.is-shop::before {
      animation-delay: 0.35s;
    }

    .hero.is-route-live .hero-route-node.is-bag {
      animation: heroRouteNode 2.4s ease-in-out infinite;
    }

    .hero.is-route-live .hero-route-node.is-bag::before {
      animation-delay: 0.7s;
    }
  }

  @keyframes heroRouteFlow {
    to {
      stroke-dashoffset: -68;
    }
  }

  @keyframes heroRouteSpark {
    0% {
      opacity: 0;
      stroke-dashoffset: 84;
    }

    14%,
    72% {
      opacity: 0.88;
    }

    100% {
      opacity: 0;
      stroke-dashoffset: -620;
    }
  }

  @keyframes heroRouteBreathe {
    0%,
    100% {
      opacity: 0.54;
    }

    50% {
      opacity: 0.84;
    }
  }

  @keyframes heroRouteNode {
    0%,
    100% {
      box-shadow:
        0 14px 34px rgba(35, 61, 77, 0.13),
        0 0 0 0 rgba(254, 127, 45, 0),
        inset 0 1px 0 rgba(255, 255, 255, 0.96);
    }

    50% {
      box-shadow:
        0 14px 34px rgba(35, 61, 77, 0.13),
        0 0 0 8px rgba(254, 127, 45, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.96);
    }
  }

  @keyframes heroRouteEndpoint {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
    }

    50% {
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  @keyframes heroRouteRing {
    0% {
      opacity: 0.56;
      transform: scale(0.78);
    }

    72%,
    100% {
      opacity: 0;
      transform: scale(1.22);
    }
  }

