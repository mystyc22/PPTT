  }

  .lab-topline,
  .lab-controls,
  .lab-readout {
    position: relative;
    z-index: 2;
  }

  .lab-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .lab-topline span,
  .lab-topline strong,
  .lab-controls label,
  .lab-control span,
  .lab-choice-group button,
  .lab-readout,
  .lab-chip {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .lab-topline span {
    color: var(--navy);
    opacity: 0.72;
  }

  .lab-topline strong,
  .lab-chip {
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.16);
    color: var(--black);
    padding: 9px 12px;
  }

  .lab-stage {
    position: relative;
    min-height: clamp(320px, 38vw, 500px);
    overflow: hidden;
    border-radius: 32px;
    background:
      radial-gradient(circle at 42% 53%, rgba(254, 127, 45, 0.16), transparent 36%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(234, 236, 240, 0.48));
  }

  .lab-stage::before {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: rgba(254, 127, 45, 0.18);
    content: "";
    filter: blur(34px);
    animation: stageGlow 4.5s ease-in-out infinite alternate;
  }

  .lab-map {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: min(96%, 690px);
    height: min(90%, 470px);
    overflow: visible;
    transform: translate(-50%, -50%);
  }

  .map-roads path {
    fill: none;
    stroke: rgba(35, 61, 77, 0.11);
    stroke-linecap: round;
    stroke-width: 4.4;
  }

  .map-roads path:nth-child(1),
  .map-roads path:nth-child(2),
  .map-roads path:nth-child(3) {
    stroke: rgba(35, 61, 77, 0.16);
    stroke-width: 6.4;
  }

  .map-labels text {
    fill: rgba(35, 61, 77, 0.28);
    font: 800 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .route-base path {
    fill: none;
    opacity: 0.9;
    stroke: rgba(35, 61, 77, 0.14);
    stroke-linecap: round;
    stroke-width: 12;
  }

  .map-node rect {
    fill: rgba(255, 255, 255, 0.9);
    stroke: rgba(35, 61, 77, 0.12);
    stroke-width: 1;
  }

  .map-node text {
    fill: var(--black);
    font: 900 13px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .map-node text + text {
    fill: rgba(35, 61, 77, 0.54);
    font-size: 10px;
  }

  .map-node path {
    fill: none;
    stroke: rgba(35, 61, 77, 0.36);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .map-node .node-icon {
    stroke: var(--navy);
    stroke-width: 3.4;
  }

  .map-node .pin-icon {
    stroke: var(--orange);
  }

  .bag-meter-bg {
    fill: rgba(35, 61, 77, 0.14);
  }

  .bag-meter-fill {
    fill: var(--orange);
    transform: scaleX(var(--bag-fill, 0.8));
    transform-origin: 342px 280px;
    transition: transform 180ms ease;
  }

  .lab-route {
    fill: none;
    opacity: 0;
    stroke: var(--orange);
    stroke-dasharray: 820;
    stroke-dashoffset: 0;
    stroke-linecap: round;
    stroke-width: 11;
    transition: opacity 240ms ease;
  }

  .lab-route.is-active {
    opacity: 1;
    animation: routePulse 3.2s ease-in-out infinite;
  }

  .lab-end {
    fill: var(--black);
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 7;
  }

  .lab-finish {
    fill: var(--navy);
  }

  .lab-bag {
    fill: var(--orange);
    opacity: calc(0.3 + var(--bag-fill, 0.8) * 0.7);
  }

  .courier-marker {
    transform: translate(150px, 320px);
  }

  .courier-marker circle {
    fill: var(--black);
  }

  .courier-marker path {
    fill: none;
    stroke: var(--white);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 3.2;
  }

  .courier-marker .moving-package {
    fill: var(--orange);
  }

  .courier-marker text {
    fill: var(--black);
    font: 950 8px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .route-lab.is-running .courier-marker {
    animation: packetWait 2.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .route-lab.is-bundle.is-running .courier-marker {
    animation-name: packetBundle;
  }

  .route-lab.is-skip.is-running .courier-marker {
    animation-name: packetSkip;
  }

  @keyframes packetWait {
    0% {
      transform: translate(150px, 320px);
    }

    72%,
    100% {
      transform: translate(360px, 246px);
    }
  }

  @keyframes packetBundle {
    0% {
      transform: translate(150px, 320px);
    }

    42% {
      transform: translate(360px, 246px);
    }

    68% {
      transform: translate(448px, 236px);
    }

    100% {
      transform: translate(678px, 160px);
    }
  }

  @keyframes packetSkip {
    0% {
      transform: translate(150px, 320px);
    }

    38% {
      transform: translate(292px, 360px);
    }

    68% {
      transform: translate(506px, 310px);
    }

    100% {
      transform: translate(678px, 160px);
    }
  }

  .lab-chip {
    position: absolute;
    z-index: 2;
    display: none;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
  }

  .pickup-chip {
    top: 23%;
    left: 12%;
  }

  .rider-chip {
    top: 44%;
    right: 17%;
  }

  .ledger-chip {
    right: 19%;
    bottom: 16%;
    background: rgba(35, 61, 77, 0.1);
  }

  .lab-controls {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr 0.82fr auto;
    gap: 10px;
    align-items: end;
    margin-top: 14px;
  }

  .lab-controls label,
  .lab-control {
    display: grid;
    gap: 7px;
    color: rgba(35, 61, 77, 0.72);
  }

  .lab-controls label > span:first-child {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .lab-controls label > span:first-child strong {
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.16);
    padding: 2px 8px;
    color: var(--black);
    font-size: 0.68rem;
  }

  .lab-choice-group {
    --choice-count: 2;
    --choice-index: 0;
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0;
    min-height: 42px;
    border: 1px solid rgba(35, 61, 77, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    padding: 4px;
  }

  .lab-control:first-child .lab-choice-group {
    --choice-count: 3;
  }

  .lab-choice-group::before {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    z-index: 0;
    width: calc((100% - 8px) / var(--choice-count));
    border-radius: 999px;
    background: var(--black);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
    content: "";
    transform: translateX(calc(var(--choice-index) * 100%));
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lab-choice-group button {
    position: relative;
    z-index: 1;
    min-width: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(35, 61, 77, 0.7);
    padding: 0 9px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lab-choice-group button.is-selected {
    color: var(--white);
  }

  .lab-range {
    position: relative;
    display: block;
    height: 42px;
    overflow: hidden;
    border-radius: 999px;
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.12) 1px, transparent 1px),
      rgba(255, 255, 255, 0.68);
    background-size: 20% 100%;
    box-shadow: inset 0 0 0 1px rgba(35, 61, 77, 0.14);
  }

  .lab-range-fill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc(100% - 8px);
    border-radius: 999px;
    background: linear-gradient(90deg, var(--orange), rgba(254, 127, 45, 0.62));
    content: "";
    pointer-events: none;
    transform: scaleX(var(--demand-level, 0.38));
    transform-origin: left center;
    transition: transform 160ms ease;
  }

  .lab-controls input {
    position: relative;
    z-index: 2;
    width: 100%;
    min-height: 42px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--black);
    outline: none;
  }

  .lab-controls input {
    appearance: none;
    accent-color: transparent;
    padding: 0;
  }

  .lab-controls input::-webkit-slider-runnable-track {
    height: 42px;
    background: transparent;
  }

  .lab-controls input::-webkit-slider-thumb {
    width: 22px;
    height: 22px;
    margin-top: 10px;
    border: 3px solid var(--white);
    border-radius: 50%;
    appearance: none;
    background: var(--black);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.22);
  }

  .lab-controls input::-moz-range-track {
    height: 42px;
    background: transparent;
  }

  .lab-controls input::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 3px solid var(--white);
    border-radius: 50%;
    background: var(--black);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.22);
  }

  .lab-run {
    min-height: 42px;
    border: 0;
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    padding: 0 18px;
    font-weight: 900;
  }

  .lab-readout {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px;
    align-items: center;
    margin-top: 12px;
    color: var(--navy);
  }

  .lab-readout span,
  .lab-readout strong,
  .lab-readout em {
    min-width: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.52);
    padding: 10px 12px;
    font-style: normal;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1080px) {
    .route-lab {
      width: min(100%, 760px);
      border-radius: 30px;
    }

    .lab-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lab-run {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .hero-copy h1 {
      max-width: 100%;
    }

    .route-lab {
      width: 100%;
      max-width: 390px;
      min-width: 0;
      margin-inline: auto;
      border-radius: 26px;
      padding: 12px;
    }

    .lab-topline {
      display: grid;
      grid-template-columns: 1fr;
      justify-items: start;
      margin-bottom: 12px;
    }

    .lab-topline strong {
      max-width: 100%;
      white-space: normal;
    }

    .lab-stage {
      min-height: 220px;
      border-radius: 22px;
    }

    .lab-map {
      left: 50%;
      width: 104%;
      height: 94%;
    }

    .lab-chip {
      display: none;
    }

    .lab-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 10px;
    }

    .lab-controls label,
    .lab-control {
      min-width: 0;
      font-size: 0.68rem;
    }

    .lab-controls input {
      min-height: 40px;
      padding-inline: 9px;
      font-size: 0.78rem;
    }

    .lab-choice-group {
      min-height: 40px;
    }

    .lab-choice-group button {
      padding-inline: 6px;
      font-size: 0.68rem;
    }

    .lab-controls label {
      grid-column: 1 / 2;
    }

    .lab-run {
      grid-column: 2 / 3;
      align-self: end;
      width: 100%;
      min-width: 0;
      min-height: 40px;
      padding-inline: 10px;
    }

    .lab-readout {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
      margin-top: 10px;
    }

    .lab-readout span,
    .lab-readout strong,
    .lab-readout em {
      padding: 9px 10px;
      font-size: 0.68rem;
    }

    .lab-readout em {
      grid-column: 1 / -1;
    }

    .story-stage {
      display: none;
    }

    .story-pin-inner {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
    }
  }

  /* Refined visual system: less card-grid, more product-storytelling. */
  body {
    background:
      radial-gradient(circle at 16% 14%, rgba(254, 127, 45, 0.16), transparent 28%),
      radial-gradient(circle at 82% 8%, rgba(35, 61, 77, 0.12), transparent 30%),
      linear-gradient(135deg, #ffffff 0%, #f6f7f9 46%, var(--soft) 100%);
  }

  body::before {
    opacity: 0.42;
    background-size: 120px 120px;
  }

  body::after {
    animation: pageSheen 12s ease-in-out infinite alternate;
    opacity: 0.72;
  }

  @keyframes pageSheen {
    from {
      transform: translate3d(-2%, -1%, 0) rotate(-1deg);
    }

    to {
      transform: translate3d(2%, 2%, 0) rotate(1deg);
    }
  }

  .hero {
    min-height: min(980px, 100svh);
    padding-bottom: 24px;
  }

  .hero-grid {
    grid-template-columns: minmax(0, 0.86fr) minmax(420px, 0.86fr);
    min-height: auto;
    padding: clamp(46px, 8vh, 86px) 0 clamp(32px, 6vh, 64px);
  }

  .hero-copy h1 {
    font-size: clamp(4.2rem, 6.7vw, 7.2rem);
    line-height: 0.88;
  }

  .hero-lede {
    max-width: 55ch;
  }

  .hero-product {
    border: 0;
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.36);
    box-shadow: none;
    backdrop-filter: blur(26px);
  }

  .hero-product::before {
    border-radius: inherit;
    background:
      linear-gradient(115deg, rgba(254, 127, 45, 0.22), transparent 34%),
      radial-gradient(circle at 70% 24%, rgba(255, 255, 255, 0.92), transparent 34%);
  }

  .canvas-shell {
    height: clamp(360px, 38vw, 510px);
    border: 0;
    border-radius: 28px;
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.9), rgba(234, 236, 240, 0.42)),
      var(--soft);
    box-shadow:
      inset 0 0 0 1px rgba(35, 61, 77, 0.12),
      0 36px 90px rgba(35, 61, 77, 0.16);
  }

  .canvas-shell::before {
    position: absolute;
    inset: 14%;
    z-index: 0;
    border-radius: 50%;
    background: rgba(254, 127, 45, 0.16);
    filter: blur(40px);
    content: "";
    animation: stageGlow 5s ease-in-out infinite alternate;
  }

  @keyframes stageGlow {
    from {
      transform: translate3d(-4%, 2%, 0) scale(0.96);
      opacity: 0.62;
    }

    to {
      transform: translate3d(5%, -3%, 0) scale(1.08);
      opacity: 1;
    }
  }

  .product-topline {
    padding: 8px 18px 14px;
  }

  .product-readout {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding: 16px 18px 8px;
  }

  .product-readout div {
    width: auto;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.48);
    padding: 9px 12px;
  }

  .product-readout span,
  .product-readout strong {
    display: inline;
    margin: 0;
  }

  .product-readout span::after {
    content: " / ";
  }

  .hero-strip {
    border-width: 1px 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .hero-strip div {
    min-height: 86px;
    background: transparent;
    backdrop-filter: none;
  }

  .hero-strip div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.12);
  }

  .section,
  .motion-island,
  .lead-section {
    padding-block: clamp(96px, 12vw, 168px);
  }

  .thesis-grid {
    gap: 0;
    border-top: 1px solid rgba(35, 61, 77, 0.16);
    border-bottom: 1px solid rgba(35, 61, 77, 0.16);
  }

  .thesis-card {
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    padding: 34px 32px 38px 0;
  }

  .thesis-card + .thesis-card {
    border-left: 1px solid rgba(35, 61, 77, 0.16);
    padding-left: 32px;
  }

  .motion-proof-rail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid rgba(35, 61, 77, 0.16);
    border-bottom: 1px solid rgba(35, 61, 77, 0.16);
  }

  .motion-proof-row {
    display: grid;
    grid-template-columns: 140px minmax(220px, 0.42fr) minmax(0, 1fr);
    gap: 28px;
    align-items: baseline;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    padding: 24px 0;
  }

  .motion-proof-row + .motion-proof-row {
    border-top: 1px solid rgba(35, 61, 77, 0.1);
  }

  .motion-proof-card h3,
  .motion-proof-card p {
    margin: 0;
  }

  .story-stage {
    border: 0;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 40px 110px rgba(35, 61, 77, 0.14);
  }

  .stage-map {
    border-radius: 26px;
    background-color: rgba(255, 255, 255, 0.42);
  }

  .lead-panel {
    overflow: hidden;
    border: 0;
    border-radius: 32px;
    background:
      radial-gradient(circle at 18% 18%, rgba(254, 127, 45, 0.18), transparent 32%),
      linear-gradient(135deg, var(--navy), #071017);
    color: var(--white);
    box-shadow: 0 44px 120px rgba(0, 0, 0, 0.22);
  }

  .lead-panel .eyebrow,
  .lead-panel p {
    color: rgba(255, 255, 255, 0.72);
  }

  .lead-panel h2 {
    color: var(--white);
  }

  .lead-form label,
  .lead-form-field {
    color: rgba(255, 255, 255, 0.82);
  }

  .lead-form input,
  .lead-form select,
  .lead-form textarea {
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.08);
    color: var(--white);
  }

  .lead-form input::placeholder,
  .lead-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.44);
  }

  .lead-form .button-primary {
    border-color: var(--orange);
    background: var(--orange);
    color: var(--black);
  }

  /* Final pilot, lead, and footer */
  .pilot-intro {
    max-width: 780px;
    margin-top: 18px;
    color: var(--muted);
    font-size: clamp(1rem, 1.45vw, 1.14rem);
    font-weight: 750;
    line-height: 1.56;
  }

  .pilot-system {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.56fr);
    gap: clamp(14px, 2vw, 20px);
    margin-top: clamp(34px, 5vw, 56px);
  }

  .pilot-console,
  .pilot-control-panel {
    border: 1px solid rgba(35, 61, 77, 0.09);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(244, 246, 248, 0.56)),
      rgba(255, 255, 255, 0.72);
    box-shadow: 0 22px 64px rgba(35, 61, 77, 0.07);
    backdrop-filter: blur(18px);
  }

  .pilot-console {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(440px, 1fr) auto;
    gap: 18px;
    overflow: hidden;
    padding: clamp(18px, 2.4vw, 28px);
  }

  .pilot-console-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pilot-console-head span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: rgba(35, 61, 77, 0.66);
    font-size: 0.76rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .pilot-console-head strong {
    border: 1px solid rgba(254, 127, 45, 0.2);
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.1);
    padding: 8px 10px;
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .pilot-icon {
    width: 18px;
    height: 18px;
    color: var(--orange);
  }

  .pilot-map-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(260px, 1fr) auto;
    gap: 18px;
    overflow: hidden;
    min-width: 0;
    min-height: 380px;
    border-top: 1px solid rgba(35, 61, 77, 0.08);
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 0;
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.04) 1px, transparent 1px),
      linear-gradient(180deg, rgba(35, 61, 77, 0.04) 1px, transparent 1px),
      rgba(255, 255, 255, 0.3);
    background-size: 42px 42px, 42px 42px, auto;
  }

  .pilot-map-status,
  .pilot-map-note {
    position: relative;
    z-index: 4;
    display: inline-grid;
    gap: 5px;
    width: max-content;
    max-width: min(100%, 320px);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.76);
    padding: 10px 12px;
    box-shadow: 0 12px 30px rgba(35, 61, 77, 0.07);
  }

  .pilot-map-status {
    align-self: start;
    justify-self: start;
  }

  .pilot-map-note {
    align-self: end;
    justify-self: end;
    max-width: 300px;
  }

  .pilot-map-status span,
  .pilot-map-note span,
  .pilot-console-foot span {
    color: rgba(35, 61, 77, 0.56);
    font-size: 0.62rem;
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .pilot-map-note span {
    overflow-wrap: anywhere;
  }

  .pilot-map-status strong,
  .pilot-console-foot strong {
    color: var(--black);
    font-size: 0.84rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .pilot-corridor-rail {
    position: relative;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    align-content: center;
    justify-self: stretch;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 250px;
    overflow: hidden;
    padding: 22px 0 72px;
  }

  .pilot-rail-line {
    position: absolute;
    z-index: 1;
    top: calc(50% - 36px);
    right: 12.5%;
    left: 12.5%;
    height: 9px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.11);
  }

  .pilot-rail-line span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--orange);
    transform: scaleX(var(--pilot-progress, 0));
    transform-origin: left center;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pilot-point {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: 24px 46px auto auto;
    justify-items: center;
    gap: 8px;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--navy);
    padding: 0 4px;
    font: inherit;
    text-align: center;
    cursor: pointer;
    transition: transform 180ms ease;
  }

  .pilot-point,
  .pilot-tabs button {
    -webkit-tap-highlight-color: transparent;
  }

  .pilot-point:hover,
  .pilot-point.is-active {
    transform: translateY(-3px);
  }

  .pilot-step-code {
    display: grid;
    width: 34px;
    height: 24px;
    place-items: center;
    border-radius: 999px;
    background: #fff;
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.62rem;
    font-weight: 950;
    line-height: 1;
  }

  .pilot-point-icon {
    width: 46px;
    height: 46px;
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 15px;
    background: #fff;
    color: var(--black);
    padding: 11px;
    box-shadow: 0 14px 32px rgba(35, 61, 77, 0.1);
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .pilot-point strong {
    font-size: 0.76rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .pilot-point em {
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 850;
    line-height: 1;
    text-transform: uppercase;
  }

  .pilot-point.is-active .pilot-step-code,
  .pilot-point.is-active .pilot-point-icon {
    background: #ffe6d5;
    color: var(--black);
  }

  .pilot-point.is-active .pilot-point-icon {
    border-color: rgba(254, 127, 45, 0.32);
    transform: translateY(-2px);
  }

  .pilot-rider {
    position: absolute;
    z-index: 4;
    bottom: 18px;
    left: var(--pilot-marker-x, 12.5%);
    display: inline-grid;
    grid-template-columns: 34px auto;
    gap: 7px;
    align-items: center;
    border-radius: 999px;
    background: rgba(5, 5, 5, 0.94);
    color: var(--white);
    padding: 6px 11px 6px 6px;
    font-size: 0.72rem;
    font-weight: 950;
    box-shadow: none;
    transform: translateX(-50%);
    transition:
      left 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pilot-rider-icon {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--orange);
    color: var(--black);
    padding: 7px;
  }

  .pilot-console-foot {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.48);
  }

  .pilot-console-foot div {
    display: grid;
    gap: 6px;
    min-height: 82px;
    align-content: center;
    padding: 14px;
  }

  .pilot-console-foot div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.08);
  }

  .pilot-control-panel {
    display: grid;
    grid-template-rows: auto auto auto;
    align-content: start;
    gap: 18px;
    padding: clamp(20px, 2.6vw, 32px);
  }

  .pilot-focus-card {
    box-sizing: border-box;
    display: grid;
    gap: 0;
    min-height: 180px;
    align-content: start;
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
    padding-bottom: 20px;
  }

  .pilot-control-panel h3 {
    margin-top: 14px;
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    line-height: 1.2;
  }

  .pilot-control-panel p:not(.eyebrow) {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .pilot-tabs {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(35, 61, 77, 0.08);
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
  }

  .lead-switch button {
    min-height: 42px;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    color: var(--navy);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .lead-switch button.is-active {
    border-color: rgba(254, 127, 45, 0.42);
    background: var(--orange);
    color: var(--black);
  }

  .pilot-tabs button {
    position: relative;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-height: 58px;
    border: 0;
    background: transparent;
    color: var(--navy);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pilot-point:focus,
  .pilot-tabs button:focus {
    outline: none;
  }

  @media (pointer: fine) {
    .pilot-point:focus-visible,
    .pilot-tabs button:focus-visible {
      outline: 2px solid rgba(254, 127, 45, 0.5);
      outline-offset: 3px;
    }
  }

  .pilot-tabs button + button {
    border-top: 1px solid rgba(35, 61, 77, 0.08);
  }

  .pilot-tabs button::before {
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 0;
    width: 3px;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0);
    content: "";
  }

  .pilot-tabs button span {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 10px;
    background: rgba(35, 61, 77, 0.07);
    font-size: 0.68rem;
    font-weight: 950;
  }

  .pilot-tabs button strong {
    font-size: 0.78rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .pilot-tabs button.is-active {
    color: var(--black);
  }

  .pilot-tabs button.is-active::before {
    background: rgba(254, 127, 45, 0.78);
  }

  .pilot-tabs button.is-active span {
    background: rgba(254, 127, 45, 0.16);
  }

  .pilot-signal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.56);
  }

  .pilot-signal-grid div {
    display: grid;
    gap: 7px;
    min-height: 104px;
    align-content: center;
    padding: 14px;
  }

  .pilot-signal-grid div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.08);
  }

  .pilot-signal-grid span {
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.64rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .pilot-signal-grid strong {
    font-size: 0.9rem;
    line-height: 1.12;
    text-transform: uppercase;
  }

  /* Sponsor round / Pre-seed styles */
  .sponsor-round {
    margin-top: clamp(64px, 8vw, 110px);
    margin-bottom: clamp(64px, 8vw, 110px);
  }

  .sponsor-intro {
    max-width: 820px;
    margin-top: 20px;
    color: var(--muted);
    font-size: clamp(1rem, 1.45vw, 1.14rem);
    font-weight: 750;
    line-height: 1.56;
  }

  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 22px);
    margin-top: clamp(34px, 5vw, 56px);
  }

  .sponsor-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.6vw, 32px);
    border: 1px solid rgba(35, 61, 77, 0.09);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(244, 246, 248, 0.58)),
      rgba(255, 255, 255, 0.72);
    box-shadow: 0 22px 64px rgba(35, 61, 77, 0.06);
    backdrop-filter: blur(18px);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .sponsor-card:hover {
    transform: translateY(-3px);
    border-color: rgba(254, 127, 45, 0.28);
    box-shadow: 0 28px 72px rgba(35, 61, 77, 0.1);
  }

  .sponsor-card.is-highlight {
    background:
      radial-gradient(circle at 12% 12%, rgba(254, 127, 45, 0.12), transparent 48%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(254, 248, 244, 0.8));
    border-color: rgba(254, 127, 45, 0.34);
    box-shadow: 0 24px 68px rgba(254, 127, 45, 0.12);
  }

  .sponsor-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .sponsor-card-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: rgba(35, 61, 77, 0.07);
    color: var(--navy);
    font-size: 0.85rem;
    font-weight: 950;
    letter-spacing: 0.04em;
  }

  .sponsor-card.is-highlight .sponsor-card-tag {
    background: var(--orange);
    color: var(--white);
  }

  .sponsor-card-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(254, 127, 45, 0.08);
    color: var(--orange);
  }

  .sponsor-card-icon .icon-svg {
    width: 20px;
    height: 20px;
    stroke-width: 2.2;
  }

  .sponsor-card h3 {
    margin: 0 0 12px;
    color: var(--black);
    font-size: clamp(1.15rem, 1.4vw, 1.32rem);
    font-weight: 850;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .sponsor-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .sponsor-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .sponsor-grid {
      grid-template-columns: 1fr;
    }
  }

  .lead-panel {
    position: relative;
    grid-template-columns: minmax(0, 0.76fr) minmax(340px, 0.7fr);
    align-items: start;
    min-height: 768px;
    background:
      radial-gradient(circle at 16% 18%, rgba(254, 127, 45, 0.22), transparent 34%),
      linear-gradient(145deg, #050505, #12191d 58%, #241206);
  }

  .lead-copy {
    display: grid;
    min-height: 652px;
    align-content: start;
  }

  .lead-panel h2 {
    min-height: 356px;
  }

  .lead-copy > [data-lead-copy] {
    min-height: 52px;
  }

  .lead-switch {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 28px;
  }

  .lead-switch button {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.78);
  }

  .lead-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-top: 22px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.1);
  }

  .lead-summary div {
    display: grid;
    gap: 8px;
    min-height: 94px;
    align-content: center;
    background: rgba(255, 255, 255, 0.06);
    padding: 14px;
  }

  .lead-summary span {
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.66rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .lead-summary strong {
    color: var(--white);
    font-size: 0.95rem;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .lead-form {
    position: relative;
    display: grid;
    gap: 14px;
    min-height: 652px;
    align-content: start;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.06);
    padding: clamp(16px, 2.4vw, 24px);
  }

  .lead-form.is-sending {
    pointer-events: none;
  }

  .lead-form.is-sending .button-primary {
    opacity: 0.72;
  }

  .lead-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .lead-form.is-success {
    align-content: stretch;
  }

  .lead-form.is-success > :not(.lead-success) {
    display: none;
  }

  .lead-success {
    display: grid;
    min-height: 604px;
    place-items: center;
    align-content: center;
    gap: 16px;
    text-align: center;
  }

  .lead-success[hidden] {
    display: none;
  }

  .lead-success-check {
    display: grid;
    width: 92px;
    height: 92px;
    place-items: center;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.14);
    box-shadow:
      0 22px 52px rgba(254, 127, 45, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .lead-success-check svg {
    width: 76px;
    height: 76px;
    overflow: visible;
  }

  .lead-success-check circle,
  .lead-success-check path {
    fill: none;
    stroke: var(--orange);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lead-success-check circle {
    stroke-width: 4;
  }

  .lead-success-check path {
    stroke-width: 6;
  }

  .lead-success > span:not(.lead-success-check) {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.68rem;
    font-weight: 950;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .lead-success h3 {
    max-width: 12ch;
    color: var(--white);
    font-size: clamp(2.1rem, 4vw, 3.3rem);
    font-weight: 950;
    line-height: 0.96;
  }

  .lead-success p {
    max-width: 32ch;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    font-weight: 760;
    line-height: 1.42;
  }

  .lead-success .button {
    width: min(100%, 240px);
    margin-top: 6px;
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
    box-shadow: none;
  }

  .lead-success .button:hover,
  .lead-success .button:focus-visible {
    border-color: rgba(254, 127, 45, 0.58);
    background: rgba(254, 127, 45, 0.18);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lead-form.is-success .lead-success {
      animation: leadSuccessEnter 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .lead-form.is-success .lead-success-check {
      animation: leadSuccessPop 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .lead-form.is-success .lead-success-check circle {
      stroke-dasharray: 195;
      stroke-dashoffset: 195;
      animation: leadCheckDraw 620ms ease-out 120ms forwards;
    }

    .lead-form.is-success .lead-success-check path {
      stroke-dasharray: 54;
      stroke-dashoffset: 54;
      animation: leadCheckDraw 420ms ease-out 520ms forwards;
    }
  }

  @keyframes leadSuccessEnter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes leadSuccessPop {
    0% {
      opacity: 0;
      transform: scale(0.72);
    }

    70% {
      opacity: 1;
      transform: scale(1.06);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes leadCheckDraw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .lead-form select option {
    color: var(--black);
  }

  .lead-form .lead-native-select {
    position: absolute;
    box-sizing: border-box;
    width: 1px;
    height: 1px;
    min-height: 0;
    border: 0;
    margin: 0;
    padding: 0;
    opacity: 0;
    pointer-events: none;
  }

  .lead-custom-select {
    position: relative;
    z-index: 8;
  }

  .lead-select-trigger {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18px;
    gap: 12px;
    align-items: center;
    width: 100%;
    min-height: 50px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.88);
    padding: 0 14px;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .lead-select-trigger:hover,
  .lead-custom-select.is-open .lead-select-trigger {
    border-color: rgba(254, 127, 45, 0.42);
    background: rgba(255, 255, 255, 0.12);
  }

  .lead-custom-select.has-error .lead-select-trigger {
    border-color: rgba(254, 127, 45, 0.74);
    box-shadow: 0 0 0 4px rgba(254, 127, 45, 0.12);
  }

  .lead-select-trigger span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lead-select-icon {
    width: 18px;
    height: 18px;
    color: var(--orange);
    transition: transform 180ms ease;
  }

  .lead-custom-select.is-open .lead-select-icon {
    transform: rotate(180deg);
  }

  .lead-select-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    z-index: 20;
    display: grid;
    gap: 4px;
    max-height: 216px;
    overflow: auto;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    background: #10171c;
    padding: 6px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.28);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .lead-custom-select.is-open .lead-select-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .lead-select-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: rgba(255, 255, 255, 0.78);
    padding: 0 10px;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .lead-select-option:hover,
  .lead-select-option.is-selected {
    background: rgba(254, 127, 45, 0.14);
    color: var(--white);
  }

  .lead-select-option.is-selected::after {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--orange);
    content: "";
  }

  .site-footer {
    position: relative;
    overflow: hidden;
    margin-top: clamp(16px, 4vw, 54px);
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
