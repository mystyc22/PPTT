  .parcel-cluster {
    position: absolute;
    z-index: 4;
    top: var(--parcel-y, 76%);
    left: var(--parcel-x, 17%);
    display: grid;
    grid-template-columns: repeat(3, 15px) auto;
    gap: 4px;
    transform: translate(-50%, -50%);
    transition:
      top 260ms cubic-bezier(0.22, 1, 0.36, 1),
      left 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .delivery-stack {
    position: absolute;
    z-index: 5;
    top: 39%;
    left: 82%;
    display: grid;
    grid-template-columns: repeat(3, 13px) auto;
    gap: 4px;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .handoff-stack {
    position: absolute;
    z-index: 5;
    display: grid;
    grid-template-columns: repeat(2, 13px) auto;
    gap: 4px;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.92);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .handoff-stack.is-active {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .handoff-bag {
    top: 43%;
    left: 52%;
  }

  .handoff-relay {
    top: 64%;
    left: 72%;
  }

  .package-icon {
    display: grid;
    width: 14px;
    height: 14px;
    place-items: center;
    border-radius: 5px;
    background: rgba(254, 127, 45, 0.14);
    color: var(--orange);
    opacity: 0.18;
    transform: translateY(2px);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .parcel-cluster strong,
  .delivery-stack strong,
  .handoff-stack strong {
    display: grid;
    min-width: 24px;
    height: 18px;
    place-items: center;
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.62rem;
    font-weight: 950;
    line-height: 1;
  }

  .package-icon .icon-svg {
    width: 10px;
    height: 10px;
  }

  .package-icon.is-active {
    background: var(--orange);
    color: var(--black);
    opacity: 1;
    transform: translateY(0);
  }

  .delivery-stack .package-icon {
    background: var(--navy);
    color: var(--white);
    opacity: 0;
    transform: translate(-8px, 8px) scale(0.72);
  }

  .handoff-stack .package-icon {
    background: var(--orange);
    color: var(--black);
    opacity: 0;
    transform: translate(-6px, 6px) scale(0.72);
  }

  .delivery-stack strong,
  .handoff-stack strong {
    opacity: 0;
    transform: translate(-8px, 8px) scale(0.8);
    transition:
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .route-lab.is-running .parcel-cluster .package-icon.is-active {
    animation: packagePickup 820ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .route-lab.is-complete .parcel-cluster .package-icon.is-active {
    opacity: 0.2;
  }

  .route-lab.is-complete .delivery-stack .package-icon.is-dropped {
    opacity: 1;
    transform: translate(0, 0) scale(1);
    transition:
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .route-lab.is-complete .delivery-stack strong {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }

  .route-lab.is-complete .delivery-stack .package-icon.is-dropped:nth-child(2) {
    transition-delay: 70ms;
  }

  .route-lab.is-complete .delivery-stack .package-icon.is-dropped:nth-child(3) {
    transition-delay: 140ms;
  }

  .route-lab.is-complete .delivery-stack .package-icon.is-dropped:nth-child(4) {
    transition-delay: 210ms;
  }

  .route-lab.is-outtake .delivery-stack .package-icon.is-dropped {
    opacity: 0.42;
    transform: translate(9px, -7px) scale(0.82);
    transition:
      opacity 260ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .route-lab.is-ledger .delivery-stack .package-icon.is-dropped {
    opacity: 0;
    transform: translate(18px, -12px) scale(0.62);
  }

  .route-lab .delivery-stack .package-icon.is-dropped {
    opacity: 0.9;
    transform: translate(0, 0) scale(1);
  }

  .route-lab .handoff-stack .package-icon.is-dropped {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }

  .route-lab .delivery-stack strong,
  .route-lab .handoff-stack.is-active strong {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }

  @keyframes packagePickup {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    70%,
    100% {
      opacity: 0.24;
      transform: translate(14px, -10px) scale(0.78);
    }
  }

  .moving-rider {
