    position: absolute;
    top: 50%;
    right: var(--range-line-pad);
    left: var(--range-line-pad);
    height: 5px;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.13);
    content: "";
    transform: translateY(-50%);
