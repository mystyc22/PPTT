    font-size: 0.66rem;
    font-style: normal;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .quote-breakdown {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
