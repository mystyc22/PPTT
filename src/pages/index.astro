    grid-template-columns: minmax(740px, 1.4fr) minmax(340px, 0.52fr);
    gap: clamp(34px, 5vw, 74px);
  }

  .story-copy {
    max-width: 500px;
    text-align: left;
  }

  .story-copy h2 {
    font-size: clamp(2.25rem, 3.85vw, 4.1rem);
    line-height: 0.96;
  }

  .story-stage {
    min-height: clamp(650px, 48vw, 740px);
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .flow-device {
    --flow-shift: 10px;
    --flow-shift-soft: 5px;
    --flow-card-drop: 0px;
    --flow-card-rotate: 0deg;
    --flow-sheet-one-opacity: 0;
    --flow-sheet-one-y: 0px;
    --flow-sheet-one-scale: 1;
    --flow-sheet-one-rotate: 0deg;
    --flow-sheet-two-opacity: 0;
    --flow-sheet-two-y: 0px;
    --flow-sheet-two-scale: 1;
    --flow-sheet-two-rotate: 0deg;
    --flow-sheet-three-opacity: 0;
    --flow-sheet-three-y: 0px;
    --flow-sheet-three-scale: 1;
    --flow-sheet-three-rotate: 0deg;
    inset: clamp(14px, 2.2vw, 26px);
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 38px 470px auto;
    gap: clamp(14px, 2vw, 22px);
    overflow: visible;
    border: 0;
    border-radius: 24px;
    background: transparent;
    box-shadow: none;
    padding: clamp(16px, 2.4vw, 26px);
  }

  .flow-device.is-flow-backward {
    --flow-shift: -10px;
    --flow-shift-soft: -5px;
  }

  .flow-head {
    min-height: 38px;
  }

  .flow-board {
    position: relative;
    display: grid;
    height: 470px;
    min-height: 0;
    overflow: hidden;
    border: 0;
    border-radius: 28px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(245, 246, 248, 0.64)),
      rgba(255, 255, 255, 0.72);
    box-shadow: 0 24px 70px rgba(35, 61, 77, 0.085);
    color: var(--black);
    padding: clamp(18px, 2.5vw, 30px);
