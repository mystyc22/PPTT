---
import InvestorMotion from "../components/InvestorMotion";
import {
  ArrowRightLeft,
  BadgeCheck,
  Bike,
  ClipboardCheck,
  ChevronDown,
  ListTree,
  MapPinned,
  Menu,
  Network,
  Package as PackageIcon,
  ReceiptText,
  Route,
  ScanLine,
  ShoppingBag,
  Store,
  Waypoints,
  X,
} from "@lucide/astro";

const projectStages = [
  {
    tag: "01",
    label: "Start",
    title: "Recruit the first shop ring",
    body: "Begin with a small cluster of trusted shops close enough for riders to move sealed bags without a warehouse.",
    metric: "5-8 points",
    visual: "shops",
  },
  {
    tag: "02",
    label: "Sort",
    title: "Give each point direction bags",
    body: "Staff sort parcels into simple route directions, keep local counts visible, and only open bags when the next direction changes.",
    metric: "8 directions",
    visual: "sort",
  },
  {
    tag: "03",
    label: "Move",
    title: "Let riders take live bags",
    body: "Riders accept available sealed bags, hand them off at intermediate points, and keep counts conserved across every move.",
    metric: "live dispatch",
    visual: "riders",
  },
  {
    tag: "04",
    label: "Audit",
    title: "Record every handoff",
    body: "Each pickup, transfer, outtake, handling fee, and rider payout becomes a lightweight route ledger for the pilot.",
    metric: "traceable ops",
    visual: "ledger",
  },
  {
    tag: "05",
    label: "Scale",
    title: "Add shops before warehouses",
    body: "Grow the mesh by adding more points and riders, then use density data to decide where a permanent hub actually earns its rent.",
    metric: "density first",
    visual: "mesh",
  },
];

const storySteps = [
  {
    tag: "01",
    label: "Code",
    title: "Drop at a nearby shop",
    body: "Staff writes a relative direction code on the parcel. It works without GPS, printers, or exact street addresses.",
  },
  {
    tag: "02",
    label: "Sort",
    title: "Sort by direction",
    body: "The shop only needs local direction bags. The bag stays sealed unless the next point must split the direction.",
  },
  {
    tag: "03",
    label: "Bid",
    title: "Bundle riders around real demand",
    body: "Riders bid on sealed bundles. A rider already moving in the same sector can get priority for the extra parcel.",
  },
  {
    tag: "04",
    label: "Audit",
    title: "Audit every handoff",
    body: "The customer quote stays fixed. Handoffs, handling fees, courier payout, and skip-hop bonuses are logged.",
  },
];

const modelRows = [
  ["No central hub", "Flat network, no single warehouse bottleneck"],
  ["Marker-first", "Works when printers, QR, or constant internet are not available"],
  ["Sealed bags", "Open only when the route code changes"],
  ["Courier market", "Dynamic job value, consolidation, and express upgrades"],
];

const pilotMetrics = [
  "Cost per parcel",
  "Time to first movement",
  "Bag fill rate",
  "Touches per parcel",
  "Lost parcel rate",
  "Margin by route",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="BebaRun is a low-capex courier network for Nairobi, built with local shops, independent riders, offline-ready parcel codes, and auditable route economics."
    />
    <title>BebaRun | Courier grid for Nairobi</title>
  </head>
  <body>
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>

    <main>
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="ambient-sheen" aria-hidden="true"></div>
        <nav class="topbar" aria-label="Primary navigation" data-topbar>
          <a class="brand magnetic" href="#top" aria-label="BebaRun home">
            <svg class="brand-mark" viewBox="0 0 96 96" aria-hidden="true">
              <path
                class="mark-bag"
                fill-rule="evenodd"
                d="M25 29h13v-3c0-5.5 4.5-10 10-10s10 4.5 10 10v3h13c5 0 9 4 9 9v28c0 5-4 9-9 9H25c-5 0-9-4-9-9V38c0-5 4-9 9-9Zm20 0h6v-3c0-1.7-1.3-3-3-3s-3 1.3-3 3v3Z"
              />
              <text class="mark-letter" x="48" y="52" text-anchor="middle" dominant-baseline="central">B</text>
            </svg>
            <span class="brand-wordmark">BebaRun</span>
          </a>

          <button
            class="nav-toggle"
            type="button"
            aria-label="Open navigation menu"
            aria-controls="topbar-menu"
            aria-expanded="false"
            data-nav-toggle
          >
            <Menu class="nav-toggle-icon nav-toggle-open" aria-hidden="true" />
            <X class="nav-toggle-icon nav-toggle-close" aria-hidden="true" />
          </button>

          <div class="topbar-menu" id="topbar-menu" data-nav-menu>
            <div class="nav-links">
              <a class="magnetic" href="#concept">Network</a>
              <a class="magnetic" href="#story">Flow</a>
              <a class="magnetic" href="#economics">Economics</a>
              <a class="magnetic" href="#pilot">Pilot</a>
            </div>
            <a class="topbar-cta magnetic" href="#lead">
              <span class="topbar-cta-full">Pilot deck</span>
              <span class="topbar-cta-short">Deck</span>
            </a>
          </div>
        </nav>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Low-capex delivery infrastructure for Nairobi</p>
            <h1 id="hero-title">
              <span class="hero-title-line">
                <span class="hero-title-word" data-hero-word>Shops</span>
                {" "}
                <span class="hero-title-word" data-hero-word>collect.</span>
              </span>
              <span class="hero-title-line">
                <span class="hero-title-word" data-hero-word>Riders</span>
                {" "}
                <span class="hero-title-word" data-hero-word>move.</span>
              </span>
            </h1>
            <p class="hero-lede">
              BebaRun turns local shops into parcel points and lets independent riders move sealed bags across Nairobi.
              Short marker codes, fixed customer quotes, and auditable route economics.
            </p>
            <div class="hero-actions" aria-label="Primary actions">
              <a class="button button-primary magnetic" href="#lead">Investor deck</a>
              <a class="button button-ghost magnetic" href="#story">See model</a>
            </div>
          </div>

          <aside class="route-lab is-booting" aria-label="Live courier network">
            <div class="lab-topline">
              <span>Live route system</span>
              <div class="lab-live-meta">
                <span class="lab-live-pill"><i aria-hidden="true"></i>Live</span>
                <strong><span data-lab-riders>0</span> riders</strong>
                <strong><span data-lab-delivered>0</span> ready</strong>
              </div>
            </div>

            <div class="lab-stage" data-lab-stage>
              <svg class="lab-road-layer" viewBox="0 0 1000 620" preserveAspectRatio="none" aria-hidden="true">
                <g class="mesh-roads"></g>
                <g class="mesh-flows"></g>
              </svg>

              <div class="network-point" data-node="P1" data-kind="shop" data-km-x="7.5" data-km-y="32.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P1</strong>
                <em>Grocery</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P2" data-kind="salon" data-km-x="2.5" data-km-y="12.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P2</strong>
                <em>Salon</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P3" data-kind="restaurant" data-km-x="12.5" data-km-y="42.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P3</strong>
                <em>Diner</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P4" data-kind="shop" data-km-x="17.5" data-km-y="7.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P4</strong>
                <em>Market</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P5" data-kind="shop" data-km-x="22.5" data-km-y="22.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P5</strong>
                <em>Mid hub</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P6" data-kind="pharmacy" data-km-x="24.5" data-km-y="4.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P6</strong>
                <em>Pharmacy</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P9" data-kind="shop" data-km-x="32.5" data-km-y="17.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P9</strong>
                <em>North shop</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P8" data-kind="shop" data-km-x="37.5" data-km-y="2.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P8</strong>
                <em>Kiosk</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P7" data-kind="shop" data-km-x="42.5" data-km-y="32.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P7</strong>
                <em>East shop</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P10" data-kind="clinic" data-km-x="7.5" data-km-y="22.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P10</strong>
                <em>Clinic</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P11" data-kind="hardware" data-km-x="17.5" data-km-y="32.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P11</strong>
                <em>Hardware</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P12" data-kind="bakery" data-km-x="27.5" data-km-y="37.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P12</strong>
                <em>Bakery</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P13" data-kind="shop" data-km-x="37.5" data-km-y="27.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P13</strong>
                <em>Bookshop</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="network-point" data-node="P14" data-kind="cafe" data-km-x="34.8" data-km-y="11.5">
                <span class="node-icon"><Store class="icon-svg" aria-hidden="true" /></span>
                <strong>P14</strong>
                <em>Cafe</em>
                <span class="node-bag" aria-hidden="true">
                  <ShoppingBag class="icon-svg" />
                  <strong data-node-count>0</strong>
                </span>
              </div>

              <div class="live-rider" data-live-rider="rider-1" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R1</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-2" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R2</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-3" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R3</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-4" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R4</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-5" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R5</span>
                <em>0</em>
              </div>

              <div class="live-rider" data-live-rider="rider-6" aria-hidden="true">
                <Bike class="icon-svg" />
                <span>R6</span>
                <em>0</em>
              </div>

              <div class="network-ledger" aria-hidden="true">
                <ReceiptText class="icon-svg" />
                <span>route state</span>
                <strong data-lab-ledger>idle</strong>
              </div>
            </div>

            <div class="lab-controls">
              <label class="demand-control">
                <span class="control-head">
                  <span>
                    <PackageIcon class="mini-icon" aria-hidden="true" />
                    Demand
                  </span>
                  <strong><span data-lab-demand-count>8</span></strong>
                </span>
                <span class="lab-range">
                  <input data-lab-demand type="range" min="2" max="18" value="8" />
                  <span class="lab-range-fill" aria-hidden="true"></span>
                  <span class="threshold-mark" aria-hidden="true">spawn rate</span>
                </span>
              </label>
              <label class="demand-control">
                <span class="control-head">
                  <span>
                    <Store class="mini-icon" aria-hidden="true" />
                    Shops
                  </span>
                  <strong><span data-lab-shop-count>8</span></strong>
                </span>
                <span class="lab-range">
                  <input data-lab-shops type="range" min="5" max="14" value="8" />
                  <span class="lab-range-fill shop-fill" aria-hidden="true"></span>
                  <span class="threshold-mark" aria-hidden="true">points online</span>
                </span>
              </label>
              <label class="demand-control">
                <span class="control-head">
                  <span>
                    <Bike class="mini-icon" aria-hidden="true" />
                    Riders
                  </span>
                  <strong><span data-lab-courier-count>1</span></strong>
                </span>
                <span class="lab-range">
                  <input data-lab-couriers type="range" min="1" max="6" value="1" />
                  <span class="lab-range-fill courier-fill" aria-hidden="true"></span>
                  <span class="threshold-mark" aria-hidden="true">dispatch pool</span>
                </span>
              </label>
              <button class="lab-run magnetic" type="button" data-lab-run aria-pressed="false">Run</button>
            </div>

            <div class="lab-readout" aria-live="polite">
              <div>
                <span>At points</span>
                <strong data-lab-route>0 in bags</strong>
              </div>
              <div>
                <span>En route</span>
                <strong data-lab-price>0 in bags</strong>
              </div>
              <div>
                <span>Ready</span>
                <em data-lab-action>0</em>
              </div>
            </div>
          </aside>
        </div>

        <div class="hero-strip" aria-label="Concept summary">
          <div><strong>0</strong><span>central warehouses</span></div>
          <div><strong>8</strong><span>directions per point</span></div>
          <div><strong>50 KES</strong><span>hub-fee logic</span></div>
          <div><strong>Offline</strong><span>marker and NFC ready</span></div>
        </div>
      </section>

      <section class="section concept concept-pin" id="concept" aria-labelledby="concept-title">
        <div class="concept-pin-inner">
          <div class="concept-copy reveal">
            <p class="eyebrow">Operating thesis</p>
            <h2 id="concept-title">Start with shops and riders, not a warehouse.</h2>
            <p>
              The pilot should prove the mesh in small, auditable moves: add points, sort sealed bags,
              dispatch riders, then scale only where density is real.
            </p>

            <div class="project-progress" aria-hidden="true">
              <div class="project-progress-head">
                <span data-project-current>01</span>
                <strong>Project stages</strong>
                <span>{projectStages.length.toString().padStart(2, "0")}</span>
              </div>
              <div class="project-progress-track">
                <i data-project-progress></i>
              </div>
              <div class="project-markers">
                {projectStages.map((stage, index) => (
                  <span class:list={[index === 0 && "is-active"]} data-project-marker={index}>
                    {stage.label}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="project-carousel reveal" aria-label="Project stages">
            <div class="project-card-track" data-project-track>
              {projectStages.map((stage, index) => (
                <article class:list={["project-stage-card", index === 0 && "is-active"]} data-project-stage={index}>
                  <div class:list={["project-stage-visual", `is-${stage.visual}`]} aria-hidden="true">
                    <span class="stage-icon-chip chip-a">
                      {stage.visual === "shops" && <MapPinned class="project-stage-lucide" />}
                      {stage.visual === "sort" && <ShoppingBag class="project-stage-lucide" />}
                      {stage.visual === "riders" && <Route class="project-stage-lucide" />}
                      {stage.visual === "ledger" && <ScanLine class="project-stage-lucide" />}
                      {stage.visual === "mesh" && <Waypoints class="project-stage-lucide" />}
                    </span>
                    <span class="stage-icon-main">
                      {stage.visual === "shops" && <Store class="project-stage-lucide" />}
                      {stage.visual === "sort" && <ListTree class="project-stage-lucide" />}
                      {stage.visual === "riders" && <Bike class="project-stage-lucide" />}
                      {stage.visual === "ledger" && <ClipboardCheck class="project-stage-lucide" />}
                      {stage.visual === "mesh" && <Network class="project-stage-lucide" />}
                    </span>
                    <span class="stage-icon-chip chip-b">
                      {stage.visual === "shops" && <ShoppingBag class="project-stage-lucide" />}
                      {stage.visual === "sort" && <ArrowRightLeft class="project-stage-lucide" />}
                      {stage.visual === "riders" && <ShoppingBag class="project-stage-lucide" />}
                      {stage.visual === "ledger" && <ReceiptText class="project-stage-lucide" />}
                      {stage.visual === "mesh" && <Store class="project-stage-lucide" />}
                    </span>
                    <span class="stage-icon-status">
                      {stage.visual === "ledger" ? <BadgeCheck class="project-stage-lucide" /> : <PackageIcon class="project-stage-lucide" />}
                    </span>
                  </div>
                  <div class="project-stage-body">
                    <span class="project-tag">{stage.tag}</span>
                    <p>{stage.label}</p>
                    <h3>{stage.title}</h3>
                    <div class="project-stage-line" aria-hidden="true"></div>
                    <p>{stage.body}</p>
                    <strong>{stage.metric}</strong>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="story-pin" id="story" aria-labelledby="story-title">
        <div class="story-pin-inner">
          <div class="story-stage">
            <div class="flow-device" aria-label="Operational parcel flow preview">
              <div class="flow-head">
                <span data-flow-head-label>Relative direction code</span>
                <strong data-flow-code>Code 4.4.5</strong>
              </div>

              <div class="flow-board" aria-hidden="true">
                <div class="flow-manifest">
                  <span data-flow-kicker>Direction code</span>
                  <strong data-flow-main>4.4.5</strong>
                  <em data-flow-sub>local hops, not a GPS address</em>
                  <div>
                    <small data-flow-detail-label>Meaning</small>
                    <b data-flow-detail>4 -> 4 -> 5: next local sectors written by marker</b>
                  </div>
                </div>

                <div class="flow-transfer" aria-hidden="true">
                  <div class="flow-transfer-head">
                    <span>Parcel state</span>
                    <strong data-flow-visual-title>Write local code</strong>
                  </div>

                  <div class="flow-fiche-stack">
                    <i class="flow-stack-sheet sheet-one"></i>
                    <i class="flow-stack-sheet sheet-two"></i>
                    <i class="flow-stack-sheet sheet-three"></i>
                    <div class="flow-parcel-card">
                      <span data-flow-visual-kicker>Shop counter</span>
                      <strong data-flow-packet-label>Code</strong>
                      <p data-flow-visual-note>Parcel gets a code before any route auction starts.</p>
                      <div class="flow-card-details">
                        <div>
                          <span>Direction</span>
                          <b data-flow-card-route>4.4.5 local sectors</b>
                        </div>
                        <div>
                          <span>Bundle</span>
                          <b data-flow-card-bundle>not sealed yet</b>
                        </div>
                        <div>
                          <span>Outcome</span>
                          <b data-flow-card-outcome>quote locked</b>
                        </div>
                      </div>
                      <div class="flow-seal-strip">
                        <div class="flow-seal-track">
                          <i></i>
                          <b>marker -> bag -> rider -> ledger</b>
                        </div>
                        <div class="flow-card-status">
                          <span class="flow-status-icon" aria-hidden="true">
                            <ScanLine class="flow-status-stage-icon is-code" />
                            <ShoppingBag class="flow-status-stage-icon is-bag" />
                            <Bike class="flow-status-stage-icon is-bid" />
                            <ReceiptText class="flow-status-stage-icon is-audit" />
                          </span>
                          <span class="flow-status-copy">
                            <small data-flow-status-label>Next check</small>
                            <strong data-flow-status-main>Code written</strong>
                            <em data-flow-status-note>ready for sort</em>
                          </span>
                          <span class="flow-status-steps" aria-hidden="true">
                            <i></i>
                            <i></i>
                            <i></i>
                            <i></i>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="flow-bid-panel">
                  <span data-flow-market-title>Rider market</span>
                  <div class="flow-decision-card">
                    <strong data-flow-decision-title>Waiting for a sealed bag</strong>
                    <em data-flow-decision-note>Once the code is written, the next shop can sort it without opening the parcel.</em>
