  .flow-manifest {
    position: absolute;
    top: clamp(18px, 2.5vw, 30px);
    left: clamp(18px, 2.5vw, 30px);
    z-index: 2;
    width: min(250px, 44%);
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 4px 0 4px 8px;
    backdrop-filter: none;
  }

  .flow-manifest span,
  .flow-bid-panel > span {
    display: block;
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .flow-manifest strong {
    display: block;
    margin-top: 10px;
    color: var(--black);
    font-size: clamp(2.1rem, 4vw, 3.3rem);
    font-weight: 950;
    line-height: 0.9;
  }

  .flow-manifest em {
    display: block;
    margin-top: 8px;
    color: rgba(35, 61, 77, 0.72);
    font-size: 0.82rem;
    font-style: normal;
    font-weight: 950;
  }

  .flow-manifest div {
    margin-top: 20px;
    border-top: 0;
    padding-top: 4px;
  }

  .flow-manifest small {
    display: block;
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .flow-manifest b {
    display: block;
    margin-top: 5px;
    font-size: 0.92rem;
    line-height: 1.22;
  }

  .flow-bid-panel {
    display: none;
  }

  .flow-transfer {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 24px 360px;
    gap: 18px;
    height: 410px;
    min-height: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
  }

  .flow-transfer::before {
    display: none;
  }

  .flow-transfer::after {
    display: none;
  }

  .flow-transfer-head {
    position: relative;
    z-index: 3;
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 24px;
    padding: 0;
  }

  .flow-transfer-head span,
  .flow-parcel-card span,
  .flow-checkpoint span {
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.66rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .flow-transfer-head strong {
    width: max-content;
    max-width: 60%;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.16);
    color: var(--black);
    padding: 7px 9px;
    font-size: 0.66rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .flow-fiche-stack {
    position: relative;
    z-index: 2;
    height: 360px;
    min-width: 0;
    isolation: isolate;
  }

  .flow-stack-sheet {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 22px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 249, 244, 0.94)),
      #fff;
    opacity: 0;
    box-shadow: inset 0 -5px 0 rgba(254, 127, 45, 0.12);
    transform-origin: center top;
    transition:
      opacity 80ms linear,
      transform 80ms linear;
  }

  .flow-stack-sheet.sheet-one {
    z-index: 3;
    opacity: var(--flow-sheet-one-opacity);
    transform: translate3d(0, var(--flow-sheet-one-y), 0) scaleX(var(--flow-sheet-one-scale)) rotate(var(--flow-sheet-one-rotate));
  }

  .flow-stack-sheet.sheet-two {
    z-index: 2;
    opacity: var(--flow-sheet-two-opacity);
    transform: translate3d(0, var(--flow-sheet-two-y), 0) scaleX(var(--flow-sheet-two-scale)) rotate(var(--flow-sheet-two-rotate));
  }

  .flow-stack-sheet.sheet-three {
    z-index: 1;
    opacity: var(--flow-sheet-three-opacity);
    transform: translate3d(0, var(--flow-sheet-three-y), 0) scaleX(var(--flow-sheet-three-scale)) rotate(var(--flow-sheet-three-rotate));
  }

  .flow-parcel-card {
    position: relative;
    z-index: 4;
    display: grid;
    min-width: 0;
    grid-template-rows: 14px 72px 48px 72px 52px;
    align-content: center;
    gap: 10px;
    height: 360px;
    min-height: 0;
    overflow: hidden;
    border: 0;
    border-radius: 22px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(251, 252, 253, 0.86)),
      rgba(255, 255, 255, 0.94);
    box-shadow:
      0 16px 34px rgba(35, 61, 77, 0.08),
      inset 0 0 0 1px rgba(255, 255, 255, 0.64);
    padding: clamp(18px, 3vw, 28px);
    transform: translate3d(0, var(--flow-card-drop), 0) rotateZ(var(--flow-card-rotate));
    transform-origin: center top;
    backface-visibility: hidden;
    transition: box-shadow 260ms ease;
    will-change: transform;
  }

  .flow-parcel-card > strong {
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--black);
    font-size: clamp(2.75rem, 5.4vw, 4.7rem);
    font-weight: 950;
    line-height: 0.86;
    letter-spacing: 0;
  }

  .flow-parcel-card p {
    display: -webkit-box;
    max-width: 360px;
    margin: 0;
    overflow: hidden;
    color: rgba(35, 61, 77, 0.68);
    font-size: clamp(0.94rem, 1.35vw, 1.08rem);
    font-weight: 800;
    line-height: 1.38;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .flow-card-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    height: 72px;
  }

  .flow-card-details div {
    position: relative;
    display: grid;
    align-content: center;
    gap: 7px;
    min-width: 0;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.74);
    padding: 10px 10px 10px 12px;
  }

  .flow-card-details div::before {
    position: absolute;
    top: 11px;
    bottom: 11px;
    left: 0;
    width: 3px;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.68);
    content: "";
  }

  .flow-card-details span {
    color: rgba(35, 61, 77, 0.56);
    font-size: 0.6rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .flow-card-details b {
    color: var(--black);
    font-size: 0.72rem;
    font-weight: 950;
    line-height: 1.08;
    overflow-wrap: anywhere;
    text-transform: uppercase;
  }

  .flow-seal-strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(146px, 0.4fr);
    align-items: end;
    gap: 12px;
    width: 100%;
    border-top: 0;
    padding-top: 0;
  }

  .flow-seal-track {
    display: grid;
    min-width: 0;
    gap: 8px;
  }

  .flow-seal-track i {
    display: block;
    width: clamp(42px, 10vw, 120px);
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.12);
  }

  .flow-seal-track i::before {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--orange);
    content: "";
    transform: scaleX(var(--flow-progress, 0.08));
    transform-origin: left center;
  }

  .flow-seal-track b {
    color: rgba(35, 61, 77, 0.6);
    font-size: 0.64rem;
    font-weight: 950;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .flow-card-status {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    grid-template-rows: auto 3px;
    column-gap: 8px;
    row-gap: 6px;
    min-height: 52px;
    min-width: 0;
    align-items: center;
    overflow: hidden;
    border-left: 2px solid rgba(254, 127, 45, 0.42);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.48);
    box-shadow: inset 0 0 0 1px rgba(35, 61, 77, 0.035);
    color: var(--black);
    padding: 8px 9px;
  }

  .flow-status-icon {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 10px;
    background: rgba(254, 127, 45, 0.08);
    color: rgba(35, 61, 77, 0.82);
  }

  .flow-status-stage-icon {
    display: none;
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .flow-board[data-flow-state="code"] .flow-status-stage-icon.is-code,
  .flow-board[data-flow-state="bag"] .flow-status-stage-icon.is-bag,
  .flow-board[data-flow-state="bid"] .flow-status-stage-icon.is-bid,
  .flow-board[data-flow-state="audit"] .flow-status-stage-icon.is-audit {
    display: block;
  }

  .flow-status-copy {
    display: grid;
    min-width: 0;
    gap: 3px;
  }

  .flow-status-copy small {
    color: rgba(35, 61, 77, 0.46);
    font-size: 0.5rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .flow-status-copy strong {
    overflow: hidden;
    color: var(--black);
    font-size: 0.7rem;
    font-weight: 930;
    line-height: 1;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .flow-status-copy em {
    overflow: hidden;
    color: rgba(35, 61, 77, 0.54);
    font-size: 0.52rem;
    font-style: normal;
    font-weight: 850;
    line-height: 1;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .flow-status-steps {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3px;
    height: 3px;
  }

  .flow-status-steps i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.08);
    opacity: 1;
    transform: scaleX(0.42);
    transform-origin: left center;
    transition:
      background 220ms ease,
      opacity 220ms ease,
      transform 220ms ease;
  }

  .flow-board[data-flow-state="code"] .flow-status-steps i:nth-child(-n + 1),
  .flow-board[data-flow-state="bag"] .flow-status-steps i:nth-child(-n + 2),
  .flow-board[data-flow-state="bid"] .flow-status-steps i:nth-child(-n + 3),
  .flow-board[data-flow-state="audit"] .flow-status-steps i:nth-child(-n + 4) {
    background: rgba(254, 127, 45, 0.56);
    opacity: 1;
    transform: scaleX(1);
  }

  .flow-stamp-rail {
    position: relative;
    z-index: 2;
    display: grid;
    min-width: 0;
    gap: 10px;
    align-content: center;
    padding-left: 8px;
    transition: transform 220ms ease;
  }

  .flow-stamp-rail::before,
  .flow-stamp-rail::after {
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 29px;
    width: 2px;
    border-radius: 999px;
    content: "";
  }

  .flow-stamp-rail::before {
    background: rgba(35, 61, 77, 0.1);
  }

  .flow-stamp-rail::after {
    bottom: auto;
    height: calc((100% - 48px) * var(--flow-progress, 0.08));
    background: var(--orange);
  }

  .flow-checkpoint {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 3px 10px;
    align-items: center;
    min-height: 64px;
    border: 0;
    border-radius: 16px;
    background: transparent;
    color: rgba(35, 61, 77, 0.52);
    padding: 10px;
    transition:
      background 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      transform 220ms ease;
  }

  .flow-checkpoint::before {
    position: absolute;
    inset: -4px;
    width: auto;
    height: auto;
    border: 1px solid rgba(254, 127, 45, 0);
    border-radius: 19px;
    content: "";
    opacity: 0;
    transform: scale(0.96);
  }

  .flow-checkpoint-icon {
    display: grid;
    grid-row: 1 / span 2;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 0;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.82);
    color: currentColor;
    padding: 10px;
    box-shadow: 0 12px 24px rgba(35, 61, 77, 0.08);
  }

  .flow-checkpoint span {
    align-self: end;
    line-height: 1;
  }

  .flow-checkpoint strong {
    align-self: start;
    border-radius: 0;
    background: transparent;
    padding: 0;
    color: currentColor;
    font-size: 0.74rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .flow-checkpoint.is-complete,
  .flow-checkpoint.is-active {
    color: var(--black);
  }

  .flow-checkpoint.is-complete {
    background: transparent;
  }

  .flow-checkpoint.is-complete .flow-checkpoint-icon {
    border-color: rgba(254, 127, 45, 0.22);
    background: rgba(254, 127, 45, 0.14);
  }

  .flow-checkpoint.is-active {
    background: rgba(255, 255, 255, 0.72);
    transform: translateX(2px);
  }

  .flow-checkpoint.is-active::before {
    border-color: rgba(254, 127, 45, 0.36);
    animation: none;
    opacity: 0;
  }

  .flow-checkpoint.is-active .flow-checkpoint-icon {
    border-color: rgba(254, 127, 45, 0.78);
    background: var(--orange);
    box-shadow: 0 18px 34px rgba(35, 61, 77, 0.14);
  }

  .flow-board.is-flow-switching .flow-parcel-card {
    animation: flowCardFiche 420ms cubic-bezier(0.2, 0.86, 0.22, 1) both;
  }

  @keyframes flowCardFiche {
    0% {
      opacity: 0.86;
      transform: translate3d(0, 28px, 0) scale(0.988) rotateZ(-0.38deg);
    }

    62% {
      opacity: 1;
      transform: translate3d(0, -4px, 0) scale(1.002) rotateZ(0.12deg);
    }

    100% {
      opacity: 1;
      transform: translate3d(0, var(--flow-card-drop), 0) rotateZ(var(--flow-card-rotate));
    }
  }

  .flow-bid-panel .flow-bid-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(50px, auto) minmax(0, 1fr) auto;
    gap: 9px;
    align-items: center;
    margin-top: 8px;
    min-height: 46px;
    border: 1px solid rgba(35, 61, 77, 0.11);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.66);
    padding: 8px 9px;
    color: var(--black);
    font-size: 0.7rem;
    transition:
      background 220ms ease,
      border-color 220ms ease,
      transform 220ms ease;
  }

  .flow-bid-panel .flow-bid-row::before {
    position: absolute;
    top: 50%;
    left: -1px;
    width: 3px;
    height: 24px;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.16);
    content: "";
    transform: translateY(-50%);
  }

  .flow-bid-panel strong {
    font-weight: 950;
  }

  .flow-bid-panel em {
    justify-self: start;
    color: rgba(35, 61, 77, 0.68);
    font-style: normal;
    line-height: 1.25;
    overflow-wrap: anywhere;
    text-align: left;
  }

  .flow-bid-panel small {
    justify-self: end;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.08);
    color: rgba(35, 61, 77, 0.72);
    padding: 4px 7px;
    font-size: 0.56rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .flow-bid-row.is-selected {
    border-color: rgba(254, 127, 45, 0.24);
    background: rgba(255, 255, 255, 0.88);
  }

  .flow-bid-row.is-selected::before {
    background: var(--orange);
    box-shadow: none;
  }

  .flow-bid-row.is-selected small {
    background: rgba(254, 127, 45, 0.16);
    color: var(--black);
  }

  .flow-board {
    grid-template-columns: minmax(0, 1fr) minmax(248px, 0.46fr);
    grid-template-rows: minmax(410px, 1fr);
    gap: clamp(18px, 2.4vw, 28px);
  }

  .flow-manifest,
  .flow-bid-panel {
    position: relative;
    inset: auto;
    min-height: 410px;
    width: auto;
  }

  .flow-manifest {
    grid-column: 2;
    grid-row: 1;
  }

  .flow-transfer {
    grid-column: 1;
    grid-row: 1;
  }

  .flow-bid-panel {
    grid-column: 2;
    grid-row: 1;
  }

  .flow-decision-card {
    display: grid;
    gap: 9px;
    margin-top: 12px;
    min-height: 122px;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.72);
    padding: 13px;
  }

  .flow-decision-card strong {
    color: var(--black);
    font-size: 0.9rem;
    line-height: 1.12;
  }

  .flow-decision-card em {
    color: rgba(35, 61, 77, 0.68);
    font-size: 0.72rem;
    font-style: normal;
    line-height: 1.25;
  }

  .flow-decision-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .flow-decision-tags span {
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.06);
    color: var(--navy);
    padding: 5px 7px;
    font-size: 0.56rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .flow-decision-tags span:first-child {
    border-color: rgba(254, 127, 45, 0.24);
    background: rgba(254, 127, 45, 0.14);
    color: var(--black);
  }

  .flow-device.is-panel-refreshing .flow-head span,
  .flow-device.is-panel-refreshing .flow-head strong,
  .flow-board.is-panel-refreshing .flow-manifest span,
  .flow-board.is-panel-refreshing .flow-manifest strong,
  .flow-board.is-panel-refreshing .flow-manifest em,
  .flow-board.is-panel-refreshing .flow-manifest small,
  .flow-board.is-panel-refreshing .flow-manifest b,
  .flow-board.is-panel-refreshing .flow-decision-card strong,
  .flow-board.is-panel-refreshing .flow-decision-card em,
  .flow-board.is-panel-refreshing .flow-decision-tags span,
  .flow-board.is-panel-refreshing .flow-parcel-card > span,
  .flow-board.is-panel-refreshing .flow-parcel-card > strong,
  .flow-board.is-panel-refreshing .flow-parcel-card p,
  .flow-board.is-panel-refreshing .flow-seal-strip {
    animation: flowTextRefresh 360ms cubic-bezier(0.33, 1, 0.68, 1) both;
  }

  .flow-device.is-panel-refreshing .flow-head strong,
  .flow-board.is-panel-refreshing .flow-manifest strong,
  .flow-board.is-panel-refreshing .flow-decision-card em {
    animation-delay: 34ms;
  }

  .flow-board.is-panel-refreshing .flow-manifest b,
  .flow-board.is-panel-refreshing .flow-decision-tags span {
    animation-delay: 56ms;
  }

  .flow-board.is-panel-refreshing .flow-parcel-card > strong {
    animation-delay: 42ms;
  }

  .flow-board.is-panel-refreshing .flow-parcel-card p {
    animation-delay: 78ms;
  }

  .flow-board.is-panel-refreshing .flow-seal-strip {
    animation-delay: 108ms;
  }

  .flow-board.is-panel-refreshing .flow-decision-card {
    animation: flowPanelRefresh 430ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-board.is-panel-refreshing .flow-bid-row {
    animation: flowRowRefresh 390ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-board.is-panel-refreshing .flow-checkpoint.is-active {
    animation: flowRowRefresh 390ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-board.is-panel-refreshing .flow-bid-row:nth-of-type(2) {
    animation-delay: 44ms;
  }

  .flow-board.is-panel-refreshing .flow-bid-row:nth-of-type(3) {
    animation-delay: 82ms;
  }

  .flow-board.is-panel-refreshing .flow-bid-row:nth-of-type(4) {
    animation-delay: 120ms;
  }

  .flow-board.is-panel-refreshing .flow-bid-row.is-selected::before {
    animation: flowSelectedBar 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-device.is-panel-refreshing .flow-action.is-active {
    animation: flowActionLift 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-actions {
    display: none;
  }

  .flow-action {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 4px 10px;
    justify-items: center;
    align-items: center;
    min-height: 76px;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.62);
    color: rgba(35, 61, 77, 0.62);
    padding: 10px;
    transition:
      background 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease;
  }

  .flow-action::after {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 24px;
    content: "";
    opacity: 0;
    pointer-events: none;
    transform: scale(0.82);
  }

  .flow-action .flow-icon {
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 40px;
    height: 40px;
    align-self: center;
    border: 1px solid rgba(254, 127, 45, 0.22);
    border-radius: 13px;
    background: rgba(254, 127, 45, 0.16);
    color: var(--black);
    padding: 10px;
    box-shadow: none;
  }

  .flow-action strong {
    justify-self: start;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .flow-popover {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    grid-column: 2;
    grid-row: 2;
    justify-self: start;
    align-self: start;
    min-width: 72px;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: rgba(35, 61, 77, 0.58);
    padding: 0;
    font-size: 0.56rem;
    font-weight: 900;
    line-height: 1.1;
    text-align: center;
    opacity: 1;
    transform: none;
