    position: absolute;
    z-index: 7;
    top: var(--y, 50%);
    left: var(--x, 50%);
    display: grid;
    grid-template-columns: 20px auto auto;
    gap: 4px;
    align-items: center;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    opacity: 0;
    padding: 4px 7px 4px 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.56rem;
    font-weight: 950;
    pointer-events: none;
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.18);
    transform: translate(-50%, -50%);
    transition:
      opacity 160ms ease,
      top 90ms linear,
      left 90ms linear;
