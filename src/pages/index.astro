      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .audit-ledger-grid div + div {
      border-left: 0;
    }

    .audit-ledger-grid div:nth-child(even) {
      border-left: 1px solid rgba(35, 61, 77, 0.1);
    }

    .audit-ledger-grid div:nth-child(n + 3) {
