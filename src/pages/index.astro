  .route-lab.is-express.is-running .moving-rider,
  .route-lab.is-skip.is-running .moving-rider {
    animation-name: riderNetworkMove;
  }

  .route-lab.is-held .moving-rider {
    opacity: 0;
    animation: none;
  }

  .route-lab.is-complete [data-lab-node="CC"] .node-icon {
    background: var(--orange);
    color: var(--black);
  }

  .route-lab.is-outtake [data-lab-node="CC"] .node-icon {
    background: var(--black);
    color: var(--white);
  }

  .route-lab.is-ledger .network-ledger {
    border-color: rgba(254, 127, 45, 0.38);
    background: rgba(254, 127, 45, 0.13);
  }

  @keyframes riderNetworkMove {
    0% {
      top: var(--rider-start-y, 64%);
      left: var(--rider-start-x, 17%);
    }

    52% {
      top: var(--rider-mid-y, 50%);
      left: var(--rider-mid-x, 50%);
    }

    100% {
      top: var(--rider-end-y, 28%);
      left: var(--rider-end-x, 83%);
    }
  }

  .network-ledger {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 4;
    display: grid;
    grid-template-columns: 18px auto;
    gap: 3px 6px;
    align-items: center;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.82);
    color: var(--navy);
    padding: 7px 9px;
    box-shadow: 0 12px 30px rgba(35, 61, 77, 0.08);
  }

  .route-lab .network-ledger {
    display: none;
  }

  .mesh-event {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 6;
    max-width: min(330px, calc(100% - 24px));
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    color: var(--navy);
    padding: 7px 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.6rem;
    font-weight: 900;
    line-height: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    box-shadow: 0 10px 24px rgba(35, 61, 77, 0.08);
  }

  .network-ledger span {
    color: rgba(35, 61, 77, 0.56);
    font-size: 0.56rem;
    font-weight: 850;
    line-height: 1;
  }

  .network-ledger strong {
    grid-column: 2;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.66rem;
    line-height: 1;
  }

  .lab-controls {
    display: grid;
    grid-template-columns: 0.82fr 0.9fr minmax(190px, 1.08fr) auto;
    gap: 8px;
    align-items: end;
    margin-top: 10px;
  }

  .lab-control,
  .demand-control {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .lab-control,
  .lab-controls .demand-control {
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.54);
    padding: 7px;
  }

  .lab-control > span,
  .control-head {
    color: rgba(35, 61, 77, 0.64);
    font-size: 0.68rem;
    font-weight: 850;
    line-height: 1;
  }

  .control-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .control-head > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .control-head strong {
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.12);
    color: var(--black);
    padding: 3px 7px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.62rem;
    line-height: 1;
    white-space: nowrap;
  }

  .lab-choice-group {
    min-height: 36px;
    border: 0;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.52);
    padding: 3px;
  }

  .lab-choice-group::before {
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc((100% - 6px) / var(--choice-count));
    border-radius: 9px;
    box-shadow: none;
  }

  .lab-choice-group button {
    min-width: 0;
    border-radius: 9px;
    color: rgba(35, 61, 77, 0.68);
    padding: 0 7px;
    font-size: 0.68rem;
    font-weight: 850;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lab-choice-group button.is-selected {
    color: var(--white);
  }

  .lab-range {
    --range-input-pad: 10px;
    --range-line-pad: 18px;
    position: relative;
    display: block;
    height: 30px;
    overflow: hidden;
    border-radius: 999px;
    background: transparent;
    box-shadow: none;
  }

  .lab-range::before {
    position: absolute;
    top: 50%;
    right: var(--range-line-pad);
    left: var(--range-line-pad);
    height: 5px;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.13);
    content: "";
    transform: translateY(-50%);
  }

  .lab-range-fill {
    position: absolute;
    top: 50%;
    bottom: auto;
    left: var(--range-line-pad);
    width: calc(100% - 36px);
    height: 5px;
    border-radius: 999px;
    background: var(--orange);
    transform: translateY(-50%) scaleX(clamp(0, var(--demand-level, 0.38), 1));
    transform-origin: left center;
    transition: transform 160ms ease;
  }

  .lab-range-fill.shop-fill {
    transform: translateY(-50%) scaleX(clamp(0, var(--shop-level, 0.5), 1));
  }

  .lab-range-fill.courier-fill {
    transform: translateY(-50%) scaleX(clamp(0, var(--courier-level, 0), 1));
  }

  .threshold-mark {
    position: absolute;
    top: -2px;
    left: 50%;
    color: rgba(35, 61, 77, 0.52);
    font-size: 0.5rem;
    font-weight: 850;
    line-height: 1;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .threshold-mark::after {
    display: block;
    width: 1px;
    height: 18px;
    margin: 3px auto 0;
    background: rgba(35, 61, 77, 0.22);
    content: "";
  }

  .lab-controls input {
    position: relative;
    z-index: 2;
    width: calc(100% - 20px);
    min-height: 28px;
    margin: 0 var(--range-input-pad);
    border: 0;
    background: transparent;
    appearance: none;
    outline: none;
    padding: 0;
  }

  .lab-controls input::-webkit-slider-runnable-track {
    height: 28px;
    background: transparent;
  }

  .lab-controls input::-webkit-slider-thumb {
    width: 16px;
    height: 16px;
    margin-top: 6px;
    border: 3px solid var(--white);
    border-radius: 50%;
    appearance: none;
    background: var(--black);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.2);
  }

  .lab-controls input::-moz-range-track {
    height: 28px;
    background: transparent;
  }

  .lab-controls input::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 3px solid var(--white);
    border-radius: 50%;
    background: var(--black);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.2);
  }

  .lab-run {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 0;
    border-radius: 12px;
    background: var(--black);
    color: var(--white);
    padding: 0 13px;
    font-size: 0.76rem;
    font-weight: 850;
    white-space: nowrap;
  }

  .lab-readout {
    display: grid;
    grid-template-columns: 1.15fr 0.82fr 1.2fr;
    gap: 8px;
    align-items: stretch;
    margin-top: 10px;
    color: var(--navy);
  }

  .lab-readout div {
    min-width: 0;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.5);
    padding: 9px;
  }

  .lab-readout span,
  .lab-readout strong,
  .lab-readout em {
    min-width: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
    overflow-wrap: anywhere;
  }

  .lab-readout span {
    display: block;
    margin-bottom: 4px;
    color: rgba(35, 61, 77, 0.54);
    font-size: 0.54rem;
    font-weight: 850;
    line-height: 1;
    text-transform: uppercase;
  }

  .lab-readout strong,
  .lab-readout em {
    display: block;
    color: var(--black);
    font-size: 0.74rem;
    font-style: normal;
    font-weight: 850;
    line-height: 1.18;
  }

  @media (max-width: 1180px) {
    .hero-grid {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .hero-copy {
      justify-self: center;
      max-width: min(860px, 100%);
      text-align: center;
    }

    .hero-copy h1,
    .hero-lede {
      margin-right: auto;
      margin-left: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .route-lab {
      width: min(100%, 860px);
      justify-self: center;
      margin-inline: auto;
    }
  }

  @media (max-width: 760px) {
    .hero {
      width: calc(100% - 8px);
    }

    .hero-grid {
      justify-items: stretch;
    }

    .hero-copy {
      max-width: min(100%, 360px);
    }

    .hero-copy > .eyebrow {
      max-width: 31ch;
      margin-right: auto;
      margin-left: auto;
      line-height: 1.15;
      white-space: normal;
    }

    .hero-copy h1 {
      max-width: 100%;
      font-size: clamp(2rem, 8.6vw, 2.42rem);
      line-height: 0.94;
    }

    .hero-title-line {
      overflow: visible;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: min(100%, 300px);
      margin-right: auto;
      margin-left: auto;
    }

    .hero-actions .button {
      width: auto;
      min-width: 0;
    }

    .route-lab {
      width: 100%;
      max-width: none;
      justify-self: center;
      border-radius: 20px;
      padding: 10px;
    }

    .route-system-section {
      width: calc(100% - 16px);
      padding-block: 64px;
    }

    .route-system-heading {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 18px;
    }

    .route-system-heading > p {
      justify-self: start;
      max-width: 100%;
      font-size: 0.92rem;
    }

    .route-system-section .lab-stage {
      min-height: 300px;
    }

    .lab-topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
    }

    .lab-stage {
      aspect-ratio: 1.24;
      border-radius: 16px;
      background-size: 34px 34px, 34px 34px, auto;
    }

    .road-line {
      stroke-width: 4.2;
    }

    .road-main {
      stroke-width: 6;
    }

    .route-path {
      stroke-width: 5.5;
    }

    .route-corridor-base path {
      stroke-width: 6;
    }

    .route-segment {
      stroke-width: 5.5;
    }

    .network-point {
      grid-template-columns: 22px auto;
      gap: 4px;
      padding: 3px 6px 3px 3px;
    }

    .network-point .node-icon {
      width: 22px;
      height: 22px;
      border-radius: 7px;
    }

    .network-point .icon-svg {
      width: 14px;
      height: 14px;
    }

    .network-point strong {
      font-size: 0.58rem;
    }

    .network-point em {
      max-width: 70px;
      font-size: 0.48rem;
    }

    .point-aa {
      top: 66%;
      left: 18%;
    }

    .point-ab {
      top: 35%;
      left: 18%;
    }

    .point-ba {
      top: 76%;
      left: 38%;
    }

    .point-bag {
      top: 51%;
      left: 52%;
    }

    .point-relay {
      top: 58%;
      left: 74%;
    }

    .point-cc {
      top: 28%;
      left: 82%;
    }

    .parcel-cluster {
      grid-template-columns: repeat(3, 12px) auto;
      gap: 3px;
    }

    .delivery-stack {
      top: 40%;
      left: 82%;
      grid-template-columns: repeat(3, 10px) auto;
      gap: 3px;
    }

    .package-icon {
      width: 12px;
      height: 12px;
      border-radius: 4px;
    }

    .package-icon .icon-svg {
      width: 9px;
      height: 9px;
    }

    .parcel-cluster strong,
    .delivery-stack strong {
      min-width: 22px;
      height: 16px;
      font-size: 0.56rem;
    }

    .network-ledger {
      right: 8px;
      bottom: 8px;
      padding: 6px 7px;
    }

    .network-ledger span {
      display: none;
    }

    .network-ledger strong {
      grid-column: auto;
      font-size: 0.56rem;
    }

    .moving-rider {
      grid-template-columns: 18px auto;
      gap: 4px;
      padding: 3px 6px 3px 3px;
      font-size: 0.5rem;
    }

    .moving-rider .icon-svg {
      width: 17px;
      height: 17px;
    }

    .live-rider {
      grid-template-columns: 15px auto;
      gap: 3px;
      padding: 3px 5px 3px 3px;
      font-size: 0.48rem;
    }

    .live-rider span {
      display: none;
    }

    .live-rider .icon-svg {
      width: 14px;
      height: 14px;
    }

    .live-rider em {
      min-width: 15px;
      height: 15px;
      font-size: 0.46rem;
    }

    .mesh-event {
      top: 8px;
      left: 8px;
      max-width: calc(100% - 16px);
      padding: 6px 8px;
      font-size: 0.5rem;
    }

    .lab-controls {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .lab-control {
      grid-column: 1 / -1;
    }

    .lab-controls .demand-control {
      grid-column: 1 / -1;
    }

    .lab-run {
      grid-column: 1 / -1;
      width: 100%;
      min-height: 38px;
    }

    .lab-readout {
      grid-template-columns: 1fr;
      gap: 7px;
    }

    .lab-readout div {
      padding: 8px;
    }

    .lab-readout strong,
    .lab-readout em {
      font-size: 0.68rem;
    }
  }
  /* Final pinned navigation */
  .hero {
    height: auto;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: clamp(98px, 7vw, 112px);
  }

  @supports (height: 100dvh) {
    .hero {
      min-height: 100dvh;
    }
  }

  .hero-visual {
    position: relative;
    isolation: isolate;
    justify-self: end;
    width: min(100%, 600px);
    aspect-ratio: 928 / 1096;
    min-height: 0;
  }

  .hero .hero-strip {
    display: none;
  }

  .hero-person-frame {
    position: absolute;
    top: 30%;
    left: 27%;
    z-index: 1;
    display: block;
    width: 43%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--orange);
    box-shadow:
      0 32px 72px rgba(254, 127, 45, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
  }

  .hero-person-frame::after {
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: calc(var(--radius) - 2px);
    content: "";
    pointer-events: none;
  }

  .hero-people {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
    filter: drop-shadow(0 24px 30px rgba(35, 61, 77, 0.22));
  }

  .topbar {
    --nav-progress: 0;
    position: fixed;
    top: 16px;
    right: 16px;
    left: 16px;
    z-index: 90;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    width: min(1160px, calc(100% - 32px));
    height: 66px;
    margin: 0 auto;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow:
      0 18px 54px rgba(35, 61, 77, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    gap: 24px;
    padding: 9px 11px 9px 18px;
    overflow: visible;
    backdrop-filter: blur(22px) saturate(1.1);
    isolation: isolate;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .topbar::after {
    position: absolute;
    right: 18px;
    bottom: -1px;
    left: 18px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(254, 127, 45, 0.96), rgba(255, 209, 102, 0.88));
    content: "";
    opacity: 0;
    pointer-events: none;
    transform: scaleX(var(--nav-progress));
    transform-origin: left center;
    transition: opacity 180ms ease;
  }

  .topbar.is-scrolled {
    border-color: rgba(35, 61, 77, 0.15);
    background: rgba(255, 255, 255, 0.7);
    box-shadow:
      0 16px 46px rgba(35, 61, 77, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(26px) saturate(1.14);
  }

  .topbar.is-scrolled::after {
    opacity: 0.9;
  }

  .topbar .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    height: 48px;
    min-height: 0;
    min-width: 0;
    gap: 10px;
    padding: 0;
    color: var(--black);
    text-decoration: none;
  }

  .topbar .brand-mark {
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    align-self: center;
    object-fit: contain;
    flex-shrink: 0;
    transform: none;
  }

  .topbar .mark-letter {
    font-size: 24px;
    transform: none;
  }

  .topbar .brand-wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    align-self: center;
    color: var(--black);
    font-size: 1.28rem;
    font-weight: 950;
    line-height: 1;
    letter-spacing: 0;
    transform: none;
    white-space: nowrap;
  }

  .topbar-menu {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    gap: 22px;
    transition: gap 220ms ease;
  }

  .topbar .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    height: auto;
    min-width: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
    backdrop-filter: none;
    max-width: 360px;
    overflow: hidden;
    opacity: 1;
    visibility: visible;
    transition:
      max-width 220ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 150ms ease,
      visibility 150ms ease;
  }

  .topbar .nav-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    border-radius: 8px;
    padding: 0 13px;
    color: rgba(35, 61, 77, 0.76);
    font-size: 0.83rem;
    font-weight: 760;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .nav-link-icon {
    display: none;
  }

  .topbar .nav-links a::after {
    position: absolute;
    right: 13px;
    bottom: 8px;
    left: 13px;
    height: 2px;
    border-radius: 999px;
    background: var(--orange);
    content: "";
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .topbar .nav-links a:hover,
  .topbar .nav-links a:focus-visible {
    background: rgba(35, 61, 77, 0.055);
    color: var(--black);
  }

  .topbar .nav-links a.is-active {
    color: var(--black);
  }

  .topbar .nav-links a.is-active::after {
    opacity: 1;
  }

  .topbar-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    border: 1px solid #0f1317 !important;
    border-radius: 8px;
    background: #0f1317 !important;
    color: var(--white) !important;
    padding: 0 17px;
    box-shadow:
      0 10px 24px rgba(16, 20, 24, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    font-size: 0.82rem;
    font-weight: 880;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .topbar-cta:hover,
  .topbar-cta:focus-visible {
    border-color: #1d252c !important;
    background: #1d252c !important;
    box-shadow:
      0 12px 28px rgba(16, 20, 24, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .topbar-cta-short {
    display: none;
  }

  .nav-toggle {
    display: none;
  }

  .topbar .brand:focus-visible,
  .topbar .nav-links a:focus-visible,
  .topbar-cta:focus-visible,
  .nav-toggle:focus-visible {
    outline: 2px solid rgba(254, 127, 45, 0.72);
    outline-offset: 3px;
  }

  @media (max-width: 1180px) {
    .hero-visual {
      justify-self: center;
      width: min(100%, 620px);
      margin-top: -12px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 92px;
    }

    .cursor-dot,
    .cursor-ring {
      display: none !important;
    }

    .topbar {
