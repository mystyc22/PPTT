    border-color: rgba(254, 127, 45, 0.24);
    background: rgba(254, 127, 45, 0.14);
    color: var(--black);
  }

  .flow-device.is-panel-refreshing .flow-head span,
  .flow-device.is-panel-refreshing .flow-head strong,
  .flow-board.is-panel-refreshing .flow-manifest span,
  .flow-board.is-panel-refreshing .flow-manifest strong,
  .flow-board.is-panel-refreshing .flow-manifest em,
  .flow-board.is-panel-refreshing .flow-manifest small,
  .flow-board.is-panel-refreshing .flow-manifest b,
  .flow-board.is-panel-refreshing .flow-decision-card strong,
  .flow-board.is-panel-refreshing .flow-decision-card em,
  .flow-board.is-panel-refreshing .flow-decision-tags span,
  .flow-board.is-panel-refreshing .flow-parcel-card > span,
  .flow-board.is-panel-refreshing .flow-parcel-card > strong,
  .flow-board.is-panel-refreshing .flow-parcel-card p,
  .flow-board.is-panel-refreshing .flow-seal-strip {
    animation: flowTextRefresh 360ms cubic-bezier(0.33, 1, 0.68, 1) both;
  }

  .flow-device.is-panel-refreshing .flow-head strong,
  .flow-board.is-panel-refreshing .flow-manifest strong,
  .flow-board.is-panel-refreshing .flow-decision-card em {
    animation-delay: 34ms;
  }

  .flow-board.is-panel-refreshing .flow-manifest b,
  .flow-board.is-panel-refreshing .flow-decision-tags span {
    animation-delay: 56ms;
  }

  .flow-board.is-panel-refreshing .flow-parcel-card > strong {
    animation-delay: 42ms;
  }

  .flow-board.is-panel-refreshing .flow-parcel-card p {
    animation-delay: 78ms;
  }

  .flow-board.is-panel-refreshing .flow-seal-strip {
    animation-delay: 108ms;
  }

  .flow-board.is-panel-refreshing .flow-decision-card {
    animation: flowPanelRefresh 430ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-board.is-panel-refreshing .flow-bid-row {
    animation: flowRowRefresh 390ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-board.is-panel-refreshing .flow-checkpoint.is-active {
    animation: flowRowRefresh 390ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-board.is-panel-refreshing .flow-bid-row:nth-of-type(2) {
    animation-delay: 44ms;
  }

  .flow-board.is-panel-refreshing .flow-bid-row:nth-of-type(3) {
    animation-delay: 82ms;
  }

  .flow-board.is-panel-refreshing .flow-bid-row:nth-of-type(4) {
    animation-delay: 120ms;
  }

  .flow-board.is-panel-refreshing .flow-bid-row.is-selected::before {
    animation: flowSelectedBar 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-device.is-panel-refreshing .flow-action.is-active {
    animation: flowActionLift 460ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .flow-actions {
    display: none;
  }

  .flow-action {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 4px 10px;
    justify-items: center;
    align-items: center;
    min-height: 76px;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.62);
    color: rgba(35, 61, 77, 0.62);
    padding: 10px;
    transition:
      background 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease;
  }

  .flow-action::after {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 24px;
    content: "";
    opacity: 0;
    pointer-events: none;
    transform: scale(0.82);
  }

  .flow-action .flow-icon {
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 40px;
    height: 40px;
    align-self: center;
    border: 1px solid rgba(254, 127, 45, 0.22);
    border-radius: 13px;
    background: rgba(254, 127, 45, 0.16);
    color: var(--black);
    padding: 10px;
    box-shadow: none;
  }

  .flow-action strong {
    justify-self: start;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .flow-popover {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    grid-column: 2;
    grid-row: 2;
    justify-self: start;
    align-self: start;
    min-width: 72px;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: rgba(35, 61, 77, 0.58);
    padding: 0;
    font-size: 0.56rem;
    font-weight: 900;
    line-height: 1.1;
    text-align: center;
    opacity: 1;
    transform: none;
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .flow-action.is-active {
    border-color: rgba(254, 127, 45, 0.34);
    background: rgba(255, 255, 255, 0.9);
    color: var(--black);
    box-shadow: 0 14px 30px rgba(35, 61, 77, 0.08);
  }

  .flow-action.is-active .flow-icon {
    border-color: rgba(254, 127, 45, 0.72);
    background: var(--orange);
    color: var(--black);
    box-shadow: none;
    animation: flowIconPop 360ms ease both;
  }

  .flow-action.is-active::after {
    animation: none;
  }

  .flow-action.is-active .flow-popover {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @keyframes flowIconPop {
    0% {
      transform: translateY(4px) scale(0.94);
    }

    55% {
      transform: translateY(-2px) scale(1.03);
    }

    100% {
      transform: translateY(0) scale(1);
    }
  }

  @keyframes flowActionRing {
    0% {
      opacity: 0.48;
      transform: scale(0.82);
    }

    100% {
      opacity: 0;
      transform: scale(1.22);
    }
  }

  @keyframes flowCheckpointPing {
    0% {
      opacity: 0.7;
      transform: scale(0.96);
    }

    100% {
      opacity: 0;
      transform: scale(1.08);
    }
  }

  @keyframes flowPanelRefresh {
    0% {
      opacity: 0.86;
      transform: translate3d(0, 4px, 0) scale(0.995);
    }

    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes flowTextRefresh {
    0% {
      opacity: 0;
      filter: blur(2px);
      transform: translate3d(0, 4px, 0);
    }

    62% {
      opacity: 1;
      filter: blur(0);
    }

    100% {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes flowRowRefresh {
    0% {
      opacity: 0;
      transform: translate3d(0, 4px, 0) scale(0.99);
    }

    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes flowSelectedBar {
    0% {
      height: 8px;
      opacity: 0;
    }

    55% {
      height: 28px;
      opacity: 1;
    }

    100% {
      height: 24px;
      opacity: 1;
    }
  }

  @keyframes flowActionLift {
    0% {
      transform: translateY(7px) scale(0.985);
    }

    100% {
      transform: translateY(0) scale(1);
    }
  }

  .flow-step-stack {
    display: none;
  }

  .flow-ledger {
    grid-row: 3;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .flow-ledger div {
    min-height: 72px;
    border: 0;
    background: transparent;
    padding: 14px 0 0;
  }

  .flow-ledger div + div {
    border-left: 0;
  }

  @media (min-width: 901px) {
    .story-pin {
      padding: 0;
    }
  }

  @media (max-width: 1080px) {
    .story-pin-inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .story-copy {
      order: -1;
      justify-self: center;
      max-width: 760px;
      text-align: center;
    }

    .story-stage {
      min-height: auto;
    }

    .flow-device {
      position: relative;
      inset: auto;
      grid-template-rows: auto minmax(360px, auto) auto auto;
    }

    .flow-board {
      grid-template-columns: minmax(0, 1fr) minmax(230px, 0.42fr);
      min-height: auto;
    }
  }

  @media (max-width: 760px) {
    .story-pin {
      width: min(100% - 28px, 1460px);
      min-height: max(360svh, 2400px);
      padding: 0;
    }

    .story-pin-inner {
      position: sticky;
      top: 0;
      display: grid;
      align-content: start;
      gap: clamp(12px, 2.6vh, 20px);
      min-height: 100svh;
      padding-block: clamp(88px, 11vh, 104px) 14px;
    }

    @supports (min-height: 100dvh) {
      .story-pin-inner {
        min-height: 100dvh;
      }
    }

    .story-copy {
      order: -1;
      text-align: center;
    }

    .story-copy h2 {
      font-size: clamp(1.9rem, 8.2vw, 2.7rem);
      line-height: 0.94;
    }

    .story-stage {
      display: block;
      min-height: auto;
      overflow: visible;
    }

    .flow-device {
      grid-template-rows: auto minmax(0, 1fr);
      gap: 8px;
      overflow: visible;
      padding: 0;
    }

    .flow-head {
      min-height: auto;
      gap: 10px;
      padding: 0 2px;
      font-size: 0.66rem;
    }

    .flow-head strong {
      padding: 7px 9px;
    }

    .flow-board {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr);
      gap: 0;
      height: clamp(330px, 46vh, 390px);
      min-height: auto;
      overflow: visible;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      padding: 0;
    }

    .flow-manifest,
    .flow-bid-panel {
      position: relative;
      grid-column: 1;
      min-height: auto;
      top: auto;
      right: auto;
      left: auto;
      width: 100%;
    }

    .flow-transfer {
      grid-column: 1;
      grid-row: 1;
      grid-template-columns: 1fr;
      grid-template-rows: 26px minmax(0, 1fr);
      gap: 8px;
      height: 100%;
      min-height: auto;
      overflow: visible;
    }

    .flow-transfer::before {
      display: none;
    }

    .flow-transfer::after {
      display: none;
    }

    .flow-transfer-head {
      align-items: center;
      display: flex;
      gap: 8px;
      height: 26px;
    }

    .flow-transfer-head strong {
      max-width: 100%;
      justify-self: start;
    }

    .flow-checkpoint {
      grid-template-columns: 1fr;
      grid-template-rows: 34px auto;
      min-height: 58px;
      justify-items: center;
      gap: 5px;
      padding: 4px 2px;
      text-align: center;
    }

    .flow-checkpoint-icon {
      width: 36px;
      height: 36px;
      border-radius: 13px;
      padding: 9px;
    }

    .flow-checkpoint span {
      display: none;
    }

    .flow-checkpoint strong {
      font-size: 0.58rem;
      line-height: 1;
    }

    .flow-checkpoint.is-active {
      background: transparent;
      transform: translateY(-2px);
    }

    .flow-fiche-stack {
      height: 100%;
      min-height: 0;
    }

    .flow-stack-sheet {
      border-radius: 18px;
      box-shadow:
        0 18px 34px rgba(35, 61, 77, 0.08),
        inset 0 -5px 0 rgba(254, 127, 45, 0.13);
    }

    .flow-parcel-card {
      grid-template-rows: 10px auto auto auto auto;
      align-content: space-between;
      gap: 8px;
      height: 100%;
      min-height: 0;
      border-radius: 18px;
      padding: 14px;
      transform: translate3d(0, var(--flow-card-drop), 0) rotateZ(var(--flow-card-rotate));
    }

    .flow-parcel-card > strong {
      font-size: clamp(1.85rem, 9.6vw, 2.95rem);
      line-height: 0.86;
    }

    .flow-parcel-card p {
      max-width: 100%;
      font-size: 0.82rem;
      line-height: 1.25;
      -webkit-line-clamp: 2;
    }

    .flow-card-details {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
      height: auto;
      min-height: 58px;
    }

    .flow-card-details div {
      min-height: 58px;
      padding: 7px 6px 7px 8px;
    }

    .flow-card-details span {
      font-size: 0.5rem;
    }

    .flow-card-details b {
      font-size: 0.56rem;
      line-height: 1.05;
    }

    .flow-seal-strip {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 112px;
      gap: 7px;
      padding-top: 0;
    }

    .flow-seal-track {
      gap: 6px;
    }

    .flow-seal-track i {
      height: 5px;
    }

    .flow-seal-track b {
      font-size: 0.56rem;
    }

    .flow-card-status {
      grid-template-columns: 24px minmax(0, 1fr);
      min-height: 48px;
      border-radius: 12px;
      padding: 7px;
    }

    .flow-status-icon {
      width: 24px;
      height: 24px;
      border-radius: 9px;
    }

    .flow-status-stage-icon {
      width: 14px;
      height: 14px;
    }

    .flow-status-copy strong {
      font-size: 0.54rem;
    }

    .flow-status-copy em {
      font-size: 0.46rem;
    }

    .flow-stamp-rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
      padding: 8px 0 0;
    }

    .flow-stamp-rail::before,
    .flow-stamp-rail::after {
      top: 25px;
      bottom: auto;
      left: 8%;
      height: 2px;
      width: 84%;
    }

    .flow-stamp-rail::after {
      width: calc(84% * var(--flow-progress, 0.08));
      height: 2px;
    }

    .flow-manifest {
      display: none;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      grid-row: 2;
      border-top: 0;
      border-left: 0;
      padding: 14px 0 0;
    }

    .flow-manifest strong {
      margin-top: 4px;
      font-size: clamp(1.8rem, 10vw, 2.6rem);
    }

    .flow-manifest em {
      grid-column: 1 / -1;
      font-size: 0.76rem;
    }

    .flow-manifest div {
      display: none;
    }

    .flow-bid-panel {
      grid-row: 2;
      margin-top: 0;
    }

    .flow-actions {
      grid-column: 1;
      grid-row: 3;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      padding: 4px 0;
    }

    .flow-action {
      grid-template-rows: 26px 52px auto;
      min-height: 126px;
      border-radius: 16px;
      padding: 10px 8px;
    }

    .flow-action .flow-icon {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      padding: 14px;
    }

    .flow-popover {
      min-width: 68px;
      min-height: 22px;
      padding: 4px 7px;
      font-size: 0.5rem;
    }

    .flow-step-stack {
      grid-template-columns: 1fr;
    }

    .flow-step-stack .story-step {
      min-height: auto;
      border-top: 0;
      border-left: 3px solid transparent;
    }

    .flow-step-stack .story-step + .story-step {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
      border-left-width: 3px;
    }

    .flow-step-stack .story-step.is-active {
      border-left-color: var(--orange);
    }

    .flow-ledger {
      grid-template-columns: 1fr;
      display: none;
    }
  }

  @media (max-width: 760px) and (max-height: 760px) {
    .story-pin-inner {
      gap: 10px;
      padding-block: 84px 10px;
    }

    .story-copy .eyebrow {
      display: none;
    }

    .story-copy h2 {
      font-size: clamp(1.72rem, 7.8vw, 2.18rem);
    }

    .flow-head {
      display: none;
    }

    .flow-board {
      height: clamp(280px, 43vh, 320px);
    }

    .flow-parcel-card {
      gap: 7px;
      padding: 12px;
    }

    .flow-parcel-card > strong {
      font-size: clamp(1.58rem, 8.4vw, 2.35rem);
    }

    .flow-parcel-card p {
      font-size: 0.76rem;
      line-height: 1.2;
    }

    .flow-card-details {
      min-height: 50px;
    }

    .flow-card-details div {
      min-height: 50px;
      padding: 6px;
    }

    .flow-card-details span {
      font-size: 0.46rem;
    }

    .flow-card-details b {
      font-size: 0.5rem;
    }

    .flow-seal-strip {
      grid-template-columns: minmax(0, 1fr) 104px;
    }

    .flow-card-status {
      min-height: 42px;
      padding: 6px;
    }
  }

  /* Product route demo */
  .lab-stage {
    isolation: isolate;
    min-height: clamp(390px, 39vw, 510px);
  }

  .lab-road-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  .road-line {
    fill: none;
    stroke: rgba(35, 61, 77, 0.13);
    stroke-linecap: round;
    stroke-width: 12;
  }

  .road-thin {
    stroke-width: 5;
  }

  .route-path {
    fill: none;
    opacity: 0;
    stroke: var(--orange);
    stroke-dasharray: 18 12;
    stroke-linecap: round;
    stroke-width: 12;
    transition: opacity 180ms ease;
  }

  .route-path.is-active {
    opacity: 1;
    animation: routeFlow 1.1s linear infinite;
  }

  .route-wait.is-active {
    stroke: rgba(35, 61, 77, 0.52);
  }

  .map-card {
    position: absolute;
    z-index: 2;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    width: min(220px, 38%);
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.88);
    padding: 12px;
    box-shadow: 0 20px 60px rgba(35, 61, 77, 0.13);
    backdrop-filter: blur(14px);
  }

  .map-icon {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 14px;
    background: rgba(234, 236, 240, 0.82);
    color: var(--navy);
  }

  .map-icon svg,
  .package-icon svg,
  .moving-rider svg,
  .icon-svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .map-card strong {
    display: block;
    font-size: 0.82rem;
    line-height: 1.05;
  }

  .map-card span {
    display: block;
    margin-top: 4px;
    color: rgba(35, 61, 77, 0.66);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .map-shop {
    top: 48%;
    left: 7%;
  }

  .map-bag {
    top: 35%;
    left: 36%;
  }

  .map-rider {
    top: 18%;
    right: 8%;
  }

  .map-drop {
    top: 45%;
    right: 7%;
    width: min(168px, 30%);
  }

  .map-ledger {
    right: 21%;
    bottom: 11%;
    width: min(210px, 34%);
  }

  .bag-fill {
    display: block;
    height: 7px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.12);
    margin-top: 8px;
  }

  .bag-fill b {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--orange);
    transform: scaleX(var(--bag-fill, 0.8));
    transform-origin: left center;
    transition: transform 180ms ease;
  }

  .package-stack {
    position: absolute;
    z-index: 3;
    top: 73%;
    left: 11%;
    display: grid;
    grid-template-columns: repeat(6, 24px);
    gap: 5px;
  }

  .package-icon {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border-radius: 7px;
    background: rgba(254, 127, 45, 0.16);
    color: var(--orange);
    opacity: 0.18;
    transform: translateY(3px);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .package-icon.is-active {
    background: var(--orange);
    color: var(--black);
    opacity: 1;
    transform: translateY(0);
  }

  .moving-rider {
    position: absolute;
    z-index: 4;
    top: 65%;
    left: 16%;
    display: grid;
    grid-template-columns: 34px auto;
    gap: 6px;
    align-items: center;
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    padding: 6px 10px 6px 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.66rem;
    font-weight: 950;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.18);
  }

  .moving-rider svg {
    width: 28px;
    height: 28px;
  }

  .route-lab.is-running .moving-rider {
    animation: riderWait 2.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .route-lab.is-bundle.is-running .moving-rider {
    animation-name: riderBundle;
  }

  .route-lab.is-skip.is-running .moving-rider {
    animation-name: riderSkip;
  }

  @keyframes riderWait {
    0% {
      top: 65%;
      left: 16%;
    }

