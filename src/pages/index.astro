  .model-table,
  .ledger-card {
    overflow: hidden;
  }

  .model-row,
  .ledger-line,
  .ledger-head {
    display: grid;
    grid-template-columns: minmax(120px, 0.44fr) minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    border-bottom: 1px solid rgba(35, 61, 77, 0.1);
    padding: 20px;
