    opacity: calc(0.58 + var(--segment-load, 1) * 0.12);
    stroke: var(--orange);
    stroke-dasharray: 0.032 0.022;
    stroke-dashoffset: 0;
    stroke-width: calc(5.6px + var(--segment-load, 1) * 0.7px);
    animation: liveRouteFlow 1.2s linear infinite;
