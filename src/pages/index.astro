  }

  .flow-manifest span,
  .flow-bid-panel > span {
    display: block;
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .flow-manifest strong {
    display: block;
    margin-top: 10px;
    color: var(--black);
    font-size: clamp(2.1rem, 4vw, 3.3rem);
    font-weight: 950;
    line-height: 0.9;
  }

  .flow-manifest em {
    display: block;
    margin-top: 8px;
    color: rgba(35, 61, 77, 0.72);
    font-size: 0.82rem;
    font-style: normal;
    font-weight: 950;
  }

  .flow-manifest div {
    margin-top: 20px;
    border-top: 0;
    padding-top: 4px;
  }

  .flow-manifest small {
    display: block;
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .flow-manifest b {
    display: block;
    margin-top: 5px;
    font-size: 0.92rem;
    line-height: 1.22;
  }

  .flow-bid-panel {
    display: none;
  }

  .flow-transfer {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 24px 360px;
    gap: 18px;
    height: 410px;
    min-height: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
  }

  .flow-transfer::before {
    display: none;
  }

  .flow-transfer::after {
    display: none;
  }

  .flow-transfer-head {
    position: relative;
    z-index: 3;
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 24px;
    padding: 0;
  }

  .flow-transfer-head span,
  .flow-parcel-card span,
  .flow-checkpoint span {
    color: rgba(35, 61, 77, 0.58);
    font-size: 0.66rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .flow-transfer-head strong {
    width: max-content;
    max-width: 60%;
    border-radius: 999px;
    background: rgba(254, 127, 45, 0.16);
    color: var(--black);
    padding: 7px 9px;
    font-size: 0.66rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .flow-fiche-stack {
    position: relative;
    z-index: 2;
    height: 360px;
    min-width: 0;
    isolation: isolate;
  }

  .flow-stack-sheet {
    position: absolute;
    inset: 0;
