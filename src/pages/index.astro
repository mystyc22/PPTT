      opacity: 0;
      transform: scale(1.35);
    }
  }

  .route-lab .node-bag .icon-svg {
    width: 12px;
    height: 12px;
  }

  .route-lab .node-bag strong {
    font-size: 0.6rem;
    line-height: 1;
  }

  .route-lab .network-point.has-bag .node-bag {
    opacity: 1;
    transform: scale(1);
  }

  .route-lab .network-point.is-busy .node-bag {
    background: var(--black);
    color: var(--white);
  }

  .route-lab .network-point.is-focus {
    z-index: 5;
    border-color: rgba(254, 127, 45, 0.5);
    box-shadow:
      0 0 0 5px rgba(254, 127, 45, 0.14),
      0 14px 32px rgba(35, 61, 77, 0.12);
  }

  .route-lab .network-point.is-offline {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.78);
  }

  .route-lab .bag-delta {
    position: absolute;
    z-index: 8;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    padding: 4px 7px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.58rem;
    font-weight: 950;
    line-height: 1;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .route-lab .bag-delta::before {
    display: block;
    width: 9px;
    height: 8px;
    border: 1.7px solid currentColor;
    border-radius: 2px;
    content: "";
    box-shadow: inset 0 3px 0 rgba(255, 255, 255, 0.18);
  }

  .route-lab .bag-delta.is-in {
    background: var(--orange);
    color: var(--black);
  }

  .route-lab .bag-delta.is-out {
    background: var(--navy);
  }

  /* Idle couriers are hidden; they "arrive" at a pickup when they accept a bag. */
  .route-lab .live-rider {
    top: 0;
    left: 0;
    transition: opacity 200ms ease;
    will-change: transform, opacity;
  }

  .route-lab .live-rider.is-disabled {
    opacity: 0;
  }

  .route-lab .live-rider em {
    background: var(--orange);
    color: var(--black);
  }

  .route-lab .live-rider.is-express em {
    background: var(--white);
    color: var(--navy);
  }

  .hero-strip {
    width: 100%;
    margin-top: clamp(20px, 3vw, 34px);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    overflow: visible;
    border: 0;
    border-top: 1px solid rgba(35, 61, 77, 0.13);
    border-bottom: 1px solid rgba(35, 61, 77, 0.08);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  .hero-strip div {
    position: relative;
    min-height: 92px;
    background: transparent;
    padding: 18px 20px;
    backdrop-filter: none;
  }

  .hero-strip div + div {
    border-left: 1px solid rgba(35, 61, 77, 0.1);
  }

  .hero-strip div::before {
    display: block;
    width: 22px;
    height: 2px;
    margin-bottom: 13px;
    border-radius: 999px;
    background: var(--orange);
    content: "";
  }

  .hero-strip strong {
    display: block;
    color: var(--black);
    font-size: clamp(1.42rem, 2.5vw, 2.18rem);
    font-weight: 950;
    line-height: 0.95;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .hero-strip span {
    display: block;
    margin-top: 8px;
    max-width: 16ch;
    color: rgba(35, 61, 77, 0.62);
    font-size: 0.82rem;
    font-weight: 850;
    line-height: 1.18;
  }

  @media (max-width: 1180px) {
    .hero-strip {
      width: min(860px, 100%);
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-right: auto;
      margin-left: auto;
    }
  }

  @media (max-width: 900px) {
    .hero-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-strip div:nth-child(3) {
      border-left: 0;
    }

    .hero-strip div:nth-child(n + 3) {
      border-top: 1px solid rgba(35, 61, 77, 0.1);
    }
  }

  @media (min-width: 761px) {
    .route-lab .lab-controls {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .route-lab .lab-run {
      grid-column: 1 / -1;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero .hero-title-word {
      opacity: 0;
      transform: translateY(112%);
    }

    .hero .hero-copy > .eyebrow,
    .hero .hero-lede,
    .hero .hero-actions,
    .hero .route-lab,
    .hero .hero-strip {
      opacity: 0;
      transform: translateY(18px);
    }

    .hero .route-lab {
      transform: translateY(24px) scale(0.985);
    }
  }

  @media (max-width: 760px) {
    .hero-strip {
      display: none;
    }

    .route-lab .lab-live-pill {
      font-size: 0.54rem;
      padding: 5px 8px;
    }

    .route-lab .lab-topline strong {
      font-size: 0.56rem;
    }

    .route-lab .node-bag {
      top: -12px;
      right: -10px;
      bottom: auto;
      padding: 2px 6px 2px 4px;
    }

    .route-lab .node-bag .icon-svg {
      width: 10px;
      height: 10px;
    }

    .route-lab .node-bag strong {
      font-size: 0.54rem;
    }

    .route-lab .bag-delta {
      padding: 3px 6px;
      font-size: 0.5rem;
    }
  }

  .concept-pin {
    position: relative;
    overflow: clip;
    padding-block: clamp(74px, 9vw, 124px);
  }

  .concept-pin-inner {
    display: grid;
    grid-template-columns: minmax(300px, 0.76fr) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 86px);
    align-items: center;
    min-height: min(760px, 100svh);
  }

  .concept-copy h2 {
    max-width: 760px;
    margin-top: 14px;
    font-size: clamp(2.35rem, 5.8vw, 5.2rem);
    font-weight: 950;
    line-height: 0.94;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .concept-copy > p:not(.eyebrow) {
    max-width: 560px;
    margin-top: 22px;
    color: var(--muted);
    font-size: clamp(1rem, 1.45vw, 1.16rem);
    line-height: 1.58;
  }

  .project-progress {
    max-width: 560px;
    margin-top: clamp(28px, 4vw, 42px);
  }

  .project-progress-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: center;
    color: rgba(35, 61, 77, 0.62);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 950;
    text-transform: uppercase;
  }

  .project-progress-head strong {
    color: var(--black);
    font-size: 0.76rem;
    text-align: center;
  }

  .project-progress-track {
    height: 5px;
    margin-top: 14px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(35, 61, 77, 0.12);
  }

  .project-progress-track i {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--orange);
    transform: scaleX(var(--project-progress, 0));
    transform-origin: left center;
  }

  .project-markers {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 7px;
    margin-top: 12px;
  }

  .project-markers span {
    overflow: hidden;
    color: rgba(35, 61, 77, 0.44);
    font-size: 0.68rem;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .project-markers span.is-active {
    color: var(--black);
  }

  .project-carousel {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 22px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0.38)),
      rgba(255, 255, 255, 0.5);
    box-shadow: 0 22px 70px rgba(35, 61, 77, 0.1);
    backdrop-filter: blur(18px);
  }

  .project-carousel::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(35, 61, 77, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(35, 61, 77, 0.045) 1px, transparent 1px);
    background-size: 46px 46px;
    content: "";
    pointer-events: none;
  }

  .project-card-track {
    position: relative;
    display: flex;
    z-index: 1;
    will-change: transform;
  }

  .project-stage-card {
    position: relative;
    flex: 0 0 100%;
    min-height: clamp(420px, 48vw, 560px);
    display: grid;
    grid-template-rows: minmax(144px, 1fr) auto;
    gap: clamp(18px, 3vw, 34px);
    padding: clamp(24px, 4vw, 44px);
    opacity: 0.58;
    transition: opacity 220ms ease;
  }

  .project-stage-card.is-active {
    opacity: 1;
  }

  .project-stage-card.is-active .project-stage-visual {
    animation: projectVisualSettle 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .project-stage-card.is-active .stage-icon-main {
    animation: projectIconSettle 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .project-stage-card.is-active .stage-icon-chip,
  .project-stage-card.is-active .stage-icon-status {
    animation: projectChipSettle 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .project-stage-card.is-active .stage-icon-chip.chip-b {
    animation-delay: 58ms;
  }

  .project-stage-card.is-active .stage-icon-status {
    animation-delay: 92ms;
  }

  .project-stage-card.is-active .project-tag,
  .project-stage-card.is-active .project-stage-body > p:first-of-type,
  .project-stage-card.is-active .project-stage-body h3,
  .project-stage-card.is-active .project-stage-line,
  .project-stage-card.is-active .project-stage-body > p:last-of-type,
  .project-stage-card.is-active .project-stage-body > strong {
    animation: projectCopySettle 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .project-stage-card.is-active .project-stage-body > p:first-of-type {
    animation-delay: 38ms;
  }

  .project-stage-card.is-active .project-stage-body h3 {
    animation-delay: 72ms;
  }

  .project-stage-card.is-active .project-stage-line {
    animation-delay: 108ms;
  }

  .project-stage-card.is-active .project-stage-body > p:last-of-type {
    animation-delay: 142ms;
  }

  .project-stage-card.is-active .project-stage-body > strong {
    animation-delay: 174ms;
  }

  .project-stage-visual {
    position: relative;
    align-self: start;
    justify-self: end;
    display: grid;
    place-items: center;
    isolation: isolate;
    width: clamp(170px, 21vw, 248px);
    aspect-ratio: 1.22;
    max-width: 48%;
    min-height: 150px;
    color: var(--black);
    opacity: 0.96;
    pointer-events: none;
  }

  .project-stage-body {
    display: grid;
    grid-template-rows: auto auto minmax(116px, auto) auto minmax(76px, auto) auto;
    align-self: end;
    width: min(620px, 100%);
    min-height: clamp(392px, 29vw, 408px);
  }

  .project-stage-visual::before {
    position: absolute;
    inset: 14% 9% 10% 13%;
    z-index: -2;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.62);
    content: "";
    transform: rotate(-4deg);
  }

  .project-stage-visual::after {
    position: absolute;
    inset: 24% 20% 20% 10%;
    z-index: -1;
    border: 1px dashed rgba(35, 61, 77, 0.2);
    border-radius: 999px;
    content: "";
    transform: rotate(16deg);
  }

  .stage-icon-main,
  .stage-icon-chip,
  .stage-icon-status {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
  }

  .stage-icon-main {
    width: clamp(82px, 8.2vw, 104px);
    height: clamp(82px, 8.2vw, 104px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 24px;
    background: var(--black);
    color: var(--white);
    box-shadow: 0 24px 52px rgba(35, 61, 77, 0.22);
  }

  .project-stage-visual .project-stage-lucide {
    width: 52%;
    height: 52%;
    stroke-width: 1.85;
  }

  .stage-icon-chip,
  .stage-icon-status {
    position: absolute;
    width: clamp(40px, 4.4vw, 52px);
    height: clamp(40px, 4.4vw, 52px);
    border-radius: 16px;
    background: var(--orange);
    color: var(--black);
    box-shadow: 0 16px 30px rgba(35, 61, 77, 0.16);
  }

  .stage-icon-chip .project-stage-lucide,
  .stage-icon-status .project-stage-lucide {
    width: 50%;
    height: 50%;
  }

  .stage-icon-chip.chip-a {
    top: 11%;
    left: 11%;
  }

  .stage-icon-chip.chip-b {
    right: 9%;
    bottom: 18%;
    background: var(--white);
    color: var(--navy);
    border: 1px solid rgba(35, 61, 77, 0.12);
  }

  .stage-icon-status {
    right: 15%;
    top: 7%;
    width: clamp(34px, 3.7vw, 44px);
    height: clamp(34px, 3.7vw, 44px);
    border: 1px solid rgba(35, 61, 77, 0.1);
    background: rgba(255, 255, 255, 0.82);
    color: var(--black);
  }

  .project-tag {
    width: max-content;
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    padding: 7px 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 950;
    line-height: 1;
  }

  .project-stage-body > p:first-of-type {
    margin-top: 18px;
    color: var(--orange);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 950;
    text-transform: uppercase;
  }

  .project-stage-body h3 {
    max-width: 620px;
    margin-top: 12px;
    min-height: clamp(106px, 10vw, 150px);
    font-size: clamp(2rem, 4vw, 4.1rem);
    font-weight: 950;
    line-height: 0.96;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .project-stage-line {
    width: min(420px, 68%);
    height: 1px;
    margin: 24px 0;
    background: rgba(35, 61, 77, 0.16);
  }

  .project-stage-body > p:last-of-type {
    max-width: 560px;
    min-height: 76px;
    color: var(--muted);
    font-size: clamp(0.98rem, 1.35vw, 1.12rem);
    line-height: 1.55;
  }

  .project-stage-body > strong {
    width: max-content;
    margin-top: 28px;
    border: 1px solid rgba(35, 61, 77, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    color: var(--black);
    padding: 8px 11px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-stage-card:not(.is-active) {
    opacity: 0.58;
  }

  @keyframes projectVisualSettle {
    0% {
      opacity: 0.58;
      transform: translate3d(18px, 10px, 0) scale(0.985);
    }

    100% {
      opacity: 0.96;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes projectIconSettle {
    0% {
      transform: translateY(10px) scale(0.94);
    }

    62% {
      transform: translateY(-2px) scale(1.02);
    }

    100% {
      transform: translateY(0) scale(1);
    }
  }

  @keyframes projectChipSettle {
    0% {
      opacity: 0;
      transform: translateY(8px) scale(0.9);
    }

    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes projectCopySettle {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .concept-pin-inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .concept-copy {
      text-align: center;
    }

    .concept-copy h2,
    .concept-copy > p:not(.eyebrow),
    .project-progress {
      margin-right: auto;
      margin-left: auto;
    }

    .project-carousel {
