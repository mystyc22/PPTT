    min-width: 0;
    border: 1px solid rgba(35, 61, 77, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.5);
    padding: 9px;
  }

  .lab-readout span,
  .lab-readout strong,
